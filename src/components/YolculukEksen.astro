---
// YolculukEksen — Beş Evre + Bir AÇILIŞ'ı kömürden aleve dikey ısı-eğrisi şeridi
// olarak render eder (brief Yolculuk Ekseni v1/v2/v3; Seçenek A: loader fragment-split,
// /yolculuk Notion'da `## section: yolculuk-eksen` marker'ına yapışır).
// v2: EVRE N kaldırıldı, evre adı kahraman, iç-iş tekrarı tek satıra indi.
// v3: üstteki overline + giriş cümlesi kaldırıldı (yatay metaforu yanıltıcıydı,
// şerit kendi kendini anlatıyor); blok okuma kolonu (--max-w-prose 38rem) genişliğinde
// ortalı — prose baseline'la (atmosfer.css `section[data-section][class^="ocak-"]`)
// tutarlı. İç hizalama sola kalır (ısı şeridi sol kenarda).
// v4: ara dönem etiketi "kor · 2–3 ay" → sadece "kor" (süre bilgisi alt satıra göçtü,
// orada bir kez). Kor çizgisi opaklığı 0.85→1.0 ile az güçlendirildi — tek kelimeye
// inince yalnız kalmasın, ama 6px dolu evre şeritleriyle yarışmasın. Alt satır metni
// "yolculuk içselleşir" marka cümlesiyle güncellendi.
// Isı renkleri tokens.css'te (--isi-*, --kor-cizgi). DURUŞ = --ember.

const evreler = [
  { ad: 'AÇILIŞ', tema: 'Kohortun kuruluşu, niyet, ilk çember.', renk: 'var(--isi-acilis)' },
  { ad: 'İNİŞ',   tema: 'Köklere, bedene, atalara.',              renk: 'var(--isi-inis)' },
  { ad: 'UYANIŞ', tema: 'Bastırılmış güce, ateşe, bedensel uyanışa.', renk: 'var(--isi-uyanis)' },
  { ad: 'DURUŞ',  tema: 'Sessizliğe, boşluğa, durmaya.',          renk: 'var(--isi-durus)' },
  { ad: 'GEÇİŞ',  tema: 'Eşikten geçişe, bırakmaya, yeniden doğuşa.', renk: 'var(--isi-gecis)' },
  { ad: 'DÖNÜŞ',  tema: 'Kendine, bütünlüğe, eve.',               renk: 'var(--isi-donus)' },
];
---
<section class="yolculuk-eksen" aria-label="Beş evre + bir açılış — yolculuk ekseni">
  <div class="yolculuk-eksen__inner">
    <ol class="yolculuk-eksen__liste" role="list">
      {evreler.map((evre, i) => (
        <>
          <li class="evre" style={`--isi-aktif: ${evre.renk};`}>
            <span class="evre__serit" aria-hidden="true"></span>
            <div class="evre__icerik">
              <h3 class="evre__ad">{evre.ad}</h3>
              <p class="evre__tema">{evre.tema}</p>
            </div>
          </li>
          {i < evreler.length - 1 && (
            <li class="kor">
              <span class="kor__serit" aria-hidden="true"></span>
              <span class="kor__etiket">kor</span>
            </li>
          )}
        </>
      ))}
    </ol>

    <p class="yolculuk-eksen__icisler">
      Evreler arası 2–3 ay sürer. Bu kor döneminde yolculuk içselleşir: aylık çember, kız kardeş eşleşmesi, mevsim ritüelleri, bireysel görüşme.
    </p>
  </div>
</section>

<style>
  .yolculuk-eksen {
    /* v3: prose okuma kolonu genişliği (atmosfer.css baseline ile paralel,
       --max-w-prose = 38rem ≈ 608px). Yatay merkez; padding prose baseline'a
       eşli (space-8 / space-6 / space-9) ama component dikey ritmiyle hafif
       sıkıştırıldı — şerit zaten kendi nefesini taşıyor. */
    max-width: var(--max-w-prose);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-8);
  }

  .yolculuk-eksen__inner {
    text-align: left;
  }

  .yolculuk-eksen__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* ===== EVRE SATIR (v2: ad kahraman, EVRE N yok) ===== */
  .evre {
    --isi-aktif: var(--ember);
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-4) 0;
  }

  .evre__serit {
    flex: 0 0 6px;
    width: 6px;
    min-width: 6px;
    border-radius: 3px;
    background: var(--isi-aktif);
    align-self: stretch;
    /* Coal zeminde soğuk uç için ince ısı halesi — ayrışma kapsülü (KARAR 150). */
    box-shadow: 0 0 12px color-mix(in oklab, var(--isi-aktif) 35%, transparent);
  }

  .evre__icerik {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }

  .evre__ad {
    /* v2: kahraman — daha iri Cormorant italik, kendi ısı rengiyle. */
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--isi-aktif);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .evre__tema {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--cream-soft);
    font-weight: 300;
  }

  /* ===== KOR ARA DÖNEM (v2: sadece "kor · 2–3 ay", iç-işler footer'a göçtü) ===== */
  .kor {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0;
  }

  .kor__serit {
    flex: 0 0 6px;
    width: 6px;
    min-width: 6px;
    min-height: 32px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--kor-cizgi) 0 6px,
      transparent 6px 12px
    );
    /* v4: 0.85 → 1.0 (~+18%). "kor" tek kelimeye inince yalnız kalmasın; evre
       şeritleri (6px dolu) hâlâ kahraman, çizgi sadece "var olduğu belli olsun"
       düzeyinde. */
    opacity: 1;
  }

  .kor__etiket {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: color-mix(in oklab, var(--kor-cizgi) 80%, var(--cream) 20%);
  }

  /* ===== IÇ-İŞLER FOOTER — tek satır, 1× (v2: 5× tekrar yerine) ===== */
  .yolculuk-eksen__icisler {
    margin: var(--space-6) 0 0;
    padding-left: calc(6px + var(--space-5));
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--smoke);
    line-height: var(--leading-snug);
  }

  /* ===== MOBİL (KARAR 187 horizontal overflow=0) ===== */
  @media (max-width: 768px) {
    .yolculuk-eksen {
      /* max-width: --max-w-prose 38rem mobil viewport'tan büyük olabilir
         (örn. 320-360px ekran). 100% düşürerek taşma riskini kapatıyoruz. */
      max-width: 100%;
      padding: var(--space-7) var(--space-5) var(--space-7);
    }

    .evre__icerik {
      gap: var(--space-2) var(--space-5);
    }

    .evre__tema {
      font-size: var(--text-base);
      flex: 1 0 100%;
    }

    .yolculuk-eksen__icisler {
      font-size: var(--text-xs);
      padding-left: calc(6px + var(--space-4));
    }
  }
</style>
