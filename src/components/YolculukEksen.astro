---
// YolculukEksen — Beş Evre + Bir AÇILIŞ'ı kömürden aleve dikey ısı-eğrisi şeridi
// olarak render eder (brief Yolculuk Ekseni v1 + v2; Seçenek A: loader fragment-split,
// /yolculuk Notion'da `## section: yolculuk-eksen` marker'ına yapışır).
// v2 değişiklikleri: (a) EVRE N etiketi kaldırıldı — yukarıdan aşağı sıra evre
// numarasını ima ediyor; (b) evre adı (AÇILIŞ vb.) büyütüldü, kahraman; (c) ara
// dönem iç-işler tekrarı (5×) tek satır footer'a indi (1×).
// Isı renkleri tokens.css'te (--isi-*, --kor-cizgi). DURUŞ = --ember.

const evreler = [
  { ad: 'AÇILIŞ', tema: 'Kohortun kuruluşu, niyet, ilk çember.', renk: 'var(--isi-acilis)' },
  { ad: 'İNİŞ',   tema: 'Köklere, bedene, atalara.',              renk: 'var(--isi-inis)' },
  { ad: 'UYANIŞ', tema: 'Bastırılmış güce, ateşe, bedensel uyanışa.', renk: 'var(--isi-uyanis)' },
  { ad: 'DURUŞ',  tema: 'Sessizliğe, boşluğa, durmaya.',          renk: 'var(--isi-durus)' },
  { ad: 'GEÇİŞ',  tema: 'Eşikten geçişe, bırakmaya, yeniden doğuşa.', renk: 'var(--isi-gecis)' },
  { ad: 'DÖNÜŞ',  tema: 'Kendine, bütünlüğe, eve.',               renk: 'var(--isi-donus)' },
];
---
<section class="yolculuk-eksen" aria-labelledby="yolculuk-eksen-baslik">
  <div class="yolculuk-eksen__inner">
    <p class="ocak-overline">Beş evre + bir açılış</p>
    <h2 id="yolculuk-eksen-baslik" class="yolculuk-eksen__giris">
      Soldan sağa ateş tutuşur. Kömürden alevin tepesine, oradan dinlenen kora. Renk, evrenin ısısıdır.
    </h2>

    <ol class="yolculuk-eksen__liste" role="list">
      {evreler.map((evre, i) => (
        <>
          <li class="evre" style={`--isi-aktif: ${evre.renk};`}>
            <span class="evre__serit" aria-hidden="true"></span>
            <div class="evre__icerik">
              <h3 class="evre__ad">{evre.ad}</h3>
              <p class="evre__tema">{evre.tema}</p>
            </div>
          </li>
          {i < evreler.length - 1 && (
            <li class="kor">
              <span class="kor__serit" aria-hidden="true"></span>
              <span class="kor__etiket">kor · 2–3 ay</span>
            </li>
          )}
        </>
      ))}
    </ol>

    <p class="yolculuk-eksen__icisler">
      Her evre arası 2–3 ay: aylık çember, kız kardeş eşleşmesi, mevsim ritüeli, bireysel görüşme.
    </p>
  </div>
</section>

<style>
  .yolculuk-eksen {
    padding: var(--space-9) 0 var(--space-8);
    max-width: var(--max-w-content);
    margin: 0 auto;
  }

  .yolculuk-eksen__inner {
    text-align: left;
  }

  .yolculuk-eksen__giris {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3);
    color: var(--cream);
    line-height: var(--leading-snug);
    margin: var(--space-4) 0 var(--space-8);
    max-width: 38rem;
  }

  .yolculuk-eksen__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* ===== EVRE SATIR (v2: ad kahraman, EVRE N yok) ===== */
  .evre {
    --isi-aktif: var(--ember);
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-4) 0;
  }

  .evre__serit {
    flex: 0 0 6px;
    width: 6px;
    min-width: 6px;
    border-radius: 3px;
    background: var(--isi-aktif);
    align-self: stretch;
    /* Coal zeminde soğuk uç için ince ısı halesi — ayrışma kapsülü (KARAR 150). */
    box-shadow: 0 0 12px color-mix(in oklab, var(--isi-aktif) 35%, transparent);
  }

  .evre__icerik {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }

  .evre__ad {
    /* v2: kahraman — daha iri Cormorant italik, kendi ısı rengiyle. */
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--isi-aktif);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .evre__tema {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--cream-soft);
    font-weight: 300;
  }

  /* ===== KOR ARA DÖNEM (v2: sadece "kor · 2–3 ay", iç-işler footer'a göçtü) ===== */
  .kor {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0;
  }

  .kor__serit {
    flex: 0 0 6px;
    width: 6px;
    min-width: 6px;
    min-height: 32px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--kor-cizgi) 0 6px,
      transparent 6px 12px
    );
    opacity: 0.85;
  }

  .kor__etiket {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: color-mix(in oklab, var(--kor-cizgi) 80%, var(--cream) 20%);
  }

  /* ===== IÇ-İŞLER FOOTER — tek satır, 1× (v2: 5× tekrar yerine) ===== */
  .yolculuk-eksen__icisler {
    margin: var(--space-6) 0 0;
    padding-left: calc(6px + var(--space-5));
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--smoke);
    line-height: var(--leading-snug);
    max-width: 38rem;
  }

  /* ===== MOBİL (KARAR 187 horizontal overflow=0) ===== */
  @media (max-width: 768px) {
    .yolculuk-eksen {
      padding: var(--space-8) 0 var(--space-7);
    }

    .evre__icerik {
      gap: var(--space-2) var(--space-5);
    }

    .evre__tema {
      font-size: var(--text-base);
      flex: 1 0 100%;
    }

    .yolculuk-eksen__icisler {
      font-size: var(--text-xs);
      padding-left: calc(6px + var(--space-4));
    }
  }
</style>
