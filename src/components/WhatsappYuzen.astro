---
// WhatsappYuzen — site geneli sabit yüzen WhatsApp düğmesi. Layout.astro
// içinde </main> sonrası, Footer öncesi tek satırla mount edilir; her sayfada
// sağ alt köşede sabit durur. Tıklayınca boş chat açar (wa.me/905322080888).
//
// Kararlar:
//   - Numara tek kaynak: WHATSAPP_URL (src/lib/api.ts). Burada hard-code yok.
//   - Etiket YOK (masaüstü+mobil sadece daire). ?text= YOK (boş chat).
//   - aria-label görsel etiket eksikliğini erişilebilirlik için telafi eder;
//     "yapay zekâ" notu sesli okuyucuya verilir (KARAR 57.3 — dürüstlük ilkesi).
//   - Renk: var(--ember) köz tokeni (hard-code #C44B2F yasak). 0.5px ince
//     ash kenarlık → kömür zemine gömülü kalır, parlak yeşil yok.
//   - z-index 150: --z-grain (100) üstü, --z-overlay (200) altı → modal varsa
//     yüzen buton kapatılır, sıradan içerikten her zaman üstte.
//   - prefers-reduced-motion: hover transform sıfırlanır (transition kalır).

import { WHATSAPP_URL } from '../lib/api';
---

<a
  class="wa-yuzen"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp asistanı (yapay zekâ) — yeni sekmede açılır"
>
  <svg
    class="wa-yuzen__ikon"
    viewBox="0 0 32 32"
    width="22"
    height="22"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M16.001 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.26.6 4.47 1.74 6.41L3.2 28.8l6.55-1.71a12.78 12.78 0 0 0 6.25 1.6h.01c7.06 0 12.8-5.73 12.8-12.8s-5.74-12.69-12.8-12.69Zm0 23.36h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.89 1.02 1.04-3.79-.25-.4a10.55 10.55 0 0 1-1.62-5.64c0-5.86 4.77-10.63 10.62-10.63 2.84 0 5.5 1.11 7.51 3.11a10.54 10.54 0 0 1 3.11 7.52c0 5.86-4.77 10.52-10.62 10.52Zm5.83-7.88c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.55.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.36-.26-.61-.52-.53-.71-.54l-.6-.01c-.21 0-.55.08-.84.4-.29.32-1.1 1.08-1.1 2.63 0 1.55 1.13 3.05 1.29 3.26.16.21 2.22 3.39 5.38 4.75.75.32 1.34.52 1.8.66.76.24 1.45.21 2 .13.61-.09 1.89-.77 2.16-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.6-.37Z"
    />
  </svg>
</a>

<script>
  // Footer viewport'a girince buton .gizli olur; footer çıkınca geri gelir.
  // Hedef: Footer.astro'daki tek <footer class="footer" role="contentinfo">.
  // rootMargin alt kenardan -%10 tampon → footer'ın ilk pikseli değil anlamlı
  // bir kısmı görününce tetiklenir, kenar titreşimi olmaz.
  // IntersectionObserver yoksa buton mevcut davranışında kalır (fallback yok).
  // Footer bulunamazsa sessiz geçilir; console'a hata basılmaz.
  const waButon = document.querySelector('.wa-yuzen');
  const waFooter = document.querySelector('footer');

  if (waButon && waFooter && 'IntersectionObserver' in window) {
    const waIo = new IntersectionObserver(
      ([giris]) => waButon.classList.toggle('gizli', giris.isIntersecting),
      { rootMargin: '0px 0px -10% 0px' }
    );
    waIo.observe(waFooter);
  }
</script>

<style>
  .wa-yuzen {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 150;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;

    background: var(--ember);
    color: var(--cream);
    border: 0.5px solid color-mix(in oklab, var(--ash) 70%, transparent);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.35),
      0 10px 24px rgba(0, 0, 0, 0.32),
      0 0 16px rgba(196, 75, 47, 0.18);

    text-decoration: none;
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      background var(--duration-slow) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out),
      visibility 0s linear 0s;
  }

  .wa-yuzen:hover,
  .wa-yuzen:focus-visible {
    transform: translateY(-2px);
    background: var(--ember-soft);
    box-shadow:
      0 2px 3px rgba(0, 0, 0, 0.4),
      0 14px 30px rgba(0, 0, 0, 0.38),
      0 0 22px rgba(196, 75, 47, 0.32);
  }

  .wa-yuzen:focus-visible {
    outline: 1px solid var(--ember);
    outline-offset: 3px;
  }

  /* Footer viewport'a girince buton söner. .gizli, :hover/:focus-visible ile
   * eşit özgüllükte (0,2,0) — bu yüzden onlardan SONRA durmalı, yoksa
   * gizliyken hover transform'u kazanır. visibility gecikmeli: fade biter,
   * sonra element erişim ağacından ve tab sırasından çıkar (aria-hidden
   * toggle'ına gerek yok). Tetikleyen IntersectionObserver aşağıdaki
   * <script>'te; hedef Footer.astro'daki tek <footer>. */
  .wa-yuzen.gizli {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      background var(--duration-slow) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);
  }

  .wa-yuzen__ikon {
    display: block;
  }

  @media (max-width: 480px) {
    .wa-yuzen {
      right: 16px;
      bottom: 16px;
      width: 48px;
      height: 48px;
    }
    .wa-yuzen__ikon {
      width: 20px;
      height: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-yuzen {
      transition:
        background var(--duration-base) var(--ease-out),
        visibility 0s;
    }
    .wa-yuzen:hover,
    .wa-yuzen:focus-visible {
      transform: none;
    }
  }
</style>
