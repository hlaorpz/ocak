---
// SonrakiBulusma — dinamik etkinlik listesi (KARAR 92, 93; KARAR 127 fragment-split).
// Çağrı sadece PageContent fragment-split'inden: slug prop'u sayfayı tanımlar,
// kategori + heading slug'tan otomatik türetilir.
//
// Davranış (brief-faz3-h4-h5 İş 2 — TEK KART varyantı):
//   - 6 format sayfası (/cember, /acik-kapi, /seremoni, /atolye, /sehir-aksami,
//     /mini-retreat) → LIMIT=1, heading "En Yakın [Format Adı]", altında
//     "Tüm tarihler → /takvim" linki. Kategori boş ise KART YOK, prose fallback
//     "Bir sonraki buluşma yakında duyurulacak." (heading korunur).
//   - Home (/) → LIMIT=3, DEFAULT_HEADING, tüm yaklaşan (mevcut davranış).
//   - Anadolu (/anadolu, yolculuk kategorisi) → LIMIT=3, mevcut davranış korunur.
//     Kategori var + etkinlik yok → fallback tüm yaklaşan + DEFAULT_HEADING.
//
// brief-etkinlik-detay-route.md FAZ 1: publish filtresi gevşedi
// (siteGoster && durum !== 'İptal') — detay route "geçmiş dahil" için. Bu
// component artık liste için gereken 3 süzgeci (durum ∈ {Kayıt Açık, Dolu},
// bugündenSonra, kategori) explicit uyguluyor.

import { getCollection, type CollectionEntry } from 'astro:content';
import { bugundenSonra } from '../lib/format-etkinlik';
import {
  filterEtkinliklerByKategori,
  getKategori,
  DEFAULT_HEADING,
  KATEGORI_HEADING,
  KATEGORI_EN_YAKIN,
} from '../lib/etkinlik-kategori';
import { isKayitFormat } from '../lib/kayit';
import EtkinlikKart from './EtkinlikKart.astro';

type EtkinlikData = CollectionEntry<'etkinlikler'>['data'];

interface Props {
  /** Çağrıldığı sayfanın slug'u (PageContent fragment-split geçirir). */
  slug: string;
}

const { slug } = Astro.props;
const kategori = getKategori(slug);
// 6 format sayfası mı? (kayit.ts KayitFormat: cember, acik-kapi, mini-retreat,
// sehir-aksami, seremoni, atolye). Yolculuk (anadolu) burada değil.
const slugSade = slug.replace(/^\/+/, '');
const isFormatPage = isKayitFormat(slugSade);
// brief-faz3-ek v2 Madde 5 — Home tek kart. Manifesto tek başına müze gibi
// durmasın; "bu ateş gerçekten yanıyor" göstergesi. Kategori filtresiz
// (tüm formatlar arası en yakın), tek kart (3'lü katalog hissinden kaçış).
const isHome = slug === '/';
const isTekKart = isFormatPage || isHome;
const LIMIT = isTekKart ? 1 : 3;

const sortFn = (a: EtkinlikData, b: EtkinlikData) => {
  if (a.oneCikar !== b.oneCikar) return a.oneCikar ? -1 : 1; // öne çıkanlar üstte
  if (a.tarihBaslangic !== b.tarihBaslangic)
    return a.tarihBaslangic.localeCompare(b.tarihBaslangic); // tarih ASC
  return a.baslik.localeCompare(b.baslik, 'tr'); // son kırıcı: başlık TR
};

// FAZ 1 — durum + gelecek filtresi liste tarafında (collection artık gevşek).
const AKTIF_DURUM = new Set(['Kayıt Açık', 'Dolu']);
const tumu = bugundenSonra(
  (await getCollection('etkinlikler'))
    .map((e) => e.data)
    .filter((e) => AKTIF_DURUM.has(e.durum)),
);
const filtrelenmis = filterEtkinliklerByKategori(tumu, kategori).sort(sortFn);

let liste: EtkinlikData[];
if (isFormatPage) {
  // Format sayfa: sadece kendi kategorisinden tek kart; boşsa liste boş
  // (prose fallback görünecek — brief kart yerine prose).
  liste = filtrelenmis.slice(0, LIMIT);
} else if (kategori && filtrelenmis.length === 0) {
  // Home/Anadolu: kategori var + o kategoride etkinlik yok →
  // tüm yaklaşan etkinlikleri DEFAULT_HEADING ile listele.
  liste = tumu.slice().sort(sortFn).slice(0, LIMIT);
} else {
  liste = filtrelenmis.slice(0, LIMIT);
}

const bos = liste.length === 0;
const heading = (() => {
  if (!kategori) return DEFAULT_HEADING;
  if (isFormatPage) return KATEGORI_EN_YAKIN[kategori] ?? DEFAULT_HEADING;
  // Home/Anadolu: kategori var + etkinlik → çoğul heading; boş → DEFAULT.
  if (bos) return DEFAULT_HEADING;
  return KATEGORI_HEADING[kategori];
})();
---
<section class="sonraki-bulusma" data-section="sonraki-bulusma" data-varyant={isTekKart ? 'tek' : 'liste'}>
  <div class="ocak-container">
    <h2 class="sonraki-bulusma__heading">{heading}</h2>

    {bos ? (
      <p class="sonraki-bulusma__bos">
        {isFormatPage
          ? 'Bu kapının yaklaşan tarihi henüz duyurulmadı. '
          : 'Yaklaşan bir buluşma henüz duyurulmadı. '}
        <a href="/#ates-mektuplari">Ateş Mektupları'na katıl</a>, ilk duyuruyu sen al.
      </p>
    ) : (
      <ul class={`sonraki-bulusma__liste${isTekKart ? ' sonraki-bulusma__liste--tek' : ''}`}>
        {liste.map((etkinlik) => (
          <li class="sonraki-bulusma__item">
            <article class="sonraki-bulusma__kart">
              {etkinlik.kartGorsel && (
                <div aria-hidden="true" class="sonraki-bulusma__gorsel">
                  <img src={etkinlik.kartGorsel} alt="" loading="lazy" />
                </div>
              )}
              <EtkinlikKart etkinlik={etkinlik} baslikTag="h3" metaMode="tarih" />
              {/* brief-etkinlik-detay-route.md FAZ 3 — kart komple link
                  (stretched-link pattern; kayıt mikro-linki üstte kalır).
                  Slug yoksa link basılmaz — loader zaten build-time WARN bastı. */}
              {etkinlik.slug && (
                <a class="sonraki-bulusma__stretched-link" href={`/etkinlik/${etkinlik.slug}`} aria-label={`Detay: ${etkinlik.baslik}`}></a>
              )}
              {etkinlik.kayitUrl && (
                <a class="sonraki-bulusma__kayit" href={etkinlik.kayitUrl}>
                  Kayıt ol →
                </a>
              )}
            </article>
          </li>
        ))}
      </ul>
    )}

    {isTekKart && !bos && (
      <p class="sonraki-bulusma__tumu">
        <a href="/takvim">Tüm tarihler <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>

<style>
  .sonraki-bulusma {
    padding: var(--space-8) 0;
  }

  .sonraki-bulusma__heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--cream);
    text-align: center;
    margin: 0 0 var(--space-6);
    font-weight: 400;
  }

  /* Boş state — kart yerine davet metni (brief-faz3-ek v2 Madde 4).
   * KARAR 109 boş-state pattern kardeşi + /takvim boş state ile tutarlı
   * (aktif Ateş Mektupları daveti, "yakında" placeholder değil). */
  .sonraki-bulusma__bos {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--smoke);
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    line-height: var(--leading-prose);
  }

  .sonraki-bulusma__bos a {
    color: var(--ember);
  }

  .sonraki-bulusma__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .sonraki-bulusma__liste {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tek kart varyantı (brief-faz3-h4-h5 İş 2): 6 format sayfasında kart
   * tek kolon + max-width'le ortalı — masaüstünde 3-kolon boş kalmasın. */
  .sonraki-bulusma__liste--tek {
    grid-template-columns: 1fr;
    max-width: 32rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .sonraki-bulusma__liste--tek {
      grid-template-columns: 1fr;
    }
  }

  /* "Tüm tarihler → /takvim" linki (İş 2): tek kartın altında, sade ortalı. */
  .sonraki-bulusma__tumu {
    text-align: center;
    margin: var(--space-5) 0 0;
  }

  .sonraki-bulusma__tumu a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--ember);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .sonraki-bulusma__tumu a:hover,
  .sonraki-bulusma__tumu a:focus-visible {
    border-bottom-color: var(--ember);
  }

  .sonraki-bulusma__item {
    margin: 0;
  }

  .sonraki-bulusma__kart {
    position: relative;
    height: 100%;
    padding: var(--space-5);
    background: var(--ash);
    border: 1px solid transparent;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color var(--duration-base) var(--ease-out),
                background-color var(--duration-base) var(--ease-out);
  }

  .sonraki-bulusma__kart:hover {
    border-color: var(--ember);
    background: var(--ash-warm);
  }

  /* Stretched link (brief FAZ 3): tüm kart /etkinlik/{slug}'a tıklanabilir.
     "Kayıt ol" mikro-linki üstte kalır (z-index). Focus outline stretched
     link'e uygulanır — klavye kullanıcısı kartın tümünün link olduğunu görür. */
  .sonraki-bulusma__stretched-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-indent: -9999px;
    overflow: hidden;
  }

  .sonraki-bulusma__stretched-link:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
  }

  /* Gövde bloğu (chip + rozet + italik başlık + meta) EtkinlikKart
   * component'ine ekstrakte edildi (brief-faz3-ek v2 Madde 2). Eski
   * __tip/__baslik/__meta/__sep class'ları component tarafına taşındı —
   * EtkinlikTakvimi satırıyla ortak gövde, drift keser. */

  /* Kart üst köşesi görseli (Notion kartGorsel property'si).
   * Kart padding'ini negatif margin ile aşarak flush kenara yaslanır. */
  .sonraki-bulusma__gorsel {
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-3);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--coal);
  }

  .sonraki-bulusma__gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sonraki-bulusma__kayit {
    position: relative; /* stretched link (z-index:1) üstünde kalır */
    z-index: 2;
    display: inline-block;
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ember);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .sonraki-bulusma__kayit:hover,
  .sonraki-bulusma__kayit:focus-visible {
    border-bottom-color: var(--ember);
  }
</style>
