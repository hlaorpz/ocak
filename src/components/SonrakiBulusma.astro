---
// SonrakiBulusma — dinamik etkinlik listesi (KARAR 92, 93; KARAR 127 fragment-split).
// Çağrı sadece PageContent fragment-split'inden: slug prop'u sayfayı tanımlar,
// kategori + heading slug'tan otomatik türetilir.
//
// Davranış (brief-etkinlikkart-home Madde B — Home Açık Kapı sabit):
//   - Home (/) → kategori SABİT 'acik-kapi' (getKategori override); LIMIT=1,
//     heading "İlk Kapı", altında "Tüm tarihler → /takvim". Boş ise kart yok,
//     Açık Kapı boş-state metni. Yeni gelenin ilk teması en düşük eşik olsun
//     (Mini Retreat gibi yüksek eşik yanlış ilk davet olur).
//   - 6 format sayfası (/cember, /acik-kapi, /seremoni, /atolye, /sehir-aksami,
//     /mini-retreat) → kendi kategorisinden LIMIT=1, "En Yakın [Format]" heading,
//     "Tüm tarihler → /takvim" linki. Boş → prose fallback.
//   - Anadolu (/anadolu, yolculuk) → LIMIT=3, KATEGORI_HEADING; kategori var +
//     etkinlik yok → tüm yaklaşan + DEFAULT_HEADING.
//
// Kart gövdesi (chip/rozet/başlık/meta + görsel + stretched-link + kayıt +
// öne-çıkan sol ember çizgi) EtkinlikKart component variant="kart" içinde.
// Burada kalan: heading, liste grid, "Tüm tarihler →" linki, boş-state.

import { getCollection, type CollectionEntry } from 'astro:content';
import { bugundenSonra } from '../lib/format-etkinlik';
import {
  filterEtkinliklerByKategori,
  getKategori,
  DEFAULT_HEADING,
  KATEGORI_HEADING,
  KATEGORI_EN_YAKIN,
  type EtkinlikKategori,
} from '../lib/etkinlik-kategori';
import { isKayitFormat } from '../lib/kayit';
import EtkinlikKart from './EtkinlikKart.astro';

type EtkinlikData = CollectionEntry<'etkinlikler'>['data'];

interface Props {
  /** Çağrıldığı sayfanın slug'u (PageContent fragment-split geçirir). */
  slug: string;
}

const { slug } = Astro.props;
const slugSade = slug.replace(/^\/+/, '');
const isFormatPage = isKayitFormat(slugSade);
const isHome = slug === '/';
const isTekKart = isFormatPage || isHome;
const LIMIT = isTekKart ? 1 : 3;

// Home için kategori sabit acik-kapi (Madde B); diğerleri map'ten türetir.
const kategori: EtkinlikKategori | null = isHome
  ? 'acik-kapi'
  : getKategori(slug);
const HOME_HEADING = 'İlk Kıvılcım';

// Tek-kart yüzeylerde (Home + 6 format sayfası) "En Yakın X" kronolojik olmalı:
// öne-çıkan sticky KAPALI, tarih ASC birincil. Anadolu (isTekKart=false, LIMIT=3)
// mevcut davranışı korur — öne-çıkan üstte.
const sortFn = (a: EtkinlikData, b: EtkinlikData) => {
  if (!isTekKart && a.oneCikar !== b.oneCikar) return a.oneCikar ? -1 : 1;
  if (a.tarihBaslangic !== b.tarihBaslangic)
    return a.tarihBaslangic.localeCompare(b.tarihBaslangic);
  return a.baslik.localeCompare(b.baslik, 'tr');
};

const AKTIF_DURUM = new Set(['Kayıt Açık', 'Dolu']);
const tumu = bugundenSonra(
  (await getCollection('etkinlikler'))
    .map((e) => e.data)
    .filter((e) => AKTIF_DURUM.has(e.durum)),
);
const filtrelenmis = filterEtkinliklerByKategori(tumu, kategori).sort(sortFn);

let liste: EtkinlikData[];
if (isFormatPage || isHome) {
  // Format sayfa + Home: sadece kendi kategorisinden (Home = acik-kapi);
  // boşsa liste boş — boş-state prose görünür.
  liste = filtrelenmis.slice(0, LIMIT);
} else if (kategori && filtrelenmis.length === 0) {
  // Anadolu: kategori var + o kategoride etkinlik yok → tüm yaklaşan
  // etkinlikleri DEFAULT_HEADING ile listele.
  liste = tumu.slice().sort(sortFn).slice(0, LIMIT);
} else {
  liste = filtrelenmis.slice(0, LIMIT);
}

const bos = liste.length === 0;
const heading = (() => {
  if (isHome) return HOME_HEADING;
  if (!kategori) return DEFAULT_HEADING;
  if (isFormatPage) return KATEGORI_EN_YAKIN[kategori] ?? DEFAULT_HEADING;
  if (bos) return DEFAULT_HEADING;
  return KATEGORI_HEADING[kategori];
})();
---
<section class="sonraki-bulusma" data-section="sonraki-bulusma" data-varyant={isTekKart ? 'tek' : 'liste'}>
  <div class="ocak-container">
    <h2 class="sonraki-bulusma__heading">{heading}</h2>

    {bos ? (
      <p class="sonraki-bulusma__bos">
        {isFormatPage || isHome
          ? 'Bu kapının yaklaşan tarihi henüz duyurulmadı. '
          : 'Yaklaşan bir buluşma henüz duyurulmadı. '}
        <a href="/#ates-mektuplari">Ateş Mektupları'na katıl</a>, ilk duyuruyu sen al.
      </p>
    ) : (
      <ul class={`sonraki-bulusma__liste${isTekKart ? ' sonraki-bulusma__liste--tek' : ''}`}>
        {liste.map((etkinlik) => (
          <li class="sonraki-bulusma__item">
            <EtkinlikKart etkinlik={etkinlik} variant="kart" baslikTag="h3" showKayitLink={!isFormatPage} />
          </li>
        ))}
      </ul>
    )}

    {/* Format sayfasında link resolveKayitCtaHref tarafından kayit-cta bloğu
        içine enjekte edilir (buton altına). Burada sadece Home basar. */}
    {isTekKart && !bos && isHome && (
      <p class="sonraki-bulusma__tumu">
        <a href="/takvim">Tüm buluşmalar <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>

<style>
  .sonraki-bulusma {
    padding: var(--space-8) 0;
  }

  .sonraki-bulusma__heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--cream);
    text-align: center;
    margin: 0 0 var(--space-6);
    font-weight: 400;
  }

  /* Boş state (KARAR 109 pattern kardeşi + /takvim boş state ile tutarlı). */
  .sonraki-bulusma__bos {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--smoke);
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    line-height: var(--leading-prose);
  }

  .sonraki-bulusma__bos a {
    color: var(--ember);
  }

  .sonraki-bulusma__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .sonraki-bulusma__liste {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tek kart varyantı: 6 format + Home. Kayıt bloğuyla birebir dar sütun
   * (tek token `--kart-max`). `minmax(0, 1fr)` — grid item min-content 0;
   * uzun tek-kelime başlık (atolye: "Atölye 1107 21:00-22:00 B Zoom") kutuyu
   * genişletemez. Kart içindeki başlık `overflow-wrap: anywhere` ile kırılır. */
  .sonraki-bulusma__liste--tek {
    grid-template-columns: minmax(0, 1fr);
    max-width: var(--kart-max);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .sonraki-bulusma__liste--tek {
      grid-template-columns: 1fr;
    }
  }

  /* Takvim linki: tek kartın altında sade ortalı, davet-fısıltısı
   * (buton baskın değil ama var, link ikincil): margin sıkı, font küçük. */
  .sonraki-bulusma__tumu {
    text-align: center;
    margin: var(--space-3) 0 0;
  }

  .sonraki-bulusma__tumu a {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ember);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .sonraki-bulusma__tumu a:hover,
  .sonraki-bulusma__tumu a:focus-visible {
    border-bottom-color: var(--ember);
  }

  .sonraki-bulusma__item {
    margin: 0;
  }
</style>
