---
// DavetKutusu — kayıt/ödeme success'inde davet kutusu (brief-davet-sistemi).
// "Fiyat kaldıracı YOK" — jest modeli (KORUNACAK İFADE #7). Üç yol:
//   1. WhatsApp ile çağır (birincil) — Web Share API açıksa paylaş menüsü
//      (WhatsApp/Mesajlar/Mail/Instagram); değilse wa.me/?text=... fallback.
//      Numara YOK — kullanıcı kendi kişisini seçer. WhatsappYuzen bot
//      düğmesinden ayrı (KARAR 212-213).
//   2. Instagram'dan göndereceksen kopyala — clipboard. Niyetli etiket;
//      Instagram deep-link kapalı olduğu için kullanıcı DM'ine yapıştırır.
//   3. E-posta ile çağır — /api/davet POST → Resend tek mail + Davetler DB.
//
// Mount edildiği iki yer:
//   - KayitFormu success div'i (havale + ücretsiz, tüm formatlar).
//     refKodu + etkinlikId + etkinlikAdi + etkinlikTarihi + landingPath
//     submit handler tarafından data-attribute olarak set edilir; props
//     boş gelir.
//   - /odeme/tamam (kart redirect sonrası). Props server-side dolu gelir.
//
// JS data-attribute'lardan okur (her iki mod tek pattern).
// Temizlik mikro-metni KVKK güven jesti + marka anlatısı (KORUNACAK İFADE #1).
//
// Eyeball #4 Fix 2: davet metni format-agnostik ("Açık Kapı" sabiti kalktı),
// link format-özel (`/cember`, `/seremoni`, vb. `landingPath` prop'undan).
// Metin şablonu component script'te; değişkenler data-attribute'lardan okur.
//
// ⚠ 22 Ağustos 2026 — `DAVET_AKISI` musluğu (bkz. `davet-akisi.ts`).
// Kapalıyken kutu HİÇ render edilmez: sert hata yok, "şu an kullanılamıyor"
// satırı da yok — kapalı bir yolun adını anmak, açıkken orada bir şey
// olduğunu duyurmaktan başka işe yaramaz. Gate component'in İÇİNDE, mount
// noktalarında değil: iki mount (`KayitFormu.astro` success div'i +
// `odeme/tamam.astro`) tek yerden kapanır, üçüncüsü eklense o da kapanır.
import { DAVET_AKISI_ACIK } from '../lib/davet-akisi.ts';

export interface Props {
  /** OCAK-XXXX referans no (davet edenin izi). Boş ise JS submit handler doldurur. */
  refKodu?: string;
  /**
   * Davet EDEN kadının adı — mail şablonunda konu ve ilk satırda geçer
   * ("Ayşe seni de istedi"). Kullanıcıdan yeni girdi İSTENMEZ; kayıt
   * akışında zaten var. Boşsa JS submit handler doldurur; hiç dolmazsa
   * mail adsız yedeğe düşer ve endpoint `console.warn` basar.
   */
  davetEdenAd?: string;
  /** Notion etkinlik page id (davet linkine gömülür). Boş ise JS submit handler doldurur. */
  etkinlikId?: string;
  /** Etkinlik adı, Notion Etkinlikler Başlık (davet metnine gömülür). Boşsa JS doldurur. */
  etkinlikAdi?: string;
  /** Etkinlik tarihi TR formatlı (örn. "21 Haziran"). Boşsa JS doldurur. */
  etkinlikTarihi?: string;
  /**
   * Davet linkinin gideceği format sayfası (`/cember`, `/acik-kapi`, `/seremoni`,
   * `/mini-retreat`, `/sehir-aksami`, `/atolye`). Geçmiş-etkinlik güvenlik ağı
   * her formatın override sayfasında yaşar. Boşsa JS doldurur; hiç dolmazsa
   * '/acik-kapi' fallback (WhatsApp paylaşımı yine çalışır).
   */
  landingPath?: string;
  /** Etkinliğin kendi sayfası — `etkinlikUrlFormatla(Slug)`. Boş olabilir. */
  etkinlikUrl?: string;
}

const {
  refKodu = '',
  davetEdenAd = '',
  etkinlikId = '',
  etkinlikAdi = '',
  etkinlikTarihi = '',
  landingPath = '',
  /**
   * İŞ 4 (7 Eki) — paylaşılan bağlantı: ETKİNLİĞİN KENDİ SAYFASI
   * (`etkinlikUrlFormatla(Slug)`). Boşsa eski format-sayfası bağlantısına
   * düşülür, yani slug'ı olmayan etkinlikte paylaşım yine çalışır.
   */
  etkinlikUrl = '',
} = Astro.props;
---

{/* ── MUSLUK YERİ DEĞİŞTİ (İŞ 4, 7 Eki) ──
    Eski hâlde `DAVET_AKISI_ACIK` BÜTÜN bloğu sarıyordu: musluk kapanınca
    paylaşım da kayboluyordu. Artık blok daima render ediliyor (başlık + alt
    satır + Paylaş + Bağlantıyı kopyala) ve musluk YALNIZ e-postayla davet
    formunu kapatıyor.

    Kaan kararı (7 Eki): form arayüzden kalkar ama `/api/davet`, Davetler DB,
    Resend şablonu ve `davet-*.ts` SİLİNMEZ — kod yolu muslukla kapalı, dosyalar
    duruyor. `DAVET_AKISI` production'da `acik` OLMAMALI; varsayılan zaten
    kapalı (fail-closed, `davet-akisi.ts:22`).

    ÖLÇÜM (7 Eki): Davetler DB'de **0 satır** — bu hat bugüne kadar hiç satır
    üretmemiş. */}
<aside
  class="davet-kutusu"
  data-davet-kutusu
  data-davet-ref={refKodu}
  data-davet-eden-ad={davetEdenAd}
  data-davet-etkinlik={etkinlikId}
  data-davet-ad={etkinlikAdi}
  data-davet-tarih={etkinlikTarihi}
  data-davet-path={landingPath}
  data-davet-url={etkinlikUrl}
>
  <h3 class="davet-kutusu__baslik">Bir kız kardeşini de çağır</h3>
  <p class="davet-kutusu__metin">Ateşin yanında onun da yeri var.</p>

  <div class="davet-kutusu__yollar">
    {/* ── ÜÇ EŞİT DÜĞME (İŞ 15, 8 Eki) ──
        Üçü de `.ocak-dugme` ve aynı ağırlıkta; mobilde alt alta, 480 px'ten
        sonra yan yana. Kanal seçimi kadının, bizim değil — biri "birincil"
        olsaydı ötekiler ikinci sınıf bir yoldan geçmiş olurdu.

        WhatsApp: HER CİHAZDA `wa.me` (İŞ 15 kararı). `navigator.share`
        KULLANILMIYOR — o menü hedefi kadına seçtirir ve düğmenin üstünde
        "WhatsApp" yazarken Mesajlar'ı açması sözü tutmamak olurdu.

        Instagram: panoya YALNIZ url, sonra İŞ 13 akışı (hikâye kartı
        paylaşımı; desteklenmiyorsa DM gelen kutusu).

        E-posta: `mailto:` — konu ve gövde önceden dolu. */}
    <div class="davet-kutusu__ucluk">
      <button type="button" class="ocak-dugme" data-davet-whatsapp>WhatsApp'ta paylaş</button>
      <button type="button" class="ocak-dugme" data-davet-instagram>Instagram'da paylaş</button>
      <button type="button" class="ocak-dugme" data-davet-eposta>E-postayla paylaş</button>
    </div>

    {/* ── SABİT TALİMAT (İŞ 15) ──
        Düğmelerin altında HER ZAMAN görünür. Eski hâlde bu bilgi yalnız
        Instagram'a dokunulduktan SONRA çıkıyordu — yani kadın akışı
        öğrendiğinde zaten içindeydi. Önceden söylemek, iki sekmeli bir akışı
        beklenmedik kılmaktan iyi.

        Dinamik bilgi satırları KALKTI: tek sabit cümle, duruma göre değişen
        iki varyant yerine. */}
    <p class="davet-kutusu__talimat">
      Instagram'ı seçince kartımız açılır, bağlantı da kopyalanır. Hikâyende
      çıkartmalardan «Bağlantı»ya dokunup yapıştırman yeter.
    </p>

    {/* E-postayla davet — YALNIZ musluk açıkken. Gerekçe yukarıda. */}
    {DAVET_AKISI_ACIK && (
    <form class="davet-kutusu__mail" data-davet-mail novalidate>
      {/* KARAR 152/194 honeypot — bot doldurur, endpoint sessiz success.
          `.hp-field` (global.css) offscreen'dir, `display:none` DEĞİL: bazı
          botlar görünürlük check eder. Gerçek kullanıcı + screen reader
          aria-hidden + tabindex -1 ile zaten kapı dışında. */}
      <div class="hp-field" aria-hidden="true">
        <label for="davet-website">Website</label>
        <input type="text" name="website" id="davet-website" tabindex="-1" autocomplete="off" />
      </div>

      {/* Zaman damgası — kutu GÖRÜNÜR olduğu anda dolar (mount değil; success
          ekranı geç açılıyorsa yanlış ölçüm olmasın). Boş kalırsa sunucu
          sessizce reddeder: eksik damga da rettir (KARAR 1). */}
      <input type="hidden" name="davet-ts" value="" data-davet-ts />

      <label class="davet-kutusu__sr-only" for="davet-email">
        Arkadaşının e-postasını gir
      </label>
      {/* Eyeball #4 tur-2 Fix 3: input + Gönder tek çerçevede bütünleşik yol.
          Dış konteyner (.mail-kutu) WhatsApp/Instagram butonlarıyla aynı
          çerçeve dilinde; içeride sol input alanı + sağ ayraç + sabit-genişlik
          Gönder. Göz "3 yol" sayar (alt metin "Üç yol" ile uyumlu). */}
      <div class="davet-kutusu__mail-kutu">
        <input
          id="davet-email"
          name="davet-email"
          type="email"
          required
          autocomplete="off"
          placeholder="arkadaşının e-postası"
          class="davet-kutusu__mail-input"
          data-davet-mail-input
        />
        <button
          type="submit"
          class="davet-kutusu__mail-gonder"
          data-davet-mail-btn
        >
          Gönder
        </button>
      </div>
      {/* Rıza satırı — davet eden kadın adının gideceğini bilmeden
          göndermemeli. ONAY KUTUSU DEĞİL, bilgilendirme: rıza zaten
          gönderme jestinde, kutu işaretletmek jesti bürokrasiye çevirirdi.
          Yeri e-posta alanının hemen altı — kararın alındığı an orası. */}
      <p class="davet-kutusu__riza">
        Adın ve hangi buluşmaya geldiğin görünecek.
      </p>
      <p class="davet-kutusu__mail-hata" data-davet-mail-hata hidden></p>
    </form>
    )}
  </div>

  <p class="davet-kutusu__teyit" data-davet-teyit hidden role="status" aria-live="polite"></p>

  {/* Bu söz E-POSTA davetine ait ("yalnızca tek bir mesaj ulaşır", "hiçbir
      listeye eklemeyiz") — paylaş/kopyala yolunda biz kimseye mesaj
      göndermiyoruz, kadın kendi kanalından paylaşıyor. Musluk kapalıyken
      söylenecek bir şey yok. */}
  {DAVET_AKISI_ACIK && (
  <p class="davet-kutusu__temizlik">
    Davet ettiğin kişiye yalnızca tek bir mesaj ulaşır. Onu hiçbir listeye
    eklemeyiz, biz aramayız. Gelmek tamamen ona kalmış.
  </p>
  )}
</aside>

<style>
  /* Eyeball #4 tur-2 Fix 2: kutu ölçülü öne çıkar — soluk gri çerçeve
     ember alpha'ya çevrildi, subtle dış glow eklendi (hero glow'dan çok
     zayıf, KARAR 116/118 ember disiplini). Başlık boyutu dokunulmadı;
     sadece kutu kabı vurgulanır. */
  .davet-kutusu {
    margin: var(--space-7) auto 0;
    padding: var(--space-6) var(--space-5);
    max-width: 42ch;
    text-align: center;
    border: 1px solid rgba(196, 75, 47, 0.35);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.015);
    box-shadow: 0 0 32px rgba(196, 75, 47, 0.12);
  }

  .davet-kutusu__baslik {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--cream);
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 var(--space-3);
  }

  .davet-kutusu__metin {
    font-family: var(--font-body);
    color: var(--cream-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 var(--space-5);
  }

  .davet-kutusu__yollar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  /* ── `.davet-kutusu__btn*` KURALLARI KALKTI (İŞ 11, 7 Eki) ──
   * İki düğme artık `.ocak-dugme` (global.css) kullanıyor ve bu yerel aile
   * tüketicisiz kaldı. Ölü CSS bırakılmadı.
   *
   * Bu aile `.ocak-dugme`'den üç yerde ayrışmıştı ve ayrışma bir ders:
   * `--birincil` metin rengi `--cream`'di (paylaşılan sınıf `--coal` —
   * kardeşlerin ember üstünde kullandığı koyu metin), `border-radius: 3px`
   * vardı (sitenin hiçbir düğmesinde yok) ve `--duration-fast` kullanıyordu
   * (öteki düğmeler `--duration-base`). Dört ayrı yerel düğme kopyasının
   * dördü de farklı ayrışmıştı; `.ocak-dugme` bu yüzden var (İŞ 1). */

  /* Eyeball #4 tasarım toparlama: e-posta bloğu dikey ritme alındı, ardından
     tur-2 Fix 3 ile input+Gönder tek çerçeve içinde bütünleşik yol.
     Form 3 yolun aynı çerçeve dilinde durur; alt metin "Üç yol" ile uyumlu. */
  .davet-kutusu__mail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
  }

  .davet-kutusu__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* İŞ 15 — ÜÇ EŞİT düğme. Mobilde alt alta, 480 px'ten sonra yan yana ve
   * eşit genişlikte: ağırlık eşitliği görsel olarak da okunmalı. */
  .davet-kutusu__ucluk {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 480px) {
    .davet-kutusu__ucluk {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Sabit talimat — havale/kart notlarıyla aynı ağırlıkta (küçük, smoke).
   * DİNAMİK DEĞİL: her zaman görünür, duruma göre değişmez (İŞ 15). */
  .davet-kutusu__talimat {
    margin: var(--space-3) auto 0;
    max-width: 42ch;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--smoke);
    line-height: 1.5;
  }

  /* Tek dış çerçeve — Instagram ("ucuncu") kutusunun kardeşi (transparent
     zemin + ash border + focus-within'de ember). İçeride sol geniş input +
     sağ dikey ayraç + sabit-genişlik Gönder. */
  .davet-kutusu__mail-kutu {
    display: flex;
    align-items: stretch;
    background: transparent;
    border: 1px solid var(--ash);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .davet-kutusu__mail-kutu:focus-within {
    border-color: var(--smoke);
  }

  .davet-kutusu__mail-input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    padding: 0.75rem 0.9rem;
    background: transparent;
    border: 0;
    color: var(--cream);
    box-sizing: border-box;
  }
  .davet-kutusu__mail-input:focus-visible {
    outline: none;
  }
  .davet-kutusu__mail-input::placeholder {
    color: var(--smoke);
  }

  .davet-kutusu__mail-gonder {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.2;
    color: var(--cream-soft);
    background: transparent;
    border: 0;
    border-left: 1px solid var(--ash);
    padding: 0.75rem 1.1rem;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .davet-kutusu__mail-gonder:hover,
  .davet-kutusu__mail-gonder:focus-visible {
    color: var(--cream);
    background: rgba(255, 255, 255, 0.03);
    outline: none;
  }
  .davet-kutusu__mail-gonder[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  /* Rıza satırı — alt-metin boyutunda, `.temizlik` mikro-metniyle aynı
     dilde ama e-posta alanına bağlı olduğu için onun hemen altında durur.
     `--smoke` bilinçli: uyarı değil, dipnot. */
  .davet-kutusu__riza {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--smoke);
    margin: 0;
  }

  .davet-kutusu__mail-hata {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--ember);
    margin: 0;
  }
  .davet-kutusu__mail-hata[hidden] { display: none; }

  .davet-kutusu__teyit {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--cream);
    margin: 0 0 var(--space-5);
    padding: var(--space-3);
    background: rgba(196, 75, 47, 0.08);
    border-radius: 3px;
  }
  .davet-kutusu__teyit[hidden] { display: none; }

  .davet-kutusu__temizlik {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--smoke);
    margin: 0;
    padding: 0 var(--space-2);
  }
</style>

<script>
  /**
   * DavetKutusu davranışı — her DavetKutusu instance'ı için bağımsız bind.
   * Sayfada birden fazla varsa (teorik) her biri kendi data-attribute'larını
   * okur.
   *
   * Eyeball #4 Fix 2 (Yol A — nötr metin + format-özel link):
   *   - Metin şablonu format-agnostik ("buluşma" şemsiye terim). Değişkenler
   *     etkinlikAdi + etkinlikTarihi data-attribute'lardan gelir; ek çekim
   *     riskini önlemek için ad iki noktadan sonra yalın basılır.
   *   - Link format-özel: `${origin}${landingPath}?etkinlik=<id>&ref=<kod>`.
   *     Fallback (`landingPath` boş): `/acik-kapi` — WhatsApp paylaşımı yine
   *     çalışır, geçmiş-etkinlik güvenlik ağı bu path'te aktif.
   *   - Tek metin, her kanal aynı (WhatsApp + kopyala + e-posta).
   */
  // ── Paylaşım metni (İŞ 4, 7 Eki) — Kaan verdi, birebir ──
  // Eski hâli etkinlik adını ve tarihi cümlenin içine katıyordu; yeni metin
  // sabit ve etkinlik bilgisi BAĞLANTININ kendisinde yaşıyor. Parametreler
  // KALDIRILMADI: imza iki tüketici tarafından paylaşılıyor (paylaş + kopyala)
  // ve ileride metin yeniden kişiselleşebilir.
  function davetMetni(_etkinlikAdi: string, _etkinlikTarihi: string): string {
    return 'Ateşin başında olacağım. Sen de gelmek istersen yanımda yer var:';
  }

  /**
   * Paylaşılan bağlantı.
   *
   * ── İŞ 4 (7 Eki) — ETKİNLİĞİN KENDİ SAYFASI ──
   * Birinci tercih `etkinlikUrl` = `etkinlikUrlFormatla(Slug)` →
   * `https://www.ocak.biz/etkinlik/<slug>`. Kaan'ın kararı bu: paylaşılan şey
   * bir takip bağlantısı değil, buluşmanın kendi sayfası.
   *
   * ⚠ BU DEĞİŞİKLİK `?ref=OCAK-XXXX` TAKİBİNİ DÜŞÜRÜR. Eski bağlantı
   * `${origin}${landingPath}?etkinlik=<id>&ref=<kod>` idi ve `ref` parametresi
   * KayitFormu'nun gizli alanına düşüp Kayıtlar `Davet Eden Ref` kolonunu
   * besliyordu (davet eden kadının kredisi). Raporlandı; davet hattının
   * kendisi bu turda muslukla kapatıldığı ve Davetler DB'de 0 satır olduğu
   * için tutarlı — ama atıf kaybı bilinçli bir sonuç.
   *
   * `etkinlikUrl` boşsa (Slug yok) eski bağlantıya düşülür: paylaşım
   * çalışmaya devam eder, kırık bir adres üretilmez.
   */
  function davetUrl(refKodu: string, etkinlikId: string, landingPath: string, etkinlikUrl: string): string {
    if (etkinlikUrl) return etkinlikUrl;
    const origin = window.location.origin;
    const path = landingPath && landingPath.startsWith('/') ? landingPath : '/acik-kapi';
    const params = new URLSearchParams();
    if (etkinlikId) params.set('etkinlik', etkinlikId);
    if (refKodu) params.set('ref', refKodu);
    const qs = params.toString();
    return `${origin}${path}${qs ? `?${qs}` : ''}`;
  }

  /**
   * ── WhatsApp'ta paylaş (İŞ 15) ──
   *
   * HER CİHAZDA `wa.me`. `navigator.share` KULLANILMIYOR ve bu bilinçli: o
   * menü hedefi kadına seçtirir, yani düğmenin üstünde "WhatsApp" yazarken
   * Mesajlar ya da Mail açılabilir. Düğme ne diyorsa onu yapmalı.
   *
   * Yeni sekmede (`window.open`) — aynı sekmede açmak kadını referans
   * kodunun ve IBAN'ın durduğu başarı ekranından çıkarırdı.
   */
  function whatsappPaylas(text: string, url: string): void {
    window.open(
      `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`,
      '_blank',
      'noopener,noreferrer',
    );
  }

  /**
   * ── E-postayla paylaş (İŞ 15) ──
   *
   * Konu ve gövde önceden dolu; gövdede metin ve bağlantı iki satır arayla.
   * `location.href` kullanılıyor, `window.open` DEĞİL: `mailto:` yeni sekmede
   * açıldığında bazı tarayıcılar boş bir sekme bırakıyor ve kadın ona geri
   * dönmek zorunda kalıyor.
   */
  function epostaPaylas(text: string, url: string): void {
    const konu = encodeURIComponent('Ateşin başında olacağım');
    const govde = encodeURIComponent(`${text}\n\n${url}`);
    window.location.href = `mailto:?subject=${konu}&body=${govde}`;
  }

  /* ── Eski birleşik `paylas()` KALDIRILDI (İŞ 15) ──
   * `navigator.share({ text, url })` ile hedefi kadına seçtiriyordu. İŞ 15
   * kanalları açık düğmelere ayırdı: WhatsApp düğmesi WhatsApp'ı açar,
   * Instagram düğmesi Instagram'ı. Paylaş menüsü yalnız HİKÂYE KARTI
   * dosyası için kullanılıyor (İŞ 13) — orada hedef zaten dosyayı alan
   * uygulama. */

  /**
   * Panoya yazar. `kopyalaMetin` ham dizeyi alır; `kopyala` metin+bağlantıyı
   * birleştirir.
   *
   * İŞ 15 — Instagram yolunda panoya YALNIZ `url` gidiyor: kadın onu hikâyede
   * "Bağlantı" çıkartmasına yapıştırıyor ve o alan bir URL bekliyor. Metinle
   * birlikte kopyalamak çıkartmayı bozardı.
   */
  async function kopyalaMetin(tam: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(tam);
      return true;
    } catch {
      // Eski tarayıcı fallback — execCommand deprecated ama bazı eski Safari
      // sürümleri için geçici. Hata olursa false dön.
      try {
        const ta = document.createElement('textarea');
        ta.value = tam;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        // execCommand deprecated ama Clipboard API yokken (eski Safari) tek
        // çalışan fallback. Yedek yolu bilinçli koruyoruz.
        const ok = (document as Document & {
          execCommand: (cmd: string) => boolean;
        }).execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function init(): void {
    document.querySelectorAll<HTMLElement>('[data-davet-kutusu]').forEach((kutu) => {
      const teyit = kutu.querySelector<HTMLElement>('[data-davet-teyit]');
      const mailForm = kutu.querySelector<HTMLFormElement>('[data-davet-mail]');
      const mailInput = kutu.querySelector<HTMLInputElement>('[data-davet-mail-input]');
      const mailBtn = kutu.querySelector<HTMLButtonElement>('[data-davet-mail-btn]');
      const mailHata = kutu.querySelector<HTMLElement>('[data-davet-mail-hata]');
      const tsInput = kutu.querySelector<HTMLInputElement>('[data-davet-ts]');
      const hpInput = kutu.querySelector<HTMLInputElement>('[name="website"]');

      /**
       * Zaman damgası — kutu GÖRÜNÜR olduğu anda, bir kez.
       *
       * Neden mount değil: iki mount bağlamı da damgayı bayatlatırdı.
       * KayitFormu'nda kutu success div'inin içinde `hidden` doğar ve ancak
       * kayıt tamamlanınca açılır; /odeme/tamam'da sayfa açık unutulabilir.
       * Mount anını damgalamak, kadın daveti gönderdiğinde 6 saatlik yaş
       * sınırına takılmasına yol açardı (`davet-kapi.ts` AZAMI_FORM_YASI_MS).
       *
       * IntersectionObserver `hidden` ata altında tetiklenmez — istediğimiz
       * bu. Arka plan sekmesinde de ilerlemez; sekme öne gelince damga o an
       * düşer, insan yine 3 saniyeyi harcar, kayıp yok.
       *
       * Ağ: IO desteklenmiyorsa (çok eski tarayıcı) input focus'unda damgala.
       * Gerçek gönderim zaten input'a yazmayı gerektirir; bot focus üretmez.
       */
      let tsDamgalandi = false;
      function tsDamgala(): void {
        if (tsDamgalandi || !tsInput) return;
        tsInput.value = String(Date.now());
        tsDamgalandi = true;
      }

      if (typeof IntersectionObserver === 'function') {
        const gozlemci = new IntersectionObserver((girisler) => {
          for (const giris of girisler) {
            if (giris.isIntersecting) {
              tsDamgala();
              gozlemci.disconnect();
              break;
            }
          }
        });
        gozlemci.observe(kutu);
      }
      mailInput?.addEventListener('focus', tsDamgala);

      function teyitGoster(metin: string): void {
        if (!teyit) return;
        teyit.textContent = metin;
        teyit.hidden = false;
      }

      function getDavet(): {
        ref: string;
        etkinlik: string;
        edenAd: string;
        ad: string;
        tarih: string;
        path: string;
        url: string;
        metin: string;
      } {
        const ref = kutu.dataset.davetRef ?? '';
        const etkinlik = kutu.dataset.davetEtkinlik ?? '';
        const edenAd = kutu.dataset.davetEdenAd ?? '';
        const ad = kutu.dataset.davetAd ?? '';
        const tarih = kutu.dataset.davetTarih ?? '';
        const path = kutu.dataset.davetPath ?? '';
        return {
          ref,
          etkinlik,
          edenAd,
          ad,
          tarih,
          path,
          url: davetUrl(ref, etkinlik, path, (kutu.dataset.davetUrl ?? '').trim()),
          metin: davetMetni(ad, tarih),
        };
      }

      // ── ÜÇ DÜĞME (İŞ 15) ──
      // Dinamik bilgi satırları KALKTI: talimat artık sabit ve markup'ta,
      // her zaman görünür. Eski hâlde iki varyant vardı ve ikisi de yalnız
      // dokunulduktan SONRA çıkıyordu — kadın akışı öğrendiğinde zaten
      // içindeydi.

      kutu
        .querySelector<HTMLButtonElement>('[data-davet-whatsapp]')
        ?.addEventListener('click', () => {
          const { url, metin } = getDavet();
          whatsappPaylas(metin, url);
        });

      kutu
        .querySelector<HTMLButtonElement>('[data-davet-eposta]')
        ?.addEventListener('click', () => {
          const { url, metin } = getDavet();
          epostaPaylas(metin, url);
        });

      // ── Instagram'da paylaş (İŞ 13 akışı + İŞ 15 panosu) ──
      //
      // İki yol, sırayla DENENİYOR:
      //
      //  (a) HİKÂYE KARTI — `navigator.canShare({ files })` destekliyorsa
      //      görsel paylaşım sayfasına verilir ve kadın onu doğrudan hikâyeye
      //      koyar. Bağlantı panoda duruyor; hikâyede "Bağlantı" çıkartmasına
      //      yapıştırıyor.
      //      ⚠ `share` çağrısında YALNIZ `files` var. `text`/`url` eklemek
      //      Instagram'da metni düşürüyor, bazı hedefler ise dosyayı atlıyor.
      //
      //  (b) DESTEKLENMİYORSA (masaüstü, eski tarayıcı) → DM gelen kutusu
      //      yeni sekmede.
      //
      // ⚠ Panoya YALNIZ `url` gidiyor (İŞ 15): hikâyedeki "Bağlantı"
      // çıkartması bir URL bekliyor, metinle birlikte kopyalamak onu bozardı.
      //
      // ⚠ Görsel BASINCA fetch ediliyor, sayfa yüklenirken DEĞİL: 2,3 MB'lık
      // bir PNG'yi hiç paylaşmayacak her kadına indirtmek olurdu.
      //
      // ⚠ Pano reddedilirse paylaşıma yine devam edilir — talimat sabit
      // olduğu için gösterilecek/gizlenecek bir satır yok.
      //
      // ⚠ Kullanıcı paylaşımdan vazgeçerse (`AbortError`) SESSİZ kalınır.
      const HIKAYE_YOLU = '/paylas/ocak-hikaye-karti.png';
      const HIKAYE_ADI = 'ocak-hikaye-karti.png';

      /** Hikâye kartını `File`'a çevirir. Fetch düşerse `null`. */
      async function hikayeDosyasi(): Promise<File | null> {
        try {
          const res = await fetch(HIKAYE_YOLU);
          if (!res.ok) return null;
          const blob = await res.blob();
          return new File([blob], HIKAYE_ADI, { type: 'image/png' });
        } catch {
          return null;
        }
      }

      function dmYolu(): void {
        window.open(
          'https://www.instagram.com/direct/inbox/',
          '_blank',
          'noopener,noreferrer',
        );
      }

      kutu
        .querySelector<HTMLButtonElement>('[data-davet-instagram]')
        ?.addEventListener('click', async () => {
          const { url } = getDavet();

          // 1. Panoya YALNIZ bağlantı.
          await kopyalaMetin(url);

          // 2. Görsel, BASINCA.
          const dosya = await hikayeDosyasi();

          // 3. Dosya paylaşımı destekleniyor mu.
          const nav = navigator as Navigator & {
            canShare?: (data: ShareData) => boolean;
            share?: (data: ShareData) => Promise<void>;
          };
          const dosyaPaylasilir =
            !!dosya &&
            typeof nav.canShare === 'function' &&
            typeof nav.share === 'function' &&
            nav.canShare({ files: [dosya] });

          if (!dosyaPaylasilir) {
            dmYolu();
            return;
          }

          try {
            await nav.share!({ files: [dosya!] });
          } catch (err) {
            // Vazgeçme SESSİZ. Başka bir hata da kadına gösterilmez: görsel
            // paylaşılamadıysa bağlantı hâlâ panosunda.
            const ad = (err as { name?: string } | null)?.name ?? '';
            if (ad !== 'AbortError') {
              console.warn(`[davet] hikâye paylaşımı düştü: ${ad || 'bilinmeyen'}`);
            }
          }
        });

      mailForm?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (!mailInput || !mailBtn) return;
        const davetEdilenEmail = mailInput.value.trim();

        if (mailHata) {
          mailHata.hidden = true;
          mailHata.textContent = '';
        }

        if (!EMAIL_RE.test(davetEdilenEmail)) {
          if (mailHata) {
            mailHata.textContent = 'Geçerli bir e-posta gir.';
            mailHata.hidden = false;
          }
          return;
        }

        const { ref, etkinlik, edenAd, ad, tarih, path } = getDavet();

        /**
         * Prop zinciri sağlaması — burada, gönderimden ÖNCE.
         *
         * Sunucu tarafı da yedeğe düştüğünde warn basar, ama oradaki warn
         * "alan gövdede yoktu" der; hangi mount noktasının doldurmadığını
         * söyleyemez. Buradaki warn tarayıcı konsolunda, kadının o an
         * baktığı sayfada düşer — kırık halkayı gösteren tek yer.
         *
         * Yedeklerin ÇALIŞMAMASI beklenir (brief İŞ 2). Bu satır düşüyorsa
         * zincir kopmuştur, mailin adsız gitmesi semptomdur.
         */
        const eksik: string[] = [];
        if (!edenAd) eksik.push('davetEdenAd');
        if (!ad) eksik.push('etkinlikAd');
        if (!tarih) eksik.push('etkinlikTarih');
        if (!path) eksik.push('landingPath');
        if (eksik.length) {
          console.warn(
            `[davet] prop zinciri eksik: ${eksik.join(', ')} — mail yedek metne düşecek`,
          );
        }

        mailBtn.disabled = true;
        const oncekiMetin = mailBtn.textContent;
        mailBtn.textContent = 'Gönderiliyor…';

        try {
          const res = await fetch('/api/davet', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              refKodu: ref,
              davetEdilenEmail,
              kanal: 'mail',
              etkinlikId: etkinlik,
              // Bağlam — mail şablonu + Davetler DB için. Üçü de kayıt
              // akışında zaten var, kullanıcıdan yeni girdi istenmez.
              //
              // ⚠ Hepsi GÖVDEDE taşınır, query'de değil (KARAR 270). O karar
              // davet EDİLENİN e-postası için yazıldı; aynı disiplini yeni
              // alanlara da uyguluyoruz — davet edenin adı da kişisel veri,
              // URL'e girmesi için bir sebep yok.
              davetEdenAd: edenAd,
              etkinlikAd: ad,
              etkinlikTarih: tarih,
              landingPath: path,
              // Bot kapısı — sunucu tarafı `davet-kapi.ts`. Honeypot doluysa
              // ya da damga yok/erken/bayatsa sunucu sessiz `success` döner;
              // kullanıcı arayüzü ayrımı GÖREMEZ, bilerek.
              website: hpInput?.value ?? '',
              ts: tsInput?.value ?? '',
            }),
          });
          const data = (await res.json().catch(() => ({}))) as {
            status?: string;
            message?: string;
          };
          if (res.ok && data.status === 'success') {
            mailInput.value = '';
            teyitGoster('Davetin yola çıktı 🔥');
          } else if (data.status === 'skip') {
            teyitGoster('Bu davetin yola çıkmıştı, tekrarına gerek yok.');
            mailInput.value = '';
          } else {
            if (mailHata) {
              mailHata.textContent = data.message ?? 'Gönderilemedi, biraz sonra dene.';
              mailHata.hidden = false;
            }
          }
        } catch {
          if (mailHata) {
            mailHata.textContent = 'Bağlantı hatası. Tekrar dene.';
            mailHata.hidden = false;
          }
        } finally {
          mailBtn.disabled = false;
          mailBtn.textContent = oncekiMetin ?? 'Gönder';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
