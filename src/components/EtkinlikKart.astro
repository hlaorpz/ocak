---
// EtkinlikKart — tek görsel dil, iki variant (brief-etkinlikkart-home Madde A).
// Dört tüketici:
//   - EtkinlikTakvimi satırı → variant="satir" + showTarihRozeti
//   - SonrakiBulusma home tek-kart → variant="kart"
//   - SonrakiBulusma format sayfası En Yakın kart → variant="kart"
//   - SonrakiBulusma /bulusmalar → variant="kart" (aynı)
//
// Tek fark iki variant arasında: dış çerçeve (satır flex-row + sol tarih rozeti
// vs box flex-column + kart görseli). Chip, online/yüz-yüze rozeti, öne-çıkan
// ember çizgi, italik başlık, meta, "Kayıt ol →", /etkinlik/{slug} stretched
// link — hepsi ORTAK.
//
// Meta şeması showTarihRozeti'den türer:
//   showTarihRozeti=true  → "Yöneten · Mekân · Saat"  (tarih sol rozette)
//   showTarihRozeti=false → "Tarih · Mekân[ · Detay]" (rozet yok)
//
// Öne-çıkan (etkinlik.oneCikar=true) → her iki variant'ta sol ember 2px border.
// Satır variant'ında ayrıca üst-satırda küçük "öne çıkan" etiketi (mevcut takvim
// davranışı korunur; kart variant'ında etiket yok, sol çizgi yeterli).
import type { CollectionEntry } from 'astro:content';
import { formatEtiket, mekanTipi } from '../lib/etkinlik-kategori';
import { formatEtkinlikTarihi } from '../lib/format-etkinlik';

type EtkinlikData = CollectionEntry<'etkinlikler'>['data'];

interface Props {
  etkinlik: EtkinlikData;
  variant?: 'satir' | 'kart';
  baslikTag?: 'h3' | 'h4' | 'span';
  showTarihRozeti?: boolean;
}

const {
  etkinlik,
  variant = 'kart',
  baslikTag,
  showTarihRozeti = false,
} = Astro.props;

const BaslikTag = baslikTag ?? (variant === 'satir' ? 'span' : 'h3');
const mTipi = mekanTipi(etkinlik.mekan);

const AY_KISA = ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'];
function tarihRozeti(iso: string): { gun: string; ay: string } {
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return { gun: '·', ay: '' };
  return { gun: String(Number(m[3])), ay: AY_KISA[Number(m[2]) - 1] ?? '' };
}
const rozet = showTarihRozeti ? tarihRozeti(etkinlik.tarihBaslangic) : null;

const kartClass = [
  'ocak-etkinlik-kart',
  `ocak-etkinlik-kart--${variant}`,
  etkinlik.oneCikar ? 'ocak-etkinlik-kart--one-cikan' : '',
]
  .filter(Boolean)
  .join(' ');
---
<article class={kartClass}>
  {rozet && (
    <span class="ocak-etkinlik-kart__tarih-rozeti" aria-hidden="true">
      <span class="ocak-etkinlik-kart__rozet-gun">{rozet.gun}</span>
      <span class="ocak-etkinlik-kart__rozet-ay">{rozet.ay}</span>
    </span>
  )}

  {variant === 'kart' && etkinlik.kartGorsel && (
    <div aria-hidden="true" class="ocak-etkinlik-kart__gorsel">
      <img src={etkinlik.kartGorsel} alt="" loading="lazy" />
    </div>
  )}

  <div class="ocak-etkinlik-kart__govde">
    <div class="ocak-etkinlik-kart__ust-satir">
      <span class="ocak-etkinlik-kart__chip">{formatEtiket(etkinlik.tip)}</span>
      {mTipi && (
        <span class={`ocak-etkinlik-kart__rozet ocak-etkinlik-kart__rozet--${mTipi}`}>
          {mTipi === 'online' ? 'Online' : 'Yüz Yüze'}
        </span>
      )}
      {etkinlik.oneCikar && variant === 'satir' && (
        <span class="ocak-etkinlik-kart__one">öne çıkan</span>
      )}
    </div>

    <BaslikTag class="ocak-etkinlik-kart__baslik">{etkinlik.baslik}</BaslikTag>

    {showTarihRozeti ? (
      <p class="ocak-etkinlik-kart__meta">
        {[etkinlik.yoneten, etkinlik.mekan, etkinlik.saat]
          .filter((v): v is string => Boolean(v && v.trim()))
          .map((v, i) => (
            <Fragment>
              {i > 0 && <span class="ocak-etkinlik-kart__sep" aria-hidden="true">·</span>}
              <span>{v}</span>
            </Fragment>
          ))}
      </p>
    ) : (
      <p class="ocak-etkinlik-kart__meta">
        <span>
          {formatEtkinlikTarihi(
            etkinlik.tarihBaslangic,
            etkinlik.tarihBitis,
            etkinlik.saat ?? etkinlik.zoomBaslangicSaati,
          )}
        </span>
        <span class="ocak-etkinlik-kart__sep" aria-hidden="true">·</span>
        <span>
          {etkinlik.mekanDetay ? `${etkinlik.mekan} · ${etkinlik.mekanDetay}` : etkinlik.mekan}
        </span>
      </p>
    )}
  </div>

  {etkinlik.slug && (
    <a
      class="ocak-etkinlik-kart__stretched"
      href={`/etkinlik/${etkinlik.slug}`}
      aria-label={`Detay: ${etkinlik.baslik}`}
    ></a>
  )}

  {etkinlik.kayitUrl && (
    <a class="ocak-etkinlik-kart__kayit" href={etkinlik.kayitUrl}>
      Kayıt ol <span aria-hidden="true">→</span>
    </a>
  )}
</article>

<style>
  /* Ortak: dış çerçeve pozisyon ankraj (stretched link için). */
  .ocak-etkinlik-kart {
    position: relative;
  }

  /* ============ SATIR variant (takvim /takvim) ============ */
  .ocak-etkinlik-kart--satir {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    border-top: 1px solid var(--ash);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .ocak-etkinlik-kart--satir:hover {
    background: var(--ash-warm);
  }

  /* Öne-çıkan sol ember çizgi (her iki variant'ta ortak dil). */
  .ocak-etkinlik-kart--satir.ocak-etkinlik-kart--one-cikan {
    border-left: 2px solid var(--ember);
    padding-left: calc(var(--space-3) - 2px);
  }

  /* ============ KART variant (SonrakiBulusma tek-kart / En Yakın) ============ */
  .ocak-etkinlik-kart--kart {
    height: 100%;
    padding: var(--space-5);
    background: var(--ash);
    border: 1px solid transparent;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color var(--duration-base) var(--ease-out),
                background-color var(--duration-base) var(--ease-out);
  }

  .ocak-etkinlik-kart--kart:hover {
    border-color: var(--ember);
    background: var(--ash-warm);
  }

  /* Öne-çıkan sol ember çizgi (satır ile tutarlı görsel dil). */
  .ocak-etkinlik-kart--kart.ocak-etkinlik-kart--one-cikan {
    border-left: 2px solid var(--ember);
  }

  /* Kart üst köşesi görseli (kartGorsel property). */
  .ocak-etkinlik-kart__gorsel {
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-3);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--coal);
  }

  .ocak-etkinlik-kart__gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ============ Sol tarih rozeti (satır only) ============ */
  .ocak-etkinlik-kart__tarih-rozeti {
    flex-shrink: 0;
    width: 3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .ocak-etkinlik-kart__rozet-gun {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    color: var(--cream);
    font-weight: 500;
  }

  .ocak-etkinlik-kart__rozet-ay {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ember);
    margin-top: var(--space-1);
  }

  /* ============ Gövde (chip satırı + başlık + meta) ============ */
  .ocak-etkinlik-kart__govde {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .ocak-etkinlik-kart__ust-satir {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .ocak-etkinlik-kart__chip {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ember);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .ocak-etkinlik-kart__rozet {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--cream-soft);
    border: 1px solid var(--ash);
    padding: 0.1em 0.55em;
    line-height: 1.4;
  }

  .ocak-etkinlik-kart__rozet--fiziksel {
    border-color: var(--ember);
    color: var(--ember);
  }

  .ocak-etkinlik-kart__one {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--coal);
    background: var(--ember);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: 0.15em 0.6em;
  }

  .ocak-etkinlik-kart__baslik {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--cream);
    line-height: var(--leading-snug);
    margin: 0;
    font-weight: 400;
  }

  h3.ocak-etkinlik-kart__baslik,
  h4.ocak-etkinlik-kart__baslik {
    font-size: var(--text-h4);
    line-height: 1.3;
  }

  .ocak-etkinlik-kart__meta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--cream-soft);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
  }

  .ocak-etkinlik-kart__sep {
    color: var(--smoke);
  }

  /* ============ Stretched link + kayıt mikro-link ============ */
  .ocak-etkinlik-kart__stretched {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-indent: -9999px;
    overflow: hidden;
  }

  .ocak-etkinlik-kart__stretched:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
  }

  .ocak-etkinlik-kart__kayit {
    position: relative;
    z-index: 2;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ember);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .ocak-etkinlik-kart__kayit:hover,
  .ocak-etkinlik-kart__kayit:focus-visible {
    border-bottom-color: var(--ember);
  }

  /* Satır'da kayıt sağda, flex-shrink 0. */
  .ocak-etkinlik-kart--satir .ocak-etkinlik-kart__kayit {
    flex-shrink: 0;
  }

  /* Kart'ta kayıt en altta (mt-auto column layout). */
  .ocak-etkinlik-kart--kart .ocak-etkinlik-kart__kayit {
    margin-top: auto;
    padding-top: var(--space-3);
    align-self: flex-start;
    display: inline-block;
  }

  /* ============ Mobile — satır dikey kırılır ============ */
  @media (max-width: 600px) {
    .ocak-etkinlik-kart--satir {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .ocak-etkinlik-kart--satir .ocak-etkinlik-kart__tarih-rozeti {
      flex-direction: row;
      width: auto;
      gap: var(--space-2);
      align-items: baseline;
    }
    .ocak-etkinlik-kart--satir .ocak-etkinlik-kart__rozet-ay {
      margin-top: 0;
    }
    .ocak-etkinlik-kart--satir .ocak-etkinlik-kart__kayit {
      width: 100%;
      padding-left: calc(3rem + var(--space-4));
    }
  }
</style>
