---
// BulusmalarFormatSekmeleri — /bulusmalar şemsiye sayfası 6 format ARIA tabs deseni
// (Brief REVİZE — Sekme; önceki sticky scroll-spy şerit commit 202a6c4 kaldırıldı).
//
// Yön değişimi nedeni: 6 format dikey alt alta serilince Takvim + devam bölümleri
// çok aşağıda kalıyordu. Sekme deseninde 6 formatın tamamı tek panelde dönüşür →
// format-takvim + hangisinden-baslasam + siradaki-kapi panel'in HEMEN altında
// sabit kalır, "çok aşağıda" sorunu yok olur. Bu component PANEL içeriğini de
// taşır; format section'larının iç HTML'leri sayfa override'ında çıkarılıp
// prop olarak iletilir.
//
// ARIA Tabs Authoring Practice (WAI-ARIA APG):
//   - role="tablist" / role="tab" / role="tabpanel"
//   - aria-selected aktif tuşta "true", diğerleri "false"
//   - aria-controls (tab → panel) + aria-labelledby (panel → tab)
//   - roving tabindex: aktif=0, diğer=-1
//   - klavye: ←/→ döngüsel, Home/End ilk/son, otomatik aktivasyon
//
// SEO + a11y: 6 panel SSR'da HTML'e basılı — Google + AT renderer tüm içeriği görür.
// Inline script (yine de Astro tarafından `type="module"` deferred) yüklenir
// yüklenmez 5 aktif olmayan paneli `hidden` yapar. Module deferred olduğu için
// kısa bir flicker olabilir (6 panel görünür → 1'i kalır); brief sıkı no-flash
// istemiyor (öncelik no-JS fallback). JS yoksa 6 panel görünür kalır →
// progressive enhancement (dikey liste gibi okunur, brief md.50 sınırı).
//
// Görsel dil EtkinlikTakvimi __tur ile aynı (ash zemin, ember hover/aktif) —
// OCAK ailesinde tek sekme/filter dili kalır.

interface FormatItem {
  id: string;    // örn. "format-cember" — panel + aria-controls hedefi
  label: string; // tuş etiketi, örn. "Çember"
  html: string;  // section'ın iç HTML'i (loader'dan h2 + p)
}

interface Props {
  formats: FormatItem[];
}

const { formats } = Astro.props;
---
<div class="ocak-format-sekmeler" data-format-sekmeler>
  <div role="tablist" aria-label="Formatlar" class="ocak-format-sekmeler__list">
    {formats.map((f, i) => (
      <button
        type="button"
        role="tab"
        id={`${f.id}-tab`}
        aria-controls={f.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class={`ocak-format-sekmeler__tus${i === 0 ? ' is-aktif' : ''}`}
      >{f.label}</button>
    ))}
  </div>
  <div class="ocak-format-sekmeler__paneller">
    {formats.map((f) => (
      <section
        role="tabpanel"
        id={f.id}
        aria-labelledby={`${f.id}-tab`}
        data-section={f.id}
        class={`ocak-${f.id} ocak-format-panel`}
        tabindex="0"
        set:html={f.html}
      />
    ))}
  </div>
</div>

<script>
  // Sekme davranışı — WAI-ARIA Tabs Authoring (otomatik aktivasyon).
  // Yükleme: aktif olmayan paneller hidden yapılır (SSR'da hidden YOK — no-JS'te
  // hepsi görünür kalsın). Aktif sekme/panel zaten aria-selected="true"+tabindex=0
  // ile SSR'da işaretli.
  const koklar = document.querySelectorAll<HTMLElement>('[data-format-sekmeler]');
  koklar.forEach((kok) => {
    const tuslar = Array.from(kok.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneller = Array.from(kok.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (tuslar.length === 0 || paneller.length === 0) return;

    let aktifIdx = Math.max(
      0,
      tuslar.findIndex((t) => t.getAttribute('aria-selected') === 'true'),
    );
    // İlk JS-hidden uygulama — aktif değilse hide.
    paneller.forEach((p, i) => {
      p.hidden = i !== aktifIdx;
    });

    function setActive(idx: number, focus: boolean = false) {
      tuslar.forEach((t, i) => {
        const aktif = i === idx;
        t.setAttribute('aria-selected', aktif ? 'true' : 'false');
        t.setAttribute('tabindex', aktif ? '0' : '-1');
        t.classList.toggle('is-aktif', aktif);
      });
      paneller.forEach((p, i) => {
        if (i === idx) {
          p.hidden = false;
          // Animasyonu yeniden tetikle — class kaldır + reflow + ekle.
          p.classList.remove('is-fading-in');
          // Force reflow:
          void p.offsetWidth;
          p.classList.add('is-fading-in');
        } else {
          p.hidden = true;
          p.classList.remove('is-fading-in');
        }
      });
      aktifIdx = idx;
      if (focus) tuslar[idx].focus();
    }

    tuslar.forEach((tus, i) => {
      tus.addEventListener('click', () => setActive(i, false));
      tus.addEventListener('keydown', (e) => {
        const key = e.key;
        let next = -1;
        if (key === 'ArrowLeft') next = (i - 1 + tuslar.length) % tuslar.length;
        else if (key === 'ArrowRight') next = (i + 1) % tuslar.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = tuslar.length - 1;
        if (next >= 0) {
          e.preventDefault();
          setActive(next, true);
        }
      });
    });
  });
</script>

<style>
  .ocak-format-sekmeler {
    /* Panel sonu hairline (::after) + devam blokları arası kasıtlı nefes.
     * Hairline'ın altında space-7 (3rem) component margin → format-takvim
     * section padding-top (baseline ~4rem) ile toplam ~7rem; hairline'ın
     * üstünde panel padding-bottom (baseline ~4rem). "Buradan yukarısı
     * pencere, aşağısı sabit zemin" sınırı — kopuk değil, kasıtlı. */
    margin: 0 0 var(--space-7);
  }

  /* Panel sonrası tek hairline — sekmeler bölgesinin kapanış sınırı.
   * Eski "her blok üstüne durak hairline" pattern'inin TEK konuma uygulanmış
   * hâli (Brief Ek — Panel Sonrası Ayraç): centered ember-alpha, dekoratif
   * değil işlevsel ("pencere bitti, ortak zemin başlıyor"). Sol-rail değil
   * centered — baseline'ın centered tipografi ailesiyle uyumlu (KARAR 116).
   * Köz gradient (Varyant B): 180px genişlik, --ember-alpha-85 orta durak,
   * kenarlar transparent → köz sıcaklığı merkezde yoğun. Hover/animasyon
   * YOK (statik, KARAR 350 ruhu). Dikey ritim değişmez. */
  .ocak-format-sekmeler::after {
    content: '';
    display: block;
    width: 180px;
    height: 1px;
    margin: 0 auto;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--ember-alpha-85) 50%,
      transparent 100%
    );
  }

  /* Tablist — EtkinlikTakvimi __tur görsel dili (ash zemin, ember hover/aktif),
   * 1px ash alt çizgi tablist'i panelden ayırır. */
  .ocak-format-sekmeler__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    max-width: 64rem;
    margin: 0 auto var(--space-7);
    padding: 0 var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--ash);
  }

  .ocak-format-sekmeler__tus {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--cream-soft);
    background: var(--ash);
    border: 1px solid transparent;
    padding: 0.5em 1.1em;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .ocak-format-sekmeler__tus:hover,
  .ocak-format-sekmeler__tus:focus-visible {
    color: var(--cream);
    border-color: var(--ember);
    outline: none;
  }

  .ocak-format-sekmeler__tus.is-aktif,
  .ocak-format-sekmeler__tus[aria-selected='true'] {
    color: var(--coal);
    background: var(--ember);
    border-color: var(--ember);
  }

  /* Mobilde 6 tuş tek satıra sığmazsa yatay scroll (touch swipe). */
  @media (max-width: 600px) {
    .ocak-format-sekmeler__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      padding: 0 var(--space-3) var(--space-4);
    }
    .ocak-format-sekmeler__tus {
      flex-shrink: 0;
      white-space: nowrap;
    }
  }

  /* Paneller — atmosfer baseline `section[data-section][class^="ocak-"]` prose
   * stillerini taşıyor (max-w-prose, padding, h2, p). Buradaki ek:
   *   - JS-toggle hidden: display: none (browser default zaten, ama netleştir).
   *   - tabindex'li panel focus outline.
   *   - Yumuşak fade-in: is-fading-in class JS tarafından her aktivasyonda
   *     re-attach edilir (reflow trick → animasyon tekrar oynar). */
  .ocak-format-panel[hidden] {
    display: none;
  }

  .ocak-format-panel[tabindex]:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 4px;
  }

  .ocak-format-panel.is-fading-in {
    animation: ocak-format-panel-in 0.36s var(--ease-out) both;
  }

  @keyframes ocak-format-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ocak-format-panel.is-fading-in {
      animation: none;
    }
  }
</style>
