---
// Hero — sayfa-başı section (KARAR 92, 93, 102)
// oda prop'u glow yoğunluğunu belirler (KARAR 102 sapma 2):
//   - OCAK → strong (0.12 / 0.05 / 0.02)
//   - diğer 5 oda → soft (0.10 / 0.04 / 0.02)
// Glow inline radial-gradient (legacy verbatim, blur YOK, drift YOK)
// fadeUp staggered intro: eyebrow .3s / title .6s / subtitle .9s / cta 1.2s / scroll 1.8s
// Scroll indicator: hero dibinde köz akış çizgisi — scrollAkis (transform-origin:top center
//   scaleY 0→.3→1 + opacity 0→1→.9→0, 2.4s ease-out delay 1.8s infinite,
//   transparent→ember-alpha-85→ember gradient). brief-hero-v2-duzeltme.md ADIM 2.

export type Oda = 'OCAK' | 'Yol' | 'Buluşmalar' | 'Yolculuk' | 'Biz' | 'İletişim';

interface Props {
  oda: Oda;
  overline?: string;       // ALL CAPS (KARAR 92), opsiyonel
  title: string;           // ana H1 başlık
  subtitle?: string;       // italik tagline, opsiyonel
  ctaText?: string;        // CTA buton metni
  ctaHref?: string;        // CTA buton link
  showScroll?: boolean;    // scroll indicator göster (default: true)
  /**
   * Brief brief-fotolu-onizleme.md — fotolu önizleme hero arka plan görseli.
   * undefined ise hero__bg div'i hiç basılmaz → master HTML byte-identik kalır.
   * Doluyken: tam ekran cover image + coal degrade overlay (metin okunaklığı için).
   */
  bgImage?: string;
}

const {
  oda,
  overline,
  title,
  subtitle,
  ctaText,
  ctaHref,
  showScroll = true,
  bgImage,
} = Astro.props;
---
<section class="hero" data-section="hero" data-oda={oda}>{bgImage && (<div aria-hidden="true" style={`position:absolute;inset:0;background-image:url('${bgImage}');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:0;`}><div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(26,18,16,0.55) 0%,rgba(26,18,16,0.35) 45%,rgba(26,18,16,0.85) 100%);"></div></div>)}
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content ocak-container">
    {overline && (
      <p class="hero__overline ocak-overline">{overline}</p>
    )}

    <h1 class="hero__title">{title}</h1>

    {subtitle && (
      <p class="hero__subtitle"><em>{subtitle}</em></p>
    )}

    {ctaText && ctaHref && (
      <a class="hero__cta" href={ctaHref}>{ctaText}</a>
    )}
  </div>

  {/* Scroll indicator hero'nun DOĞRUDAN çocuğu — .hero__content wrapper içinde
      olursa absolute konumu content'e göre alır ve hero'nun ortasında görünür.
      brief-hero-v2-duzeltme.md düzeltme turu tanı. */}
  {showScroll && (
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    /* Tam ekran hero — fallback 100vh (Safari eski), sonra 100svh (adres çubuğu payı). */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* === GLOW (KARAR 102 sapma 2 — oda-bazlı) === */
  /* KARAR 114 stop yapısı korundu (4 stop, aynı yüzdeler ve alpha değerleri —
   * banding riski nedeniyle dokunulmaz, Safari halka sorunu KARAR 131).
   * Geometri brief-hero-v2-duzeltme.md ADIM 1 ile büyütüldü: kuyruk uzasın, ışık
   * hero sınırını aşıp gövdeye doğal sızsın, hero-altı devam sinyali glow'un
   * kendi kuyruğundan gelsin (ayrı gradyan katmanı YOK). blur YOK, drift YOK.
   *
   * bottom yüzde → sabit -172.5px (v2 kuyruk düzeltme, H-agnostic):
   * Yüzde tabanlı bottom viewport yüksekliğine (100svh) bağlıydı, hero_bottom'da
   * radial normalized distance H'ye bağlı değişiyordu — mobilde (H~700) alpha
   * ~0.019 (görsel OK), masaüstünde (H~800-1000+) alpha 0.024-0.040 → keskin
   * yatay bant görünür. Sabit -172.5px ile element.center = hero_bottom - 402.5
   * her ekranda; hero_bottom noktası ellipse'te tam %70 stop = alpha 0. Kesim
   * her ekranda temiz. (Element hero dışına 172.5px taşıyor, overflow:hidden
   * hâlâ gizliyor — kuyruk niyeti fonksiyonel olarak korunuyor.) */
  .hero__glow {
    position: absolute;
    bottom: -172.5px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 1150px;
    pointer-events: none;
    z-index: 0;
  }

  /* OCAK odası — strong (legacy/index.html .hero::before) */
  .hero[data-oda="OCAK"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.12) 0%,
      rgba(196, 75, 47, 0.05) 30%,
      rgba(212, 168, 85, 0.02) 50%,
      transparent 70%
    );
  }

  /* Diğer 5 oda — soft (legacy/acik-kapi.html .hero::before) */
  .hero[data-oda="Yol"] .hero__glow,
  .hero[data-oda="Buluşmalar"] .hero__glow,
  .hero[data-oda="Yolculuk"] .hero__glow,
  .hero[data-oda="Biz"] .hero__glow,
  .hero[data-oda="İletişim"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.10) 0%,
      rgba(196, 75, 47, 0.04) 30%,
      rgba(212, 168, 85, 0.02) 50%,
      transparent 70%
    );
  }

  /* === CONTENT LAYOUT === */

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  /* === TYPOGRAPHY (semantik fluid token'lar, KARAR 102 sapma 4) === */

  .hero__overline {
    /* .ocak-overline class'ı zaten global.css'te tanımlı */
    color: var(--ember);
  }

  .hero__title {
    font-family: var(--font-display);
    font-style: italic;          /* #24 Brief 2 Sürpriz #4 — legacy <em>söndü?</em> partial italic → full italic (KARAR 105 Hero pattern) */
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.1;
    color: var(--cream);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-size: var(--text-manifesto);
    font-style: italic;
    color: var(--cream-soft);
    margin: 0;
    max-width: 32ch;
  }

  /* CTA Varyant C — silik köz çerçeve, hover'da belirginleşir. brief-hero-v2 ADIM 3.
   * v1 dolu köz zemin (hover) satış-butonu diliydi; davet ≠ satış, ayrıca hero
   * dibindeki köz çizgisiyle yarışıyordu. Şimdi hem tek hal (masaüstü/mobil aynı),
   * hem daha yumuşak. */
  .hero__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--warm-gray);
    background: transparent;
    border: 1px solid var(--ember-alpha-32);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  /* Hover kuralı @media (hover: hover) içinde — iOS Safari :hover yapışma bugı
   * (dokunma sonrası hover state kalıcı yanık kalıyor, KARAR 186 iOS ailesi). */
  @media (hover: hover) {
    .hero__cta:hover {
      border-color: var(--ember);
      color: var(--cream);
    }
  }

  /* Dokunmatik + klavye anlık geri bildirim — :hover yerine :active/:focus-visible. */
  .hero__cta:active,
  .hero__cta:focus-visible {
    border-color: var(--ember);
    color: var(--cream);
  }

  /* === SCROLL INDICATOR — hero dibinde köz akış çizgisi ===
   * brief-hero-v2-duzeltme.md ADIM 2. v1'de hero'nun ortasındaydı (butonun üstünde,
   * silik gri) — yeri ve gücü yanlıştı. Şimdi hero'nun en alt kenarında, güçlü
   * köz gradient (aşağı doğru toplanıyor, akış yönü belirgin).
   *
   * Safe-area: iOS home indicator olan cihazlarda alt boşluk otomatik dolar;
   * olmayan cihazlarda 8px minimum nefes payı — max() ile birleştirildi. */

  .hero__scroll {
    position: absolute;
    /* 48px minimum — masaüstünde tarayıcı chrome payı, mobilde home indicator
     * (safe-area ~34px) 48px altında kalır → 48px kazanır. Çizgi 64px yüksek,
     * 48px offset ile toplam 112px hero içinde kalıyor → overflow:hidden'da
     * kırpma yok (glow taşma koruması KARAR 114 dokunulmaz).
     * v1: 8px'ti → viewport dibinde sıkışıp mobilde chrome altına kayıyordu. */
    bottom: max(env(safe-area-inset-bottom, 0px), 48px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 64px;
    /* Yukarısı sönük, aşağısı tam köz — akış yönünü çizgi rengiyle de göster. */
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--ember-alpha-85) 45%,
      var(--ember) 100%
    );
    transform-origin: top center;
    /* Staggered intro son eleman: 1.8s delay (legacy sıra korunur). Line kendi
     * scrollAkis'i ile hem doğar (0% opacity 0) hem sürer — wrapper'a fadeUp
     * uygulanmaz (fadeUp translateY(0) wrapper'ın translateX(-50%)'ini ezerdi). */
    animation: scrollAkis 2.4s ease-out 1.8s infinite;
  }

  @keyframes scrollAkis {
    0%   { transform: scaleY(0);   opacity: 0;   }
    18%  { transform: scaleY(0.3); opacity: 1;   }
    70%  { transform: scaleY(1);   opacity: 0.9; }
    100% { transform: scaleY(1);   opacity: 0;   }
  }

  /* === STAGGERED INTRO (legacy verbatim: 0.3 / 0.6 / 0.9 / 1.2 / 1.8s) === */
  /* fadeUp keyframes global.css'te (Brief 4a) */

  /* .hero__scroll bu block dışında: fadeUp translateY(0) wrapper'ın translateX
   * ortalamasını ezerdi. Line kendi scrollAkis'iyle intro yapar (delay 1.8s). */
  .hero__overline,
  .hero__title,
  .hero__subtitle,
  .hero__cta {
    opacity: 0;
    animation: fadeUp 0.9s ease both;
  }

  .hero__overline { animation-delay: 0.3s; }
  .hero__title    { animation-delay: 0.6s; }
  .hero__subtitle { animation-delay: 0.9s; }
  .hero__cta      { animation-delay: 1.2s; }

  /* === ACCESSIBILITY === */

  @media (prefers-reduced-motion: reduce) {
    .hero__overline,
    .hero__title,
    .hero__subtitle,
    .hero__cta {
      opacity: 1;
      animation: none;
    }
    .hero__scroll-line {
      animation: none;
      /* Statik + tam boy + sabit opacity — akış animasyonunun "durgun" hali. */
      transform: scaleY(1);
      opacity: 0.55;
    }
  }

  /* === RESPONSIVE === */

  @media (max-width: 768px) {
    .hero__content { gap: var(--space-4); }
  }
</style>
