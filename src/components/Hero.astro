---
// Hero — sayfa-başı section (KARAR 92, 93, 102)
// oda prop'u glow yoğunluğunu belirler (KARAR 102 sapma 2):
//   - OCAK → strong (0.12 / 0.05 / 0.02)
//   - diğer 5 oda → soft (0.10 / 0.04 / 0.02)
// Glow inline radial-gradient (legacy verbatim, blur YOK, drift YOK).
// B21/KARAR 204: %50 durağındaki gold artık `color-mix(in srgb, var(--gold) 2%,
// transparent)` — hesaplanan renk rgba(212,168,85,0.02) ile BİREBİR aynı
// (--gold = #D4A855 = 212,168,85), yalnız hardcode tek kaynağa bağlandı.
// fadeUp staggered intro: eyebrow .3s / title .6s / subtitle .9s / cta 1.2s
// Scroll indicator: hero dibinde köz akış çizgisi — .hero__scroll{,-line}. CSS
//   src/styles/atmosfer.css'te tek noktada (component + plugin ortak). Plugin
//   remark-ocak-sections.ts 'hero' case'i aynı DOM'u emit eder.

export type Oda = 'OCAK' | 'Yol' | 'Buluşmalar' | 'Yolculuk' | 'Biz' | 'İletişim';

interface Props {
  oda: Oda;
  overline?: string;       // ALL CAPS (KARAR 92), opsiyonel
  title: string;           // ana H1 başlık
  subtitle?: string;       // italik tagline, opsiyonel
  ctaText?: string;        // CTA buton metni
  ctaHref?: string;        // CTA buton link
  showScroll?: boolean;    // scroll indicator göster (default: true)
  /**
   * 14 Eki — hero içi KÖZ DOLU kayıt düğmesi; tarih satırının (subtitle)
   * hemen altına düşer. `kayitHref` + `kayitMetin` birlikte verilmezse hiç
   * basılmaz. İkisi ayrı prop çünkü `ctaText`/`ctaHref` BAŞKA bir düğmedir:
   * o soluk çerçeveli (transparent zemin, 1px ember-alpha kenar) ghost CTA;
   * bu ise `.ocak-kayit-cta__buton` ile aynı görsel ağırlıkta dolu düğme.
   *
   * ⚠ Stil BURADA yaşıyor, atmosfer.css'ten gelmiyor — ve bu bilinçli.
   * `atmosfer.css:1754` kuralı `section[data-section="kayit-btn"][class^="ocak-"]
   * > .ocak-kayit-cta__buton`, yani DOĞRUDAN ÇOCUK seçici: aynı class'ı hero
   * içine koymak çıplak link verirdi ("kod var ≠ output var" sınıfı sessiz
   * fakirleşme). Ayrıca o kural `display:block; width:100%`; hero düğmesi
   * içerik genişliğinde olmalı. Bu yüzden ayrı class + scoped stil.
   */
  kayitHref?: string;
  kayitMetin?: string;
}

const {
  oda,
  overline,
  title,
  subtitle,
  ctaText,
  ctaHref,
  showScroll = true,
  kayitHref,
  kayitMetin,
} = Astro.props;
---
<section class="hero" data-section="hero" data-oda={oda}>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content ocak-container">
    {overline && (
      <p class="hero__overline ocak-overline">{overline}</p>
    )}

    <h1 class="hero__title">{title}</h1>

    {subtitle && (
      <p class="hero__subtitle"><em>{subtitle}</em></p>
    )}

    {/* Köz dolu kayıt düğmesi — tarih satırının HEMEN ALTI. Yeri ölçüyle
        seçildi (14 Eki, 390×844): hero `h=844`, subtitle `y=539–571`,
        hero'dan sonraki ilk blok `y=907`. Yani hero'nun ALTINA konan bir
        section ilk ekrana hiç girmez; düğmenin `hero__content` içinde olması
        zorunlu. Buraya giren düğme ~y=600'de, ilk ekranda. */}
    {kayitHref && kayitMetin && (
      <a class="hero__kayit" href={kayitHref} data-hero-kayit>
        {kayitMetin}{' '}<span aria-hidden="true">→</span>
      </a>
    )}

    {ctaText && ctaHref && (
      <a class="hero__cta" href={ctaHref}>{ctaText}</a>
    )}
  </div>

  {/* Scroll indicator hero'nun DOĞRUDAN çocuğu — .hero__content wrapper içinde
      olursa absolute konumu content'e göre alır ve hero'nun ortasında görünür.
      brief-hero-v2-duzeltme.md düzeltme turu tanı. */}
  {showScroll && (
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    /* Tam ekran hero — fallback 100vh (Safari eski), sonra 100svh (adres çubuğu payı). */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* overflow:hidden KALDIRILDI (Test A doğrulaması): clip edge #manifesto
     * scroll durağında subpixel artefaktı olarak açık şerit üretiyordu.
     * hero_bottom'da glow alpha zaten 0 → clip fonksiyonu yoktu. Yatay taşma
     * body { overflow-x: hidden } (global.css:14) tarafında. atmosfer.css
     * [data-section="hero"] ile çift-hizalı. */
  }

  /* === GLOW (KARAR 102 sapma 2 — oda-bazlı) === */
  /* KARAR 114 stop yapısı korundu (4 stop, aynı yüzdeler ve alpha değerleri —
   * banding riski nedeniyle dokunulmaz, Safari halka sorunu KARAR 131).
   * Geometri brief-hero-v2-duzeltme.md ADIM 1 ile büyütüldü: kuyruk uzasın, ışık
   * hero sınırını aşıp gövdeye doğal sızsın (overflow:hidden kaldırıldı —
   * asıl v2 niyeti bu). blur YOK, drift YOK.
   *
   * bottom: sabit -172.5px (H-agnostic): element.center = hero_bottom - 402.5
   * her ekranda; hero_bottom normalized distance = 402.5/575 = tam %70 stop →
   * alpha 0. Kuyruk hero dışına 172.5px sızıyor ama o bölgede de alpha 0 —
   * görsel katkısı yok, sadece "hiçbir kesim yok" garantisi. */
  .hero__glow {
    position: absolute;
    bottom: -172.5px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 1150px;
    pointer-events: none;
    z-index: 0;
  }

  /* OCAK odası — strong (legacy/index.html .hero::before) */
  .hero[data-oda="OCAK"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.12) 0%,
      rgba(196, 75, 47, 0.05) 30%,
      color-mix(in srgb, var(--gold) 2%, transparent) 50%,
      transparent 70%
    );
  }

  /* Diğer 5 oda — soft (legacy/acik-kapi.html .hero::before) */
  .hero[data-oda="Yol"] .hero__glow,
  .hero[data-oda="Buluşmalar"] .hero__glow,
  .hero[data-oda="Yolculuk"] .hero__glow,
  .hero[data-oda="Biz"] .hero__glow,
  .hero[data-oda="İletişim"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.10) 0%,
      rgba(196, 75, 47, 0.04) 30%,
      color-mix(in srgb, var(--gold) 2%, transparent) 50%,
      transparent 70%
    );
  }

  /* === CONTENT LAYOUT === */

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  /* === TYPOGRAPHY (semantik fluid token'lar, KARAR 102 sapma 4) === */

  .hero__overline {
    /* .ocak-overline class'ı zaten global.css'te tanımlı */
    color: var(--ember);
  }

  .hero__title {
    font-family: var(--font-display);
    font-style: italic;          /* #24 Brief 2 Sürpriz #4 — legacy <em>söndü?</em> partial italic → full italic (KARAR 105 Hero pattern) */
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.1;
    color: var(--cream);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-size: var(--text-manifesto);
    font-style: italic;
    color: var(--cream-soft);
    margin: 0;
    max-width: 32ch;
  }

  /* CTA Varyant C — silik köz çerçeve, hover'da belirginleşir. brief-hero-v2 ADIM 3.
   * v1 dolu köz zemin (hover) satış-butonu diliydi; davet ≠ satış, ayrıca hero
   * dibindeki köz çizgisiyle yarışıyordu. Şimdi hem tek hal (masaüstü/mobil aynı),
   * hem daha yumuşak. */
  .hero__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--warm-gray);
    background: transparent;
    border: 1px solid var(--ember-alpha-32);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  /* === hero__kayit — hero içi KÖZ DOLU kayıt düğmesi (14 Eki) ==============
   * Görsel grameri `atmosfer.css:1754`'teki `.ocak-kayit-cta__buton` ile
   * eşlenik: ember dolu zemin, coal metin, uppercase, 0.22em letter-spacing,
   * aynı hover parlaması. İki bilinçli sapma:
   *   1. `display: inline-block` + içerik genişliği — kardeşi `display:block;
   *      width:100%` (kart genişliğine kilitli). Hero'da tam genişlik düğme
   *      başlıkla yarışır; brief "genişlik içerik kadar" diyor.
   *   2. Kural BURADA, atmosfer.css'te değil — o dosyadaki seçici
   *      `section[data-section="kayit-btn"] > …` doğrudan çocuk kapısı, hero
   *      içinde hiç eşleşmezdi. Class adı da ayrı tutuldu (`hero__kayit`) ki
   *      "ocak-kayit-cta__buton gibi görünüp stilsiz kalan" bir ikiz doğmasın.
   * ⚠ İkisi birlikte değişir: ember düğme dili atmosfer.css'te güncellenirse
   *   bu kural da güncellenmeli (iki yerde yaşayan tek dil).
   * ======================================================================== */
  .hero__kayit {
    /* ⚠ Computed CSS'te `block` görünür, `inline-block` değil — `.hero__content`
     * bir flex kabı ve flex çocukları blokify olur. Genişlik yine de İÇERİK
     * kadar kalıyor çünkü kap `align-items: center`; ölçüldü (390×844): düğme
     * 198 px, kap 342 px. Yani beyan burada, görünür sonucu flex veriyor —
     * computed `block` görüp "tam genişlik olmuş" diye okuma. */
    display: inline-block;
    margin-top: var(--space-2);
    padding: 1.125rem 3.5rem;
    background: var(--ember);
    border: 1px solid var(--ember);
    color: var(--coal);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }

  /* iOS Safari :hover yapışması (KARAR 186 ailesi) — hover ayrı kapıda. */
  @media (hover: hover) {
    .hero__kayit:hover {
      background: var(--ember-soft);
      box-shadow: 0 0 25px rgba(196, 75, 47, 0.3);
    }
  }

  .hero__kayit:active,
  .hero__kayit:focus-visible {
    background: var(--ember-soft);
    box-shadow: 0 0 25px rgba(196, 75, 47, 0.3);
    outline: none;
  }

  /* Telefonda 3.5rem yatay padding dar ekranda taşabilir — kardeşiyle aynı
   * kademe (atmosfer.css max-width:600px dalı 2.5rem/0.2em'e iniyor). */
  @media (max-width: 600px) {
    .hero__kayit {
      padding: 1rem 2.5rem;
      letter-spacing: 0.2em;
    }
  }

  /* Hover kuralı @media (hover: hover) içinde — iOS Safari :hover yapışma bugı
   * (dokunma sonrası hover state kalıcı yanık kalıyor, KARAR 186 iOS ailesi). */
  @media (hover: hover) {
    .hero__cta:hover {
      border-color: var(--ember);
      color: var(--cream);
    }
  }

  /* Dokunmatik + klavye anlık geri bildirim — :hover yerine :active/:focus-visible. */
  .hero__cta:active,
  .hero__cta:focus-visible {
    border-color: var(--ember);
    color: var(--cream);
  }

  /* Scroll indicator .hero__scroll{,-line} kuralları atmosfer.css'te tek
   * noktada (component + plugin ortak). Element emit'i altta showScroll
   * prop'una bağlı; showScroll={false} kayıt/form sayfalarında (12 sayfa)
   * çizgiyi bastırır. */

  /* === STAGGERED INTRO (legacy verbatim: 0.3 / 0.6 / 0.9 / 1.2s) === */
  /* fadeUp keyframes global.css'te (Brief 4a) */

  /* .hero__scroll bu block dışında: fadeUp translateY(0) wrapper'ın translateX
   * ortalamasını ezerdi. Line kendi scrollAkis'iyle intro yapar (delay 0.8s,
   * kural atmosfer.css'te). */
  .hero__overline,
  .hero__title,
  .hero__subtitle,
  .hero__kayit,
  .hero__cta {
    opacity: 0;
    animation: fadeUp 0.9s ease both;
  }

  .hero__overline { animation-delay: 0.3s; }
  .hero__title    { animation-delay: 0.6s; }
  .hero__subtitle { animation-delay: 0.9s; }
  /* Kayıt düğmesi tarih satırını hemen izler (1.1s) — ghost CTA'dan önce;
   * ikisi aynı hero'da hiç birlikte basılmıyor, sıra yine de tutarlı kalsın. */
  .hero__kayit    { animation-delay: 1.1s; }
  .hero__cta      { animation-delay: 1.2s; }

  /* === ACCESSIBILITY === */

  @media (prefers-reduced-motion: reduce) {
    .hero__overline,
    .hero__title,
    .hero__subtitle,
    .hero__kayit,
    .hero__cta {
      opacity: 1;
      animation: none;
    }
    /* .hero__scroll-line reduced-motion durumu atmosfer.css'te (tek noktada). */
  }

  /* === RESPONSIVE === */

  @media (max-width: 768px) {
    .hero__content { gap: var(--space-4); }
  }
</style>
