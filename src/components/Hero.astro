---
// Hero — sayfa-başı section (KARAR 92, 93, 102)
// oda prop'u glow yoğunluğunu belirler (KARAR 102 sapma 2):
//   - OCAK → strong (0.12 / 0.05 / 0.02)
//   - diğer 5 oda → soft (0.10 / 0.04 / 0.02)
// Glow inline radial-gradient (legacy verbatim, blur YOK, drift YOK)
// fadeUp staggered intro: eyebrow .3s / title .6s / subtitle .9s / cta 1.2s / scroll 1.8s
// Scroll indicator: scrollAkis (transform-origin:top scaleY 0→.35→1 + opacity 0→1→.85→0,
//   2s ease-out infinite, smoke gradient) — brief-hero-gecis.md ADIM 2 pulse→akış geçişi.

export type Oda = 'OCAK' | 'Yol' | 'Buluşmalar' | 'Yolculuk' | 'Biz' | 'İletişim';

interface Props {
  oda: Oda;
  overline?: string;       // ALL CAPS (KARAR 92), opsiyonel
  title: string;           // ana H1 başlık
  subtitle?: string;       // italik tagline, opsiyonel
  ctaText?: string;        // CTA buton metni
  ctaHref?: string;        // CTA buton link
  showScroll?: boolean;    // scroll indicator göster (default: true)
  /**
   * Brief brief-fotolu-onizleme.md — fotolu önizleme hero arka plan görseli.
   * undefined ise hero__bg div'i hiç basılmaz → master HTML byte-identik kalır.
   * Doluyken: tam ekran cover image + coal degrade overlay (metin okunaklığı için).
   */
  bgImage?: string;
}

const {
  oda,
  overline,
  title,
  subtitle,
  ctaText,
  ctaHref,
  showScroll = true,
  bgImage,
} = Astro.props;
---
<section class="hero" data-section="hero" data-oda={oda}>{bgImage && (<div aria-hidden="true" style={`position:absolute;inset:0;background-image:url('${bgImage}');background-size:cover;background-position:center;background-repeat:no-repeat;z-index:0;`}><div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(26,18,16,0.55) 0%,rgba(26,18,16,0.35) 45%,rgba(26,18,16,0.85) 100%);"></div></div>)}
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content ocak-container">
    {overline && (
      <p class="hero__overline ocak-overline">{overline}</p>
    )}

    <h1 class="hero__title">{title}</h1>

    {subtitle && (
      <p class="hero__subtitle"><em>{subtitle}</em></p>
    )}

    {ctaText && ctaHref && (
      <a class="hero__cta" href={ctaHref}>{ctaText}</a>
    )}

    {showScroll && (
      <div class="hero__scroll" aria-hidden="true">
        <span class="hero__scroll-line"></span>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Peek — hero tam ekranı doldurmasın, altındaki içerik ipucu görünsün.
     * brief-hero-gecis.md ADIM 1. Fallback 90vh (Safari eski sürüm), sonra svh. */
    min-height: calc(90vh - var(--nav-height));
    min-height: var(--hero-height);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* === GLOW (KARAR 102 sapma 2 — oda-bazlı, legacy verbatim) === */
  /* Legacy: radial 800x800, ember rgba, bottom -20% left 50%, blur YOK, drift YOK */

  /* Legacy geometri: 800x800 box, bottom -20% left 50% translateX(-50%),
     radial ellipse at center. .hero overflow:hidden ile alttan kırpılır.
     (Brief 2b — legacy/index.html .hero::before verbatim) */
  .hero__glow {
    position: absolute;
    bottom: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    pointer-events: none;
    z-index: 0;
  }

  /* OCAK odası — strong (legacy/index.html .hero::before) */
  .hero[data-oda="OCAK"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.12) 0%,
      rgba(196, 75, 47, 0.05) 30%,
      rgba(212, 168, 85, 0.02) 50%,
      transparent 70%
    );
  }

  /* Diğer 5 oda — soft (legacy/acik-kapi.html .hero::before) */
  .hero[data-oda="Yol"] .hero__glow,
  .hero[data-oda="Buluşmalar"] .hero__glow,
  .hero[data-oda="Yolculuk"] .hero__glow,
  .hero[data-oda="Biz"] .hero__glow,
  .hero[data-oda="İletişim"] .hero__glow {
    background: radial-gradient(
      ellipse at center,
      rgba(196, 75, 47, 0.10) 0%,
      rgba(196, 75, 47, 0.04) 30%,
      rgba(212, 168, 85, 0.02) 50%,
      transparent 70%
    );
  }

  /* === CONTENT LAYOUT === */

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  /* === TYPOGRAPHY (semantik fluid token'lar, KARAR 102 sapma 4) === */

  .hero__overline {
    /* .ocak-overline class'ı zaten global.css'te tanımlı */
    color: var(--ember);
  }

  .hero__title {
    font-family: var(--font-display);
    font-style: italic;          /* #24 Brief 2 Sürpriz #4 — legacy <em>söndü?</em> partial italic → full italic (KARAR 105 Hero pattern) */
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.1;
    color: var(--cream);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-size: var(--text-manifesto);
    font-style: italic;
    color: var(--cream-soft);
    margin: 0;
    max-width: 32ch;
  }

  .hero__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--cream);
    background: transparent;
    border: 1px solid var(--ember);
    border-radius: 2px;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--ember);
    color: var(--coal);
  }

  /* === SCROLL INDICATOR (brief-hero-gecis.md ADIM 2: pulse → akış) === */
  /* Çizgi geometrisi verbatim (1px×40px, smoke→transparent). Animasyon değişti:
   * yukarıdan doğar, aşağı uzar, aşağıda söner, başa döner. Ok/akış hissi. */

  .hero__scroll {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--smoke), transparent);
    transform-origin: top;
    animation: scrollAkis 2s ease-out infinite;
  }

  @keyframes scrollAkis {
    0%   { transform: scaleY(0);    opacity: 0;    }
    20%  { transform: scaleY(0.35); opacity: 1;    }
    70%  { transform: scaleY(1);    opacity: 0.85; }
    100% { transform: scaleY(1);    opacity: 0;    }
  }

  /* === STAGGERED INTRO (legacy verbatim: 0.3 / 0.6 / 0.9 / 1.2 / 1.8s) === */
  /* fadeUp keyframes global.css'te (Brief 4a) */

  .hero__overline,
  .hero__title,
  .hero__subtitle,
  .hero__cta,
  .hero__scroll {
    opacity: 0;
    animation: fadeUp 0.9s ease both;
  }

  .hero__overline { animation-delay: 0.3s; }
  .hero__title    { animation-delay: 0.6s; }
  .hero__subtitle { animation-delay: 0.9s; }
  .hero__cta      { animation-delay: 1.2s; }
  .hero__scroll   { animation-delay: 1.8s; }

  /* === ACCESSIBILITY === */

  @media (prefers-reduced-motion: reduce) {
    .hero__overline,
    .hero__title,
    .hero__subtitle,
    .hero__cta,
    .hero__scroll {
      opacity: 1;
      animation: none;
    }
    .hero__scroll-line {
      animation: none;
      /* Statik + tam boy + sabit opacity — akış animasyonunun "durgun" hali. */
      transform: scaleY(1);
      opacity: 0.5;
    }
  }

  /* === RESPONSIVE === */

  @media (max-width: 768px) {
    .hero__content { gap: var(--space-4); }
    .hero__scroll { bottom: var(--space-4); }
  }
</style>
