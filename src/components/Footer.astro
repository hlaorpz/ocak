---
// WhatsApp linki tek kaynak: src/lib/api.ts → WHATSAPP_URL. Eski hatalı format
// (05325555226) yerine wa.me/15551911472 — numara değişirse api.ts tek yer.
import { WHATSAPP_URL } from '../lib/api';

const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="footer__head">Yol</h2>
        <ul>
          <li><a href="/sen-neredesin">Sen Neredesin?</a></li>
          <li><a href="/bulusmalar">Buluşmalar</a></li>
          <li><a href="/yolculuk">Yolculuk</a></li>
          <li><a href="/takvim">Takvim</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__head">Ocak</h2>
        <ul>
          <li><a href="/hikaye">Hikâye</a></li>
          <li><a href="/felsefe">Felsefe</a></li>
          <li><a href="/araclar">Araçlar</a></li>
          <li><a href="/biz">Biz</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__head">Temas</h2>
        <ul>
          <li><a href="/iletisim">İletişim</a></li>
          <li>
            <a href="https://instagram.com/ocak.biz" target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          </li>
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="footer__manifesto">
      <span class="footer__manifesto-line">Seni bize bağımlı yapmak için değil,</span>
      <span class="footer__manifesto-line footer__manifesto-line--break">seni sana geri vermek için buradayız.</span>
    </p>

    {/* Aşama 5 düzeltme (KARAR 251 + 257 aday): yasal linkler artık
        baseline satırının ORTASINDA (sol OCAK ↔ orta yasal ↔ sağ © yıl).
        Manifesto altı eski yasal satır kaldırıldı; tek baseline satırı.
        Mobilde 3 öğe sığmazsa yasal alt satıra wrap'ler (OCAK+© üstte). */}
    <div class="footer__bottom">
      <span class="footer__brand">OCAK</span>
      <nav class="footer__yasal" aria-label="Yasal">
        <a href="/hakkimizda">Hakkımızda</a>
        <span class="footer__yasal-ayrac" aria-hidden="true">·</span>
        <a href="/gizlilik">Gizlilik ve KVKK</a>
        <span class="footer__yasal-ayrac" aria-hidden="true">·</span>
        <a href="/mesafeli-satis">Mesafeli Satış</a>
        <span class="footer__yasal-ayrac" aria-hidden="true">·</span>
        <a href="/teslimat-iade">Teslimat ve İade</a>
      </nav>
      <span class="footer__year">© {year}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-9) var(--space-5) var(--space-6);
    background: linear-gradient(
      180deg,
      var(--coal) 0%,
      color-mix(in oklab, var(--coal) 92%, black) 100%
    );
    position: relative;
    z-index: var(--z-content);
  }

  .footer__inner {
    max-width: var(--max-w-wide);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-7);
  }

  .footer__head {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: var(--space-4);
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col a {
    color: var(--text-body);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--ember);
  }

  /* Sabit manifesto imzası — her sayfa, sessiz alt-zemin (KARAR 162 footer
   * göçü tersi DEĞİL: manifesto-vurgu sayfa-içi içerik katmanı olarak
   * kalıyor, bu footer cümlesi ayrı bir vaat imzası katmanıdır). Stil
   * disiplini: cream-soft (cream parlak değil), Cormorant italik, küçük
   * punto (manifesto-vurgu 1.35-1.6rem / ic-ses 1.25-1.5rem altı), glyph
   * YOK, glow YOK — sayfa-içi vurgu paletinden ayrı tutulur. */
  .footer__manifesto {
    margin: 0 auto;
    max-width: 56rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
    line-height: 1.6;
    color: var(--cream-soft);
  }

  .footer__manifesto-line {
    white-space: nowrap;
  }

  /* Mobil: virgülden sonra alt satıra. Konteyner text-align: center miras
   * — block parça da ortalı kalır, sola yaslanmaz. */
  @media (max-width: 600px) {
    .footer__manifesto-line--break {
      display: block;
    }
  }

  /* ≤360px: parça 2 nowrap'i kaldır, doğal sarmaya izin ver — yatay scroll yok. */
  @media (max-width: 360px) {
    .footer__manifesto-line {
      white-space: normal;
    }
  }

  /* Aşama 5 düzeltme (KARAR 251 + 257 aday): footer yasal linkleri
   * baseline satırının ORTASINDA. Sol OCAK ↔ orta yasal ↔ sağ © yıl.
   * Grid 3-kolon: yasal `1fr` ortada, brand/year `auto`. Yasal font ©
   * yıl ölçeğine yakın (text-xs), nötr ton; ember değil — dikkat
   * çekmemeli. Mobilde (≤600px) 3 öğe sığmazsa yasal alt satıra
   * wrap'ler (OCAK+© üstte yan yana, yasal altta ortalı). */
  .footer__yasal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: 0;
    padding: 0;
  }

  .footer__yasal a {
    color: var(--text-muted);
    letter-spacing: var(--tracking-wide);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__yasal a:hover,
  .footer__yasal a:focus-visible {
    color: var(--cream-soft);
    outline: none;
  }

  .footer__yasal-ayrac {
    color: var(--text-muted);
    opacity: 0.6;
    user-select: none;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  .footer__bottom .footer__yasal {
    justify-self: center;
  }

  /* Mobil: 3 öğe baseline'da sığmaz — OCAK+© üstte yan yana, yasal alt
   * satıra wrap. iPhone Safari + Chrome eyeball şart (KARAR 88). */
  @media (max-width: 600px) {
    .footer__bottom {
      grid-template-columns: auto auto;
      grid-template-areas:
        'brand year'
        'yasal yasal';
      justify-content: space-between;
      row-gap: var(--space-4);
    }
    .footer__brand { grid-area: brand; }
    .footer__year { grid-area: year; }
    .footer__bottom .footer__yasal {
      grid-area: yasal;
      justify-self: center;
    }
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    letter-spacing: var(--tracking-wide);
  }

  .footer__year {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: var(--tracking-wide);
  }
</style>
