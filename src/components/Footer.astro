---
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="footer__head">Yol</h2>
        <ul>
          <li><a href="/sen-neredesin">Sen Neredesin?</a></li>
          <li><a href="/bulusmalar">Buluşmalar</a></li>
          <li><a href="/yolculuk">Yolculuk</a></li>
          <li><a href="/takvim">Takvim</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__head">Ocak</h2>
        <ul>
          <li><a href="/hikaye">Hikâye</a></li>
          <li><a href="/felsefe">Felsefe</a></li>
          <li><a href="/araclar">Araçlar</a></li>
          <li><a href="/biz">Biz</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__head">Temas</h2>
        <ul>
          <li><a href="mailto:selam@ocak.biz">selam@ocak.biz</a></li>
          <li>
            <a href="https://instagram.com/ocak.biz" target="_blank" rel="noopener noreferrer">
              @ocak.biz
            </a>
          </li>
          <li><a href="/iletisim">İletişim</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__brand">OCAK</span>
      <span class="footer__year">© {year}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-9) var(--space-5) var(--space-6);
    background: linear-gradient(
      180deg,
      var(--coal) 0%,
      color-mix(in oklab, var(--coal) 92%, black) 100%
    );
    position: relative;
    z-index: var(--z-content);
  }

  .footer__inner {
    max-width: var(--max-w-wide);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-7);
  }

  .footer__head {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: var(--space-4);
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col a {
    color: var(--text-body);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--ember);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    letter-spacing: var(--tracking-wide);
  }

  .footer__year {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: var(--tracking-wide);
  }
</style>
