---
// AnadoluHarita — /anadolu sayfasındaki sabit Türkiye haritası (brief-anadolu-yolculuk.md).
//
// Yapı:
//   - Türkiye sınırı: Natural Earth → Douglas-Peucker → Mercator viewBox 1000×420
//     (anadolu-harita-data.ts; üretim scripts/build-anadolu-harita.mjs). 3 ring:
//     Anadolu ana kütlesi (~428 pt), Trakya/Avrupa yakası (~61 pt), kuzey Ege adacığı.
//   - 6 evre noktası: gerçek lat/lng → aynı projeksiyon ile viewBox koordinatına
//     çevrildi (build-time, harita-data'ya gömülü değil; sabit nokta listesi burada).
//     brief-anadolu-gorsel-guclendirme.md: nokta dot r=9 (görsel güç), merkezde
//     kronolojik sıra numarası (1-6, coal fill — ısı rengi üzerinde okunur).
//   - Yolculuk hattı KALDIRILDI (brief-anadolu-gorsel-guclendirme.md Madde 1):
//     kronolojik sıra coğrafi olarak zigzag ürettiği için "karışık ağ" hissi
//     veriyordu. Sıra artık nokta merkezindeki numaralarla görselleştirilir.
//   - Etiketler: evre adı (serif italik, ısı renginde) + yer adı (küçük, smoke).
//     DURUŞ üstte, DÖNÜŞ sağda (Tuz Gölü ↔ Kapadokya çakışmasını eler).
//
// Etkileşim: nokta tıklanınca kart id="evre-NAME"'e scroll + vurgu (client JS).
// SEO: SVG <title>/<desc> + her noktada <title> tooltip + etiketlerde gerçek metin.
//
// Stil: atmosfer.css `.anadolu-harita` ailesi (sınır color = --ash, noktalar/hat ısı,
// etiket --cream / --smoke). prefers-reduced-motion respect.
import { TURKEY_VIEWBOX, TURKEY_PATHS } from './anadolu-harita-data';

// Evre noktaları — gerçek lat/lng (brief), build-anadolu-harita.mjs projeksiyonu
// ile birebir aynı dönüşümden geçti. Konum bu satırlarda sabit; harita-data.ts
// regenerate edilirse buradaki x/y'ler de güncellenmeli (manuel sync).
type Evre = {
  slug: string;        // 'acilis' (kart id'siyle eşli: evre-acilis)
  ad: string;          // 'AÇILIŞ' — etiket
  yer: string;         // 'Ege (Urla)' — alt etiket
  x: number; y: number;
  isiToken: string;    // tokens.css --isi-*
  // Etiket konum: nokta merkezinden ofset (dx, dy), text-anchor
  labelDx: number; labelDy: number; labelAnchor: 'start' | 'middle' | 'end';
};

// brief-anadolu-rotus.md Madde 3: dot r=9'a büyüdüğünde halka r=20 → etiket
// yazısı halkayla çakışıyordu. Dikey offset 26 → 32 (halka altında 12px nefes),
// DURUŞ üst -14 → -20 (halka üstünde 6px nefes), DÖNÜŞ yatay dx 12 → 24
// (halka yanında 4px nefes).
const evreler: Evre[] = [
  // brief-anadolu-mobil-serit.md ADIM 3.1: kıyıya çok yakın (denize düşüyor
  // hissi), x hafif içeri (64 → 76) — nefes alsın.
  { slug: 'acilis', ad: 'AÇILIŞ', yer: 'Ege',
    x: 76.0, y: 258.2, isiToken: '--isi-acilis',
    labelDx: 0, labelDy: 32, labelAnchor: 'middle' },
  { slug: 'inis', ad: 'İNİŞ', yer: 'Göbeklitepe · Harran',
    x: 681.2, y: 322.0, isiToken: '--isi-inis',
    labelDx: 0, labelDy: 32, labelAnchor: 'middle' },
  { slug: 'uyanis', ad: 'UYANIŞ', yer: 'Aphrodisias · Pamukkale',
    x: 183.8, y: 281.5, isiToken: '--isi-uyanis',
    labelDx: 0, labelDy: 32, labelAnchor: 'middle' },
  // DURUŞ: Tuz Gölü → etiket ÜSTTE (DÖNÜŞ ve Kapadokya yakın, çakışma elemi).
  // Etiket-yer y=14 offset ile ad'ın ALTINDA olduğu için üst konumda "Tuz Gölü"
  // nokta merkezine yaklaşır; halka r=20 içinde çakışıyordu. labelDy tüm etiket
  // blok'unu 20px daha yukarı iter → yer.bottom halka.top'un üstünde kalır.
  { slug: 'durus', ad: 'DURUŞ', yer: 'Tuz Gölü',
    x: 399.5, y: 234.7, isiToken: '--isi-durus',
    labelDx: 0, labelDy: -40, labelAnchor: 'middle' },
  { slug: 'gecis', ad: 'GEÇİŞ', yer: 'Yanartaş · Myra',
    x: 252.3, y: 367.3, isiToken: '--isi-gecis',
    labelDx: 0, labelDy: 32, labelAnchor: 'middle' },
  // DÖNÜŞ: Kapadokya → etiket SAĞDA (DURUŞ üstte olduğu için aşağı serbest ama
  // brief: text-anchor:start sağa kaydır → daha temiz blok).
  // brief-anadolu-mobil-serit.md ADIM 3.2: DURUŞ ile orta bölgede sıkışıklık —
  // etiketi biraz daha sağa (dx 24 → 32) ve hafif aşağı (dy 5 → 14) it.
  { slug: 'donus', ad: 'DÖNÜŞ', yer: 'Konya · Kapadokya',
    x: 473.6, y: 239.4, isiToken: '--isi-donus',
    labelDx: 32, labelDy: 14, labelAnchor: 'start' },
];

---
<section class="anadolu-harita" aria-labelledby="anadolu-harita-baslik">
  <h2 id="anadolu-harita-baslik" class="anadolu-harita__baslik">Yolculuğun Haritası</h2>
  <p class="anadolu-harita__altmetin">Açılış ve beş evre, kronolojik sırada — noktayı seç, evre kartına in.</p>

  {/* brief-anadolu-mobil-serit ADIM 1: mobilde SVG harita gizlenir, yerine
     yatay evre şeridi render edilir (aşağıda). Şerit ve harita AYNI slug'ları
     paylaşır → tek activate() fonksiyonu iki DOM kaynağına delegate eder. */}
  <div class="anadolu-harita__cerceve">
    <svg
      class="anadolu-harita__svg"
      viewBox={TURKEY_VIEWBOX}
      role="img"
      aria-describedby="anadolu-harita-desc"
      preserveAspectRatio="xMidYMid meet"
    >
      <title>Anadolu Yolculuğu — açılış ve beş evrenin Türkiye haritasında konumu</title>
      <desc id="anadolu-harita-desc">
        Türkiye sınırı üzerinde açılış ve beş evre noktası kronolojik sırada:
        AÇILIŞ Ege (Urla), İNİŞ Göbeklitepe ve Harran (Şanlıurfa), UYANIŞ Aphrodisias
        ve Pamukkale (Denizli), DURUŞ Tuz Gölü (Aksaray), GEÇİŞ Yanartaş ve Myra (Antalya),
        DÖNÜŞ Konya ve Kapadokya (İç Anadolu).
      </desc>

      <g class="anadolu-harita__sinir" aria-hidden="true">
        {TURKEY_PATHS.map((d) => <path d={d} />)}
      </g>

      <g class="anadolu-harita__noktalar">
        {evreler.map((e, i) => (
          <g
            class="anadolu-harita__nokta"
            data-evre={e.slug}
            style={`--isi-aktif: var(${e.isiToken});`}
            transform={`translate(${e.x}, ${e.y})`}
          >
            <circle class="anadolu-harita__nokta-halka" r="20" aria-hidden="true" />
            <circle class="anadolu-harita__nokta-dot" r="9" />
            {/* Kronolojik sıra numarası: AÇILIŞ=0 (kuruluş, eşik öncesi),
                İNİŞ-DÖNÜŞ=1-5 (beş gerçek dönüşüm eşiği). Arketip yayıyla
                tutarlı (KARAR: Anadolu evre numaralandırma 0-5, sealed). */}
            <text class="anadolu-harita__nokta-numara" aria-hidden="true">{i}</text>
            <title>{i}. {e.ad} — {e.yer}</title>
            <g
              class="anadolu-harita__etiket"
              transform={`translate(${e.labelDx}, ${e.labelDy})`}
              text-anchor={e.labelAnchor}
            >
              <text class="anadolu-harita__etiket-ad" y="0">{e.ad}</text>
              <text class="anadolu-harita__etiket-yer" y="14">{e.yer}</text>
            </g>
          </g>
        ))}
      </g>
    </svg>
  </div>

  {/* Mobil evre şeridi — masaüstünde CSS ile gizli, mobilde SVG yerine görünür.
     Etiket: sadece evre adı (Kaan onayı: 6 durak 360px'de sığar, yer adı kart
     başlığında zaten var, tekrar edilmez). Aktif durakta yer adı gösterme brief
     Kaan kararı olarak eklendi ama "sığmazsa atla" istisnası ile ADIM 2 sonrası
     ATLANDI (18-22 kar uzun yer adları 360px slot'a sığmaz, absolute çözüm
     kenarda taşar). Aktif vurgu sadece dot ölçek + evre adı rengi ile. */}
  <nav class="anadolu-serit" aria-label="Evre şeridi — hızlı navigasyon">
    {evreler.map((e, i) => (
      <button
        class="anadolu-serit__durak"
        type="button"
        data-evre={e.slug}
        style={`--isi-aktif: var(${e.isiToken});`}
        aria-label={`${e.ad} — ${e.yer} kartına git`}
      >
        <span class="anadolu-serit__dot" aria-hidden="true">{i}</span>
        <span class="anadolu-serit__ad" aria-hidden="true">{e.ad}</span>
      </button>
    ))}
  </nav>
</section>

<script>
  // Harita ↔ kart bağı (brief-anadolu-yolculuk.md): nokta tıklanınca ilgili evre
  // kartına smooth scroll + geçici vurgu (border ısı + box-shadow). ESIK paterni
  // sade JS — Astro client island değil, basit DOMContentLoaded.
  //
  // brief-anadolu-mobil-serit ADIM 1: aynı activate() iki DOM kaynağını serve
  // eder — masaüstü SVG noktaları + mobil şerit butonları. Aynı slug, aynı
  // kart, aynı scroll mekanizması (yeni scroll yolu kurma).
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const activate = (slug: string | undefined) => {
    if (!slug) return;
    const kart = document.getElementById(`evre-${slug}`);
    if (!kart) return;
    kart.scrollIntoView({
      behavior: reducedMotion ? 'auto' : 'smooth',
      // brief v2 Bug 2: nav'ın HEMEN altına hizalansın (önce 'center' idi,
      // kartı ekran ortasına itiyordu). 'start' + CSS scroll-margin-top
      // var(--nav-height) ile kart nav'ın arkasına kaymaz.
      block: 'start',
    });
    // Vurgu — CSS class 1.6s sonra düşer (CSS animasyonu kendi temizler)
    kart.classList.remove('ocak-evre--vurgu');
    // reflow tetikle ki re-add animasyonu sıfırdan başlasın
    void (kart as HTMLElement).offsetWidth;
    kart.classList.add('ocak-evre--vurgu');
  };

  // Masaüstü: SVG noktalar (role=button + keyboard)
  const noktalar = document.querySelectorAll<SVGGElement>('.anadolu-harita__nokta');
  noktalar.forEach((nokta) => {
    nokta.style.cursor = 'pointer';
    nokta.setAttribute('role', 'button');
    nokta.setAttribute('tabindex', '0');
    const slug = nokta.dataset.evre;
    const label = nokta.querySelector('title')?.textContent ?? slug ?? '';
    nokta.setAttribute('aria-label', `${label} kartına git`);

    nokta.addEventListener('click', () => activate(slug));
    nokta.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activate(slug);
      }
    });
  });

  // Mobil: şerit butonları (native <button> click + keyboard semantiği)
  const duraklar = document.querySelectorAll<HTMLButtonElement>('.anadolu-serit__durak');
  duraklar.forEach((durak) => {
    durak.addEventListener('click', () => activate(durak.dataset.evre));
  });

  // brief-anadolu-mobil-serit ADIM 2: aktif evre vurgusu — IntersectionObserver
  // ile alttaki .ocak-evre kartlarından viewport ortasında olan aktif kabul
  // edilir. Aktif slug hem masaüstü SVG noktasına (.anadolu-harita__nokta) hem
  // mobil şerit durağına (.anadolu-serit__durak) .is-active class'ı ekler.
  // Tek observer, iki DOM. Kullanıcı "3/5'teyim" hissini alır.
  const kartlar = document.querySelectorAll<HTMLElement>('.ocak-evre[data-evre]');
  if ('IntersectionObserver' in window && kartlar.length > 0) {
    const setActive = (slug: string | null) => {
      document.querySelectorAll('.anadolu-harita__nokta.is-active, .anadolu-serit__durak.is-active')
        .forEach((el) => el.classList.remove('is-active'));
      if (!slug) return;
      document.querySelectorAll(
        `.anadolu-harita__nokta[data-evre="${slug}"], .anadolu-serit__durak[data-evre="${slug}"]`
      ).forEach((el) => el.classList.add('is-active'));
    };

    let aktifSlug: string | null = null;
    const gorunur = new Map<string, number>(); // slug → intersectionRatio

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = (entry.target as HTMLElement).dataset.evre;
          if (!slug) return;
          if (entry.isIntersecting) {
            gorunur.set(slug, entry.intersectionRatio);
          } else {
            gorunur.delete(slug);
          }
        });
        // En yüksek ratio'lu kart aktif
        let enIyiSlug: string | null = null;
        let enIyiRatio = 0;
        for (const [slug, ratio] of gorunur) {
          if (ratio > enIyiRatio) {
            enIyiSlug = slug;
            enIyiRatio = ratio;
          }
        }
        if (enIyiSlug !== aktifSlug) {
          aktifSlug = enIyiSlug;
          setActive(aktifSlug);
        }
      },
      {
        // Kart viewport'un merkez bandına girdiğinde aktif — nav altı için
        // üstten %30, alttan %40 ofset (kart merkezi ekran ortasına yakın
        // olduğunda seçilir, scroll sırasında kararlı geçiş).
        rootMargin: '-30% 0px -40% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      },
    );

    kartlar.forEach((kart) => observer.observe(kart));
  }
</script>
