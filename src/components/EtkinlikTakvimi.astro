---
// EtkinlikTakvimi — /takvim ay-ay timeline (#26 Brief H Adım 2; #35 kompakt + tür filtresi).
// SonrakiBulusma kardeşi: aynı 'etkinlikler' collection, farklı render.
// SonrakiBulusma: ana sayfa + 4 buluşma sayfasında "ilk N yaklaşan" kart grid.
// EtkinlikTakvimi: /takvim'de tüm gelecek etkinlikler ay-ay başlık altında.
//
// brief-etkinlikkart-home Madde A: satır GÖVDESİ tamamen EtkinlikKart component
// içine indi (chip/rozet/başlık/meta + sol tarih rozeti + öne-çıkan ember çizgi
// + /etkinlik/{slug} stretched-link + "Kayıt ol →"). Burada kalan: ay grubu
// scaffolding'i, tür filtresi şeridi, sticky ay başlığı, <li>'de data-tip
// (client filter) ve <ul> alt-çizgi ritmi.
//
// brief-etkinlik-detay-route.md FAZ 1: content/config.ts publish filtresi
// gevşedi (siteGoster && durum !== 'İptal'). Bu component durum ∈
// {Kayıt Açık, Dolu} + bugündenSonra süzgeçlerini kendi uyguluyor.
import { getCollection } from 'astro:content';
import {
  bugundenSonra,
  groupByMonth,
  formatAyEtiketi,
} from '../lib/format-etkinlik';
import {
  formatEtiket,
  KATEGORI_SIRA,
  BOS_STATE_HEP_HTML,
  BOS_STATE_KAPI_HTML,
} from '../lib/etkinlik-kategori';
import EtkinlikListe from './EtkinlikListe.astro';

const AKTIF_DURUM = new Set(['Kayıt Açık', 'Dolu']);
const tum = (await getCollection('etkinlikler'))
  .map((e) => e.data)
  .filter((e) => AKTIF_DURUM.has(e.durum));
const gelecekler = bugundenSonra(tum).sort((a, b) => {
  // Kronolojik (tarihBaslangic ASC) — oneCikar sticky değil, normal sırada.
  if (a.tarihBaslangic !== b.tarihBaslangic) return a.tarihBaslangic.localeCompare(b.tarihBaslangic);
  return a.baslik.localeCompare(b.baslik, 'tr');
});
const aylar = groupByMonth(gelecekler);

// Tür düğmeleri — Notion'daki tip değerlerinden dinamik. Sıra KATEGORI_SIRA'dan
// deterministik. Tek tür varsa şerit gösterilmez.
const turler = [...new Set(gelecekler.map((e) => e.tip).filter(Boolean))].sort((a, b) => {
  const ia = KATEGORI_SIRA.indexOf(a);
  const ib = KATEGORI_SIRA.indexOf(b);
  if (ia === -1) console.warn('[takvim] KATEGORI_SIRA dışı tür:', a);
  return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
});
---
<section data-section="etkinlik-takvimi" class="ocak-etkinlik-takvimi">
  {aylar.size === 0 ? (
    <p class="ocak-etkinlik-takvimi__bos" set:html={BOS_STATE_HEP_HTML} />
  ) : (
    <>
      {turler.length > 1 && (
        <div class="ocak-etkinlik-takvimi__filtre" role="group" aria-label="Türe göre süz">
          <button type="button" class="ocak-etkinlik-takvimi__tur is-aktif" data-tur="*" aria-pressed="true">
            Tümü
          </button>
          {turler.map((tur) => (
            <button type="button" class="ocak-etkinlik-takvimi__tur" data-tur={tur} aria-pressed="false">
              {formatEtiket(tur)}
            </button>
          ))}
        </div>
      )}
      {[...aylar.entries()].map(([key, etkinlikler]) => (
      <>
        <h2
          class="ocak-etkinlik-takvimi__ay-baslik"
          id={`ay-${key}`}
          data-ay-key={key}
        >{formatAyEtiketi(key)}</h2>
        <EtkinlikListe etkinlikler={etkinlikler} ayKey={key} />
      </>
      ))}
      <p class="ocak-etkinlik-takvimi__bos ocak-etkinlik-takvimi__bos--filtre" hidden set:html={BOS_STATE_KAPI_HTML} />
    </>
  )}
</section>

<script>
  // Tür filtresi — client-side, sayfa yenilenmeden. data-tip eşleşmeyen <li>'ler
  // + içi tamamen boşalan ay grupları gizlenir. "Tümü" (data-tur="*") sıfırlar.
  import { slugToFormatHam } from '../lib/etkinlik-kategori';

  const koklar = document.querySelectorAll<HTMLElement>('.ocak-etkinlik-takvimi');
  koklar.forEach((kok) => {
    const dugmeler = kok.querySelectorAll<HTMLButtonElement>('.ocak-etkinlik-takvimi__tur');
    if (dugmeler.length === 0) return;
    const satirlar = kok.querySelectorAll<HTMLElement>('.ocak-etkinlik-liste__satir');
    const listeler = kok.querySelectorAll<HTMLUListElement>('ul.ocak-etkinlik-liste[data-ay-key]');
    const bosFiltre = kok.querySelector<HTMLElement>('.ocak-etkinlik-takvimi__bos--filtre');

    function uygula(secilen: string) {
      let gorunenToplam = 0;
      satirlar.forEach((satir) => {
        const eslesti = secilen === '*' || satir.dataset.tip === secilen;
        satir.hidden = !eslesti;
        if (eslesti) gorunenToplam++;
      });
      listeler.forEach((liste) => {
        const acik = liste.querySelector('.ocak-etkinlik-liste__satir:not([hidden])');
        const key = liste.dataset.ayKey ?? '';
        const baslik = kok.querySelector<HTMLElement>(`h2.ocak-etkinlik-takvimi__ay-baslik[data-ay-key="${key}"]`);
        liste.hidden = !acik;
        if (baslik) baslik.hidden = !acik;
      });
      if (bosFiltre) bosFiltre.hidden = gorunenToplam > 0;
    }

    dugmeler.forEach((dugme) => {
      dugme.addEventListener('click', () => {
        dugmeler.forEach((d) => {
          const aktif = d === dugme;
          d.classList.toggle('is-aktif', aktif);
          d.setAttribute('aria-pressed', String(aktif));
        });
        uygula(dugme.dataset.tur ?? '*');
      });
    });
  });

  // Load-time hash filtre: /takvim#<slug> → slugToFormatHam(slug) →
  // data-tur="<ham>" tab'ına programatik click. Filtre mantığı, aktif-tab
  // görseli ve aria state mevcut handler'dan akar (idempotent). Hash okuma +
  // slug çözümü forEach DIŞINDA bir kez; buton araması tek geçiş. hashchange
  // KAPSAM DIŞI — yalnız load-time (brief kararı).
  const hashSlug = location.hash.slice(1);
  const hashHam = hashSlug ? slugToFormatHam(hashSlug) : null;
  if (hashSlug && hashHam) {
    const hedef = document.querySelector<HTMLButtonElement>(
      `.ocak-etkinlik-takvimi__tur[data-tur="${hashHam}"]`,
    );
    if (hedef) {
      hedef.click();
    } else {
      // Slug geçerli ama sayfada o türün tab'ı yok (o dönem etkinliği yok).
      // eslint-disable-next-line no-console
      console.warn(`[takvim] hash türü sayfada yok: ${hashSlug}`);
    }
  }
  // hashSlug var + hashHam null (bilinmeyen slug) → sessiz, default Tümü kalır.
</script>

<style>
  /* --- TÜR FİLTRESİ ŞERİDİ (#35) --- */
  .ocak-etkinlik-takvimi__filtre {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    max-width: 64rem;
    margin: 0 auto var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--ash);
  }

  .ocak-etkinlik-takvimi__tur {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--cream-soft);
    background: var(--ash);
    border: 1px solid transparent;
    padding: 0.5em 1.1em;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .ocak-etkinlik-takvimi__tur:hover,
  .ocak-etkinlik-takvimi__tur:focus-visible {
    color: var(--cream);
    border-color: var(--ember);
  }

  .ocak-etkinlik-takvimi__tur.is-aktif {
    color: var(--coal);
    background: var(--ember);
    border-color: var(--ember);
  }

  @media (max-width: 600px) {
    .ocak-etkinlik-takvimi__filtre {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
    }
    .ocak-etkinlik-takvimi__tur {
      flex-shrink: 0;
    }
  }

  /* --- AY BAŞLIĞI + STICKY DEVİR --- */
  .ocak-etkinlik-takvimi__ay-baslik {
    position: sticky;
    top: var(--nav-height, 64px);
    z-index: 5;
    background: var(--coal);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--ember);
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-4) 0;
    scroll-margin-top: var(--nav-height, 64px);
  }

  .ocak-etkinlik-takvimi__ay-baslik[hidden] {
    display: none;
  }

  /* KOMPAKT SATIR LİSTESİ: EtkinlikListe component (ortak kabuk) tarafından
   * render ediliyor — brief-tani-tek-kabuk Yol B. Buradaki __liste + __satir
   * CSS'i EtkinlikListe scoped'e taşındı; sınıflar .ocak-etkinlik-liste* oldu.
   * Client tür filtresi selector'ları da güncellendi. */

  /* Boş state — italik + ortalı, smoke ton. */
  .ocak-etkinlik-takvimi__bos {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--smoke);
    text-align: center;
    padding: var(--space-9) var(--space-5);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--leading-prose);
  }

  .ocak-etkinlik-takvimi__bos--filtre {
    padding: var(--space-8) var(--space-5);
  }

  .ocak-etkinlik-takvimi__bos[hidden] {
    display: none;
  }

  .ocak-etkinlik-takvimi__bos a {
    color: var(--ember);
  }
</style>
