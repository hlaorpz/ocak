---
// BirSonraki — statik callout pattern (KARAR 87, 92, 93)
// Sayfanın altında "bir sonraki kapı" işaret eden italik blockquote
// Plugin section etiketi: ## section: bir-sonraki
// Atmosfer: ember sol border + ember-tinted background + krem italik metin

interface Props {
  text: string;        // ana cümle (italik, ana metin)
  linkText?: string;   // opsiyonel link metni (cümlenin sonunda)
  linkHref?: string;   // opsiyonel link hedefi
}

const { text, linkText, linkHref } = Astro.props;
---
<section class="bir-sonraki" data-section="bir-sonraki">
  <div class="ocak-container ocak-container--prose">
    <blockquote class="bir-sonraki__quote">
      <p class="bir-sonraki__text"><em>{text}</em></p>
      {linkText && linkHref && (
        <a class="bir-sonraki__link" href={linkHref}>{linkText} →</a>
      )}
    </blockquote>
  </div>
</section>

<style>
  .bir-sonraki {
    padding: var(--space-8) 0;
  }

  .bir-sonraki__quote {
    position: relative;
    margin: 0;
    padding: var(--space-5) var(--space-6);
    background: var(--ember-alpha-15);
    border-left: 3px solid var(--ember);
    border-radius: 0 2px 2px 0;
  }

  .bir-sonraki__text {
    font-family: var(--font-display);
    font-size: var(--text-manifesto);
    color: var(--cream);
    line-height: 1.5;
    margin: 0;
  }

  .bir-sonraki__link {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--ember);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .bir-sonraki__link:hover,
  .bir-sonraki__link:focus-visible {
    border-bottom-color: var(--ember);
  }

  @media (max-width: 768px) {
    .bir-sonraki__quote {
      padding: var(--space-4) var(--space-5);
    }
  }
</style>
