    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    text-align: left;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .kayit-formu__success-odeme dt { color: var(--smoke); }
  .kayit-formu__success-odeme dd {
    margin: 0;
    color: var(--cream);
    word-break: break-all;
  }
  .kayit-formu__success-imza {
