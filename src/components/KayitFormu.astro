    color: var(--smoke);
    font-size: 0.75em;
    font-weight: 400;
    margin-left: 0.4em;
    letter-spacing: 0.02em;
  }

  /* === Aşama 2 — promo input ===============================================
   * Mevcut input baseline + büyük harf hissi (kullanıcı kodları upper-case
   * gireceği için autocapitalize'la birlikte text-transform). */
  .kayit-formu__input--promo {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .kayit-formu__input--promo::placeholder {
    text-transform: none;
    letter-spacing: normal;
  }

  /* === Aşama 2.5 — Kademeli dayanışma fiyatı (Kapı 1) =====================
   * Kademe çerçevesi (üst metin), 3 kademe radio (orta default), tutar
   * vurgulu ember, açıklama smoke; burs köprüsü en altta sönük link. */
  .kayit-formu__kademe-cerceve {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--cream-soft);
  }
  .kayit-formu__radios--kademe {
    gap: var(--space-3);
  }
  .kayit-formu__radio--kademe {
    align-items: flex-start;
    padding: var(--space-4);
  }
  .kayit-formu__radio--kademe .kayit-formu__radio-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 100%;
  }
  .kayit-formu__kademe-baslik {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--cream);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
  }
  .kayit-formu__kademe-baslik strong {
    font-weight: 500;
    color: var(--cream);
  }
  .kayit-formu__kademe-tutar {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ember);
    font-size: 1.05rem;
    font-weight: 400;
    white-space: nowrap;
  }
  .kayit-formu__kademe-aciklama {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--smoke);
    line-height: 1.55;
  }
  .kayit-formu__radio--kademe:has(input:checked) .kayit-formu__kademe-aciklama {
    color: var(--cream-soft);
  }
  .kayit-formu__burs-kopru {
    margin: var(--space-4) 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
  }
  .kayit-formu__burs-kopru a {
    color: var(--smoke);
    text-decoration: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.15);
    padding-bottom: 0.15rem;
    transition: color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
  }
  .kayit-formu__burs-kopru a:hover,
  .kayit-formu__burs-kopru a:focus-visible {
    color: var(--cream);
    border-bottom-color: var(--ember);
  }

  /* === Aşama 3a — promo geri-bildirim mesajı =============================== */
  .kayit-formu__promo-mesaj {
    margin: 0.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--cream-soft);
  }
  .kayit-formu__promo-mesaj[hidden] { display: none; }
  .kayit-formu__promo-mesaj--ok { color: var(--gold); }
  .kayit-formu__promo-mesaj--hata { color: var(--ember); }

  /* === Aşama 2 — canlı tutar bloğu (Katman A + indirim + B + Toplam) =======
   * Mevcut .kayit-formu__odeme-bilgi DL paterninin <ul> kardeşi — KARAR'a
   * göre tutar dökümü liste, ödeme bilgisi DL kalır.
   * Toplam satırı vurgulu (ember rakam); ara satırlar sönük. */
  .kayit-formu__tutar-bloku {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
  }
  .kayit-formu__tutar-satir {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.35rem 0;
    color: var(--cream-soft);
    border-bottom: 1px dashed rgba(196, 75, 47, 0.12);
  }
  .kayit-formu__tutar-satir:last-child { border-bottom: none; }
  .kayit-formu__tutar-satir--indirim { color: var(--gold); }
  .kayit-formu__tutar-satir--katmanB { color: var(--cream-soft); }
  .kayit-formu__tutar-satir--toplam {
    padding-top: 0.7rem;
    margin-top: 0.35rem;
    border-top: 1px solid rgba(196, 75, 47, 0.4);
    border-bottom: none;
    color: var(--cream);
    font-size: 1rem;
  }
  .kayit-formu__tutar-toplam {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ember);
    font-weight: 400;
  }

  /* === Aşama 2 — "Bir kor daha taşı" askı bölümü ===========================
   * Brief: opsiyonel/yumuşak (ember değil, sönük) — "davet, zorlama değil".
   * Ash border, [open]'da da ash kalır (ember vurgu yok). */
  .kayit-formu__grup--aski[open] { border-bottom-color: var(--ash); }
  .kayit-formu__grup--aski > summary {
    color: var(--cream-soft);
  }
  .kayit-formu__grup--aski > summary:hover,
  .kayit-formu__grup--aski > summary:focus-visible {
    color: var(--cream);
  }
  .kayit-formu__grup--aski > summary::after {
    border-color: var(--smoke);
  }
  .kayit-formu__aski-aciklama {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--cream-soft);
  }
  .kayit-formu__aski-tutar-birim {
    color: var(--smoke);
    font-size: 0.85em;
    margin-left: 0.3em;
    font-weight: 400;
  }

  /* === Aşama 3b — Ödeme yöntemi seçimi (kart/havale, Model 1) ==============
   * Tam burs durumunda tutar 0 → odeme bloğu zaten gizli. */
  .kayit-formu__odeme-yontem {
    margin: var(--space-4) 0;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(196, 75, 47, 0.18);
  }
  .kayit-formu__yontem-radios {
    display: flex;
    gap: var(--space-3);
    margin-top: 0.55rem;
    flex-wrap: wrap;
  }
  .kayit-formu__yontem-radio {
    flex: 1 1 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.7rem 0.9rem;
    background: var(--ash);
    border: 1px solid var(--ash);
    cursor: pointer;
    transition: border-color var(--duration-base) var(--ease-out),
                background var(--duration-base) var(--ease-out);
  }
  .kayit-formu__yontem-radio:hover { border-color: var(--smoke); }
  .kayit-formu__yontem-radio input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .kayit-formu__yontem-radio:has(input:checked) {
    border-color: var(--ember);
    background: rgba(196, 75, 47, 0.08);
  }
  .kayit-formu__yontem-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--cream-soft);
  }
  .kayit-formu__yontem-radio:has(input:checked) .kayit-formu__yontem-text {
    color: var(--cream);
  }
  .kayit-formu__odeme-bilgi[hidden] { display: none; }

  /* Mirror (Aşama 2.6 Madde 5) Aşama 3b'de kaldırıldı — Kaan "küçük, kafa
   * karıştırıyor, iki toplam" dedi. Tek toplam üstteki esas blokta. */

  /* === Aşama 2 — askı referans liste (yaklaşan 3 ücretli) ================== */
  .kayit-formu__aski-referans {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ash);
  }
  .kayit-formu__aski-referans-baslik {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--smoke);
    text-transform: uppercase;
  }
  .kayit-formu__aski-referans-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--cream-soft);
    line-height: 1.7;
  }
  .kayit-formu__aski-referans-liste li {
    padding: 0.25rem 0;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
  }
  .kayit-formu__aski-referans-liste li:last-child { border-bottom: none; }

  /* === Aşama 2 — sadece-askı modunda gizlenecek bölümler ==================
   * JS sadece_aski toggle'a göre data-kf-katilim attribute'ünü değiştirir;
   * "katilim=hidden" sınıfı gizler. (class:list yerine attribute selector —
   * KARAR Astro byte-identical riskine girmez.) */
  .kayit-formu__form[data-aski-only='true'] .kayit-formu__group--katilim,
  .kayit-formu__form[data-aski-only='true'] [data-kf-katilim],
  .kayit-formu__form[data-aski-only='true'] [data-kf-askisiz] {
    display: none;
  }

  /* === Aşama 3b-fix — Kayıt Tipi 'Başvuru' bölüm gizleme =====================
   * Etkinlik 'Başvuru' tipinde tüm Direkt-özel bölümler gizli (kademe, askı
   * bölümü, promo, ödeme yöntemi, şehir, kanal, sadece-askı toggle). Form
   * sade kalır: ad/email/telefon + Niyet (etkinlik soruları) + tarih +
   * KVKK + submit. Direkt'te (default) bölümler görünür.
   *
   * Attribute selector — KARAR 88 byte-identical: opsiyonel görsel için
   * class:list yerine attribute. */
  .kayit-formu__form[data-direkt-akis='false'] [data-kf-direkt-only] {
    display: none;
  }

  /* === Mobil === */
  @media (max-width: 480px) {
    .kayit-formu { padding: var(--space-7) var(--space-5); }
    .kayit-formu__grup > summary {
      font-size: var(--text-h4);
      padding: var(--space-4) 0;
    }
    .kayit-formu__grup-icerik { padding: var(--space-2) 0 var(--space-5); }
    .kayit-formu__group { margin-bottom: var(--space-4); }
    .kayit-formu__tutar-toplam { font-size: 1.2rem; }
  }

  /* === A11y === */
  @media (prefers-reduced-motion: reduce) {
    .kayit-formu__grup > summary,
    .kayit-formu__grup > summary::after,
    .kayit-formu__grup,
    .kayit-formu__kvkk-detay summary::after,
    .kayit-formu__radio,
    .kayit-formu__radio-circle,
    .kayit-formu__radio-circle::after,
    .kayit-formu__submit,
    .kayit-formu__input,
    .kayit-formu__textarea,
    .kayit-formu__select,
    .kayit-formu__success {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { submitKayit, type KayitPayload } from '../lib/api';
  import { scrollToSuccess } from '../lib/scroll-to-success';
  import { uygulaIndirim, kademeTutari, type Kademe } from '../lib/kayit';
  import type { KodSonuc } from '../lib/kodlar';

  const form = document.querySelector<HTMLFormElement>('.kayit-formu__form');
  if (form) {
    const section = form.closest<HTMLElement>('.kayit-formu')!;
    const submit = form.querySelector<HTMLButtonElement>('.kayit-formu__submit')!;
    const errorEl = section.querySelector<HTMLElement>('.kayit-formu__error')!;
    const successEl = section.querySelector<HTMLElement>('.kayit-formu__success')!;
    const odemeBlok = form.querySelector<HTMLElement>('.kayit-formu__odeme')!;
    const select = form.querySelector<HTMLSelectElement>('select[name="etkinlik_id"]')!;
    const format = form.dataset.format ?? '';
    const oldText = submit.textContent ?? 'Kaydımı Gönder';

    // Aşama 2 — canlı tutar (Katman A + indirim slot + Katman B + Toplam).
    // İndirim DAİMA 0 (backend yok; Aşama 3'te kodDogrula'dan gelecek + slot
    // açılacak). Üç-dal mantığı (Aşama 3): Yüzde/Sabit indirim A+B'ye uygulanır;
    // Tam burs sadece A sıfırlanır, B aynen kalır. Şimdi tek formül: yeniA =
    // max(0, A − indirim); toplam = yeniA + B. Indirim=0 olduğu için A+B.
    const askiOnlyEl = form.querySelector<HTMLInputElement>('[data-kf-sadece-aski]');
    const askiTutarEl = form.querySelector<HTMLInputElement>('[data-kf-aski-tutar]');
    const askiBolum = section.querySelector<HTMLDetailsElement>('.kayit-formu__grup--aski');
    const indirimSlot = odemeBlok.querySelector<HTMLElement>('[data-kf-indirim-slot]');
    const katmanBSlot = odemeBlok.querySelector<HTMLElement>('[data-kf-katmanB-slot]');

    // Aşama 3b-fix — Kayıt Tipi etkinlik bazlı runtime helper. Seçili
    // etkinliğin data-kayit-tipi'ne bakar; tarih seçilmediyse form'un
    // initial direkt-akis attribute'una düşer (ilk etkinliğe göre render
    // time'da set edilmişti). Direkt ise kademe × ücret + askı + checkout;
    // Başvuru ise sade form (CSS [data-direkt-akis='false'] ile gizleme).
    function direktAktif(): boolean {
      const opt = select.options[select.selectedIndex];
      const tipi = opt?.dataset.kayitTipi;
      if (tipi) return tipi === 'Direkt';
      return form!.dataset.direktAkis !== 'false';
    }

    function seciliKademe(): Kademe {
      const sec = form!.querySelector<HTMLInputElement>('[data-kf-kademe]:checked');
      const v = sec?.value;
      return v === 'ust' || v === 'orta' || v === 'alt' ? v : 'orta';
    }

    function aktifUcret(): { ucret: number; para: string; tarih: string } {
      // Sadece-askı modunda A=0, para birimi default TRY.
      if (askiOnlyEl?.checked) return { ucret: 0, para: 'TRY', tarih: '' };
      const opt = select.options[select.selectedIndex];
      const baseUcret = Number(opt?.dataset.ucret ?? '0') || 0;
      const ucret = direktAktif() ? kademeTutari(baseUcret, seciliKademe()) : baseUcret;
      return {
        ucret,
        para: opt?.dataset.paraBirimi ?? 'TRY',
        tarih: opt?.dataset.tarih ?? '',
      };
    }

    // 3 kademe radio'sunun tutar metnini etkinlik seçimine göre günceller.
    // Etkinlik yoksa "—". Başvuru tipinde no-op (kademe gizli; gereksiz hesap).
    function refreshKademeTutarlari() {
      if (!direktAktif()) return;
      const opt = select.options[select.selectedIndex];
      const base = Number(opt?.dataset.ucret ?? '0') || 0;
      const para = opt?.dataset.paraBirimi ?? 'TRY';
      (['ust', 'orta', 'alt'] as Kademe[]).forEach((k) => {
        const el = form!.querySelector<HTMLElement>(`[data-kf-kademe-tutar="${k}"]`);
        if (!el) return;
        if (base <= 0) {
          el.textContent = '—';
        } else {
          const t = kademeTutari(base, k);
          el.textContent = `${t.toLocaleString('tr-TR')} ${para}`;
        }
      });
    }

    // Aşama 3a — promo durumu (state). Boşsa null; geçerli/geçersiz KodSonuc
    // backend'ten döner ve refreshOdemeBlok'a beslenir.
    let promoSonuc: KodSonuc | null = null;
    const promoInputEl = form.querySelector<HTMLInputElement>('[data-kf-promo]');
    const promoMesajEl = form.querySelector<HTMLElement>('[data-kf-promo-mesaj]');
    const promoKodIdEl = form.querySelector<HTMLInputElement>('[data-kf-promo-kod-id]');

    function refreshOdemeBlok() {
      const { ucret: katmanA, para, tarih } = aktifUcret();
      const katmanB = Math.max(0, Number(askiTutarEl?.value ?? '0') || 0);
      const hesap = uygulaIndirim(katmanA, katmanB, promoSonuc);

      odemeBlok.querySelector('[data-kf-katmanA]')!.textContent = String(katmanA);
      odemeBlok.querySelector('[data-kf-para]')!.textContent = para;
      odemeBlok.querySelector('[data-kf-toplam]')!.textContent = String(hesap.toplam);
      odemeBlok.querySelector('[data-kf-para-toplam]')!.textContent = para;

      // Katman B slot: askı > 0 ise göster.
      if (katmanBSlot) {
        katmanBSlot.hidden = katmanB <= 0;
        const kbEl = odemeBlok.querySelector('[data-kf-katmanB]');
        if (kbEl) kbEl.textContent = String(katmanB);
      }

      // İndirim slot: hesap.indirim > 0 ise göster (Aşama 3a aktif).
      if (indirimSlot) {
        indirimSlot.hidden = hesap.indirim <= 0;
        const indEl = odemeBlok.querySelector('[data-kf-indirim]');
        if (indEl) indEl.textContent = String(hesap.indirim);
      }

      // Havale açıklaması — sadece etkinlik ücreti varsa anlamlı.
      if (katmanA > 0) {
        const aciklamaEl = odemeBlok.querySelector('[data-kf-aciklama]')!;
        aciklamaEl.textContent = `Açıklamaya adını ve "${formatBaslik(format)} – ${tarih}" yaz.`;
      }

      // Bloğu görünür kıl: toplam > 0 (ücret veya askı). Sadece-askı modunda
      // tüm [data-kf-katilim] CSS ile gizli — blok DOM'da ama görünmez,
      // güvenli.
      odemeBlok.hidden = hesap.toplam <= 0;
    }

    // Promo doğrulama — /api/promo-dogrula (Aşama 3a). Debounced input + blur.
    // Sayaç artırımı YOK (kodKullanimArtir Aşama 3b ödeme onayında).
    const PROMO_SEBEP_TR: Record<string, string> = {
      bulunamadi: 'Bu kodu bulamadık.',
      pasif: 'Bu kod artık geçerli değil.',
      'suresi-gecmis': 'Bu kodun süresi dolmuş.',
      'limit-doldu': 'Bu kod kullanım sınırına ulaşmış.',
      'format-disi': 'Bu kod bu buluşmada geçerli değil.',
    };

    function promoMesajGoster(metin: string, tip: 'ok' | 'hata' | 'nort') {
      if (!promoMesajEl) return;
      promoMesajEl.textContent = metin;
      promoMesajEl.hidden = !metin;
      promoMesajEl.classList.toggle('kayit-formu__promo-mesaj--ok', tip === 'ok');
      promoMesajEl.classList.toggle('kayit-formu__promo-mesaj--hata', tip === 'hata');
    }

    // Aşama 2.6 Madde 4 + Aşama 3b Madde 2 — tam-burs ile askı bölümü
    // + yöntem seçimi çakışır (ödeyemeyen aynı anda kor bırakmaya/kart
    // seçmeye davet edilmez, tutarsız). Helper:
    //  - Askı bölümü gizli (input içeriği boşa düşürülmez — vazgeçerse veri kalsın).
    //  - Sadece-askı toggle uncheck (askı modu zaten anlamsız).
    //  - Yöntem grubu gizli; havale otomatik (askı varsa havale için, askı
    //    yoksa toplam=0 zaten odeme bloğu hidden).
    function syncAskiBolumGorunum() {
      const tamBurs = !!(promoSonuc?.gecerli && promoSonuc.tip === 'tam-burs');
      if (askiBolum) askiBolum.hidden = tamBurs;
      if (tamBurs && askiOnlyEl?.checked) {
        askiOnlyEl.checked = false;
        syncAskiOnly();
      }
      const yontemGrup = form!.querySelector<HTMLElement>('[data-kf-yontem-grup]');
      if (yontemGrup) yontemGrup.hidden = tamBurs;
      if (tamBurs) {
        const havaleR = form!.querySelector<HTMLInputElement>(
          '[data-kf-yontem][value="havale"]',
        );
        if (havaleR && !havaleR.checked) {
          havaleR.checked = true;
          // syncYontem henüz tanımlı olmayabilir (üstte hoisting yok); IBAN
          // bloğunu doğrudan açalım — defansif.
          const iban = form!.querySelector<HTMLElement>('[data-kf-iban-bloku]');
          if (iban) iban.hidden = false;
        }
      }
    }

    async function dogrulaPromo() {
      if (!promoInputEl) return;
      const kod = promoInputEl.value.trim().toUpperCase();
      if (!kod) {
        promoSonuc = null;
        if (promoKodIdEl) promoKodIdEl.value = '';
        promoMesajGoster('', 'nort');
        syncAskiBolumGorunum();
        refreshOdemeBlok();
        return;
      }
      const { ucret: katmanA } = aktifUcret();
      const katmanB = Math.max(0, Number(askiTutarEl?.value ?? '0') || 0);
      const aBT = katmanA + katmanB;
      if (aBT <= 0) {
        promoSonuc = null;
        if (promoKodIdEl) promoKodIdEl.value = '';
        promoMesajGoster('Önce bir tarih seç ya da bir tutar yaz.', 'hata');
        refreshOdemeBlok();
        return;
      }
      try {
        const res = await fetch('/api/promo-dogrula', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kod, format, tutar: aBT }),
        });
        const data = (await res.json()) as KodSonuc | { status: string; message?: string };
        if ('gecerli' in data) {
          promoSonuc = data;
          if (data.gecerli) {
            if (promoKodIdEl) promoKodIdEl.value = data.kodId;
            const tipMetin =
              data.tip === 'tam-burs'
                ? 'Tam burs — katılım payı sıfır.'
                : `Geçerli — ${data.indirimTutari} TL indirim.`;
            promoMesajGoster(tipMetin, 'ok');
          } else {
            if (promoKodIdEl) promoKodIdEl.value = '';
            const mesaj = PROMO_SEBEP_TR[data.sebep] ?? 'Kod doğrulanamadı.';
            promoMesajGoster(mesaj, 'hata');
          }
        } else {
          promoSonuc = null;
          if (promoKodIdEl) promoKodIdEl.value = '';
          promoMesajGoster('Doğrulama şu an çalışmıyor.', 'hata');
        }
      } catch {
        promoSonuc = null;
        if (promoKodIdEl) promoKodIdEl.value = '';
        promoMesajGoster('Doğrulama şu an çalışmıyor.', 'hata');
      }
      syncAskiBolumGorunum();
      refreshOdemeBlok();
      syncSubmitMetni();
    }

    // Debounced — input başına 500ms bekle (canlı doğrulama).
    let promoTimer: ReturnType<typeof setTimeout> | null = null;
    function promoYenidenDogrula(delay = 500) {
      if (!promoInputEl?.value.trim()) return;
      if (promoTimer) clearTimeout(promoTimer);
      promoTimer = setTimeout(dogrulaPromo, delay);
    }
    promoInputEl?.addEventListener('input', () => promoYenidenDogrula());
    promoInputEl?.addEventListener('blur', () => {
      if (promoTimer) clearTimeout(promoTimer);
      dogrulaPromo();
    });

    // Aşama 3b-fix — Kayıt Tipi etkinlik bazlı; tarih değişince form.dataset
    // .direktAkis sync edilir (CSS Direkt-only bölümleri gizler/açar), Direkt-
    // only required'lar (kademe) toggle edilir. Şehir ve kanal artık required
    // DEĞİL (Brief eyeball blocker fix — gizli+required tuzağı kalktı).
    // Sadece-askı toggle Başvuru'da auto-reset.
    function syncDirektAkis() {
      const direkt = direktAktif();
      form!.dataset.direktAkis = direkt ? 'true' : 'false';
      const kademeRadios = form!.querySelectorAll<HTMLInputElement>('[data-kf-kademe]');
      kademeRadios.forEach((r) => {
        if (direkt) r.setAttribute('required', '');
        else r.removeAttribute('required');
      });
      // Sadece-askı toggle'ı Başvuru'da göstermenin anlamı yok (askı = burs
      // havuzu = Direkt akışta katkı). Başvuru'da uncheck + reset.
      if (!direkt && askiOnlyEl?.checked) {
        askiOnlyEl.checked = false;
        syncAskiOnly();
      }
    }

    select.addEventListener('change', () => {
      syncDirektAkis();
      refreshKademeTutarlari();
      refreshOdemeBlok();
      promoYenidenDogrula(0); // tutar değişti → promo'yu hemen yeniden doğrula
      syncSubmitMetni();
    });
    askiTutarEl?.addEventListener('input', () => {
      refreshOdemeBlok();
      promoYenidenDogrula();
    });
    // Aşama 2.5 — kademe radio change: katmanA değişti, canlı tutar + promo yenile.
    form!
      .querySelectorAll<HTMLInputElement>('[data-kf-kademe]')
      .forEach((r) =>
        r.addEventListener('change', () => {
          refreshOdemeBlok();
          promoYenidenDogrula(0);
        }),
      );

    // Sadece-askı toggle — form data-aski-only attribute'u CSS gizler.
    // required attribute'larını temizle (etkinlik/ekonomik form-validation'a
    // takılmasın). Askı bölümünü auto-aç + tutar input'unu required yap.
    // Submit handler aşağıda mod'a göre erken döner.
    function syncAskiOnly() {
      const aski = !!askiOnlyEl?.checked;
      form!.dataset.askiOnly = aski ? 'true' : 'false';
      // Zorunluluk yönetimi — Aşama 3b-fix: sadece-askı'da telefon/şehir/
      // kanal/kademe/etkinlik required değil (Sen bölümünde sadece ad/email).
      const etkSel = form!.querySelector<HTMLSelectElement>('select[name="etkinlik_id"]');
      const telefonEl = form!.querySelector<HTMLInputElement>('input[name="telefon"]');
      const kademeRadios = form!.querySelectorAll<HTMLInputElement>('[data-kf-kademe]');
      if (etkSel) {
        if (aski) etkSel.removeAttribute('required');
        else etkSel.setAttribute('required', '');
      }
      if (telefonEl) {
        if (aski) telefonEl.removeAttribute('required');
        else telefonEl.setAttribute('required', '');
      }
      kademeRadios.forEach((r) => {
        if (aski) r.removeAttribute('required');
        // not: Direkt akışta required, Başvuru'da syncDirektAkis kaldırır.
        else r.setAttribute('required', '');
      });
      if (askiBolum) {
        askiBolum.open = aski || askiBolum.open;
      }
      if (askiTutarEl) {
        if (aski) askiTutarEl.setAttribute('required', '');
        else askiTutarEl.removeAttribute('required');
      }
      syncSubmitMetni();
      refreshOdemeBlok();
    }
    askiOnlyEl?.addEventListener('change', syncAskiOnly);

    // Aşama 3b — ödeme yöntemi (kart/havale). Kart → IBAN gizli; havale →
    // IBAN görünür. Submit metni `syncSubmitMetni` ile tek yerde yönetilir.
    const yontemRadios = form!.querySelectorAll<HTMLInputElement>('[data-kf-yontem]');
    const ibanBloku = form!.querySelector<HTMLElement>('[data-kf-iban-bloku]');
    function seciliYontem(): 'kart' | 'havale' {
      const sec = form!.querySelector<HTMLInputElement>('[data-kf-yontem]:checked');
      return sec?.value === 'havale' ? 'havale' : 'kart';
    }
    function syncYontem() {
      const yontem = seciliYontem();
      if (ibanBloku) ibanBloku.hidden = yontem !== 'havale';
      syncSubmitMetni();
    }
    yontemRadios.forEach((r) => r.addEventListener('change', syncYontem));

    // Submit butonu metni — tek otorite. Öncelik: sadece-askı > Başvuru >
    // (Direkt) tam-burs > kart > havale (default).
    function syncSubmitMetni() {
      if (askiOnlyEl?.checked) {
        submit.textContent = 'Bir kor bırak';
        return;
      }
      if (!direktAktif()) {
        submit.textContent = 'Başvur';
        return;
      }
      const tamBurs = !!(promoSonuc?.gecerli && promoSonuc.tip === 'tam-burs');
      if (tamBurs) {
        // Aşama 3b-fix ADIM 3 — tam burs ödeme yok → yönlendirme yok →
        // "Karta Yönlen" yanlış; "Yerini Ayır" doğru sinyal.
        submit.textContent = 'Yerini Ayır';
        return;
      }
      submit.textContent = seciliYontem() === 'kart' ? 'Karta Yönlen' : oldText;
    }
    syncYontem();

    // Aşama 3b-fix initial — Kayıt Tipi initial state (ilk etkinliğe göre):
    // required'lar + form.dataset.direktAkis + submit metni sync.
    syncDirektAkis();
    refreshKademeTutarlari();
    refreshOdemeBlok();

    function formatBaslik(f: string): string {
      // Frontend gösterim için map; backend Notion enum'u kullanır (FORMAT_TIP).
      const map: Record<string, string> = {
        cember: 'Çember',
        'acik-kapi': 'Açık Kapı',
        'mini-retreat': 'Mini Retreat',
        istanbul: 'İstanbul',
        seremoni: 'Seremoni',
        workshop: 'Workshop',
      };
      return map[f] ?? f;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      // Aşama 3a — sadece-askı modu artık AÇIK. POST eder, backend ayrı
      // Tip="Askı Katkısı" Kayıtlar satırı açar.
      const sadeceAski = !!askiOnlyEl?.checked;

      submit.disabled = true;
      submit.textContent = sadeceAski ? 'Gönderiliyor…' : 'Gönderiliyor…';

      const data = new FormData(form);

      // Ek soruları topla — name="soru_0", "soru_1", ... textarea'lar.
      // Key = data-soru attribute (Notion soru metni); value = textarea içeriği.
      const ekSorular: Record<string, string> = {};
      form
        .querySelectorAll<HTMLTextAreaElement>('textarea[name^="soru_"]')
        .forEach((ta) => {
          const soru = ta.dataset.soru ?? ta.name;
          const cevap = ta.value.trim();
          if (cevap) ekSorular[soru] = cevap;
        });

      // Askı + promo alanları (Aşama 3a backend okur).
      const promoKodRaw = (data.get('promo_kod') ?? '').toString().trim();
      const promoKodIdRaw = (data.get('promo_kod_id') ?? '').toString().trim();
      const askiTutarRaw = (data.get('aski_tutar') ?? '').toString().trim();
      const askiTutar = Number(askiTutarRaw);
      const askiNiyetRaw = (data.get('aski_niyet') ?? '').toString().trim();
      // Aşama 2.5 — Kapı 1 kademe seçimi (Kapı 2'de yok).
      const kademeRaw = (data.get('kademe') ?? '').toString();
      const kademeOk = kademeRaw === 'ust' || kademeRaw === 'orta' || kademeRaw === 'alt';
      // Aşama 3b — ödeme yöntemi (Kapı 1; cember'de yok).
      const yontemRaw = (data.get('odeme_yontemi') ?? '').toString();
      const yontem: 'kart' | 'havale' = yontemRaw === 'havale' ? 'havale' : 'kart';

      const payload: KayitPayload = {
        format,
        ad: (data.get('ad') ?? '').toString().trim(),
        email: (data.get('email') ?? '').toString().trim(),
        telefon: (data.get('telefon') ?? '').toString().trim(),
        sehir: (data.get('sehir') ?? '').toString().trim(),
        // kanal: kaldırıldı (Brief 3b-fix); payload'da yok artık.
        ekSorular,
        etkinlikId: (data.get('etkinlik_id') ?? '').toString(),
        seciliTarih: select.options[select.selectedIndex]?.dataset.tarih ?? '',
        ekonomikKatilim: (data.get('ekonomik_katilim') ?? '').toString(),
        kvkk: data.get('kvkk') === 'on',
        // KARAR 194 honeypot — bot doldurursa endpoint sessiz success döner.
        website: (data.get('website') ?? '').toString(),
        ...(promoKodRaw ? { promoKod: promoKodRaw } : {}),
        ...(promoKodIdRaw ? { kodId: promoKodIdRaw } : {}),
        ...(askiTutarRaw && askiTutar > 0 ? { askiTutar } : {}),
        ...(askiNiyetRaw ? { askiNiyet: askiNiyetRaw } : {}),
        ...(sadeceAski ? { sadeceAski: true } : {}),
        ...(direktAktif() && kademeOk ? { kademe: kademeRaw as 'ust' | 'orta' | 'alt' } : {}),
        ...(direktAktif() ? { odemeYontemi: yontem } : {}),
      };

      // Defansif validation — üç dal (Aşama 3b-fix eyeball: şehir/kanal artık
      // required değil → validation listesinden çıkarıldı). Tüm gizli alanlar
      // required-suz (CSS-gizli + required = submit bloker, tuzak temizliği).
      // - sadece-askı: ad + email + kvkk + askıTutar > 0
      // - Direkt: ad + email + telefon + etkinlik + kademe + kvkk
      // - Başvuru: ad + email + telefon + etkinlik + kvkk (kademe YOK)
      const direkt = direktAktif();
      const eksik = sadeceAski
        ? !payload.ad || !payload.email || !payload.kvkk || !(payload.askiTutar && payload.askiTutar > 0)
        : !payload.ad ||
          !payload.email ||
          !payload.telefon ||
          !payload.etkinlikId ||
          !payload.kvkk ||
          (direkt && !payload.kademe);
      if (eksik) {
        errorEl.textContent = 'Lütfen zorunlu alanları doldur.';
        errorEl.hidden = false;
        submit.disabled = false;
        submit.textContent = oldText;
        // Eksik field'lı bölümü aç ki kullanıcı görsün.
        section
          .querySelectorAll<HTMLDetailsElement>('.kayit-formu__grup')
          .forEach((d) => {
            if (d.querySelector(':invalid')) d.open = true;
          });
        return;
      }

      try {
        const result = await submitKayit(payload);
        if (result.status === 'success') {
          // Aşama 3b — kart yöntemi: backend checkoutUrl döndü → kullanıcı
          // sağlayıcı checkout sayfasına yönlendirilir. Form ekranı gizlenmez
          // (kullanıcı geri dönerse — örn. browser back — sayfada kalır;
          // hata akışında /odeme/iptal sayfasından geri gelir).
          if (result.checkoutUrl) {
            window.location.href = result.checkoutUrl;
            return;
          }

          form.hidden = true;

          // Aşama 3a — mod ayrımı (kayit vs sadece-aski). Title + ödemeli
          // bloğun üst metni mod'a göre.
          const isSadeceAski = result.mode === 'sadece-aski';
          const titleEl = successEl.querySelector<HTMLElement>('[data-kf-success-title]');
          if (titleEl) {
            titleEl.textContent = isSadeceAski
              ? 'Bıraktığın kor ulaştı'
              : 'Kaydın bize ulaştı';
          }
          const odemeliMetinEl = successEl.querySelector<HTMLElement>(
            '[data-kf-success-odemeli-metin]',
          );
          if (odemeliMetinEl) {
            odemeliMetinEl.textContent = isSadeceAski
              ? 'Bıraktığın kor, yoluna çıkacak bir kadını bekliyor. Katkını aşağıdaki hesaba iletebilirsin; ulaştığında onayını yazıyoruz.'
              : 'Ateşin yanında sana yer ayırdık. Yerini sabitlemek için katılım payını aşağıdaki hesaba iletebilirsin; ulaştığında buluşmanın detaylarıyla sana dönüyoruz.';
          }

          // Ödeme dalına göre success içeriğini doldur.
          const odemesizDiv = successEl.querySelector<HTMLElement>('[data-kf-success-odemesiz]')!;
          const odemeliDiv = successEl.querySelector<HTMLElement>('[data-kf-success-odemeli]')!;
          if (result.odeme?.gerekli) {
            odemesizDiv.hidden = true;
            odemeliDiv.hidden = false;
            successEl.querySelector('[data-kf-success-tutar]')!.textContent =
              String(result.odeme.tutar ?? '');
            successEl.querySelector('[data-kf-success-para]')!.textContent =
              result.odeme.paraBirimi;
            // Brief 6 KARAR 210 — referans no havale bilgisinde.
            successEl.querySelector('[data-kf-success-referans]')!.textContent =
              result.referansNo ?? '';
            successEl.querySelector('[data-kf-success-iban]')!.textContent = result.odeme.iban;
            successEl.querySelector('[data-kf-success-ad]')!.textContent = result.odeme.ad;
            successEl.querySelector('[data-kf-success-aciklama]')!.textContent =
              result.odeme.aciklama;
          } else {
            odemesizDiv.hidden = false;
            odemeliDiv.hidden = true;
          }

          // Aşama 3a — kendi+askı kombinasyonu: "Ve bir kor daha bıraktın" ek
          // satırı. Sadece-askı modunda bu ek YOK (zaten ana mesaj askı).
          // İki slot var (ödemeli/ödemesiz dal); doğru olanı aç.
          const askiEkOdemeli = successEl.querySelector<HTMLElement>(
            '[data-kf-success-aski-ek-odemeli]',
          );
          const askiEkOdemesiz = successEl.querySelector<HTMLElement>(
            '[data-kf-success-aski-ek-odemesiz]',
          );
          if (askiEkOdemeli) askiEkOdemeli.hidden = true;
          if (askiEkOdemesiz) askiEkOdemesiz.hidden = true;
          if (result.aski && !isSadeceAski) {
            if (result.odeme?.gerekli && askiEkOdemeli) askiEkOdemeli.hidden = false;
            else if (askiEkOdemesiz) askiEkOdemesiz.hidden = false;
          }
          // Brief 6 KARAR 210 — katilim bloğu (link/adres). İki koşul:
          //   1) katilim.var=true (link/adres var)
          //   2) odeme.gerekli=false (ödeme bekleyen kayıtta link gizli)
          // odemesiz+link var ise: katilim bloğu görünür + ödemesiz fallback
          //   metni gizlenir (link cümlesi ana mesaj olur).
          // odemesiz+link YOK ise: fallback metin "yakında paylaşacağız" kalır.
          // ödemeli+link var ise: katilim bloğu GİZLİ (ödeme alınınca otomasyon).
          const katilimDiv = successEl.querySelector<HTMLElement>('[data-kf-success-katilim]')!;
          const odemesizFallbackEl = successEl.querySelector<HTMLElement>(
            '[data-kf-success-odemesiz-fallback]',
          )!;
          if (result.katilim?.var && !result.odeme?.gerekli) {
            const cumleEl = katilimDiv.querySelector<HTMLElement>('[data-kf-success-katilim-cumle]')!;
            const degerEl = katilimDiv.querySelector<HTMLElement>('[data-kf-success-katilim-deger]')!;
            cumleEl.textContent =
              result.katilim.tipi === 'link'
                ? 'Buluşma linkin burada. Mail kutuna da düştü.'
                : 'Buluşacağımız yer burada. Mail kutuna da düştü.';
            // XSS koruması — Notion'dan geliyor ama yine de href'i element olarak set et.
            degerEl.textContent = '';
            if (result.katilim.tipi === 'link') {
              const a = document.createElement('a');
              a.href = result.katilim.deger;
              a.textContent = result.katilim.deger;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              degerEl.appendChild(a);
            } else {
              degerEl.textContent = result.katilim.deger;
            }
            katilimDiv.hidden = false;
            // Link var → fallback metin gereksiz, gizle.
            odemesizFallbackEl.hidden = true;
          }
          successEl.hidden = false;
          scrollToSuccess(successEl);
          if (typeof window !== 'undefined' && window.dataLayer) {
            window.dataLayer.push({ event: 'form_submit', form_type: format });
          }
        } else if (result.status === 'skip') {
          // Honeypot — sessiz success (kullanıcıya bir şey gösterme, sadece form'da kal).
          form.hidden = true;
          successEl.hidden = false;
          scrollToSuccess(successEl);
        }
      } catch (err) {
        console.error('Kayıt error:', err);
        errorEl.textContent =
          'Bir sorun oluştu. Lütfen tekrar dene ya da selam@ocak.biz adresine yaz.';
        errorEl.hidden = false;
        submit.disabled = false;
        submit.textContent = oldText;
      }
    });
  }
</script>
