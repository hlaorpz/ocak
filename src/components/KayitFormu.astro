  .kayit-formu__success-aski-ek {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--gold);
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }
  .kayit-formu__success-aski-ek[hidden] { display: none; }

  /* Brief 5 KARAR 208 — katilim bloğu (link/adres + "not al" cümlesi). */
  .kayit-formu__success-katilim {
    margin: 0 auto var(--space-6);
    max-width: 42ch;
    text-align: center;
  }
  .kayit-formu__success-katilim-not {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--cream-soft);
    line-height: 1.7;
    margin: 0 0 var(--space-3);
  }
  .kayit-formu__success-katilim-deger {
