  /* === Aşama 2 — sadece-askı toggle (form üstü) ============================
   * Küçük, sessiz davet — checkbox + metin, smoke renk, hover'da ember.
   * Cember (Kapı 2) formunda gösterilmez. */
  .kayit-formu__aski-toggle {
    margin-bottom: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--ash);
    background: rgba(255, 255, 255, 0.015);
  }
  .kayit-formu__aski-toggle-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--cream-soft);
    line-height: 1.5;
  }
  .kayit-formu__aski-toggle-label input[type='checkbox'] {
    width: 16px;
    height: 16px;
    accent-color: var(--ember);
    flex-shrink: 0;
    cursor: pointer;
  }
  .kayit-formu__aski-toggle-label:hover,
  .kayit-formu__aski-toggle-label:focus-within {
    color: var(--cream);
  }

  /* === Aşama 2 — opsiyonel etiket ("opsiyonel" smoke gri, küçük) =========== */
