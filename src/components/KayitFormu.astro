  import { scrollToSuccess } from '../lib/scroll-to-success';

  const form = document.querySelector<HTMLFormElement>('.kayit-formu__form');
  if (form) {
    const section = form.closest<HTMLElement>('.kayit-formu')!;
    const submit = form.querySelector<HTMLButtonElement>('.kayit-formu__submit')!;
    const errorEl = section.querySelector<HTMLElement>('.kayit-formu__error')!;
    const successEl = section.querySelector<HTMLElement>('.kayit-formu__success')!;
    const odemeBlok = form.querySelector<HTMLElement>('.kayit-formu__odeme')!;
    const select = form.querySelector<HTMLSelectElement>('select[name="etkinlik_id"]')!;
    const format = form.dataset.format ?? '';
    const oldText = submit.textContent ?? 'Kaydımı Gönder';

    // Aşama 2 — canlı tutar (Katman A + indirim slot + Katman B + Toplam).
    // İndirim DAİMA 0 (backend yok; Aşama 3'te kodDogrula'dan gelecek + slot
    // açılacak). Üç-dal mantığı (Aşama 3): Yüzde/Sabit indirim A+B'ye uygulanır;
    // Tam burs sadece A sıfırlanır, B aynen kalır. Şimdi tek formül: yeniA =
    // max(0, A − indirim); toplam = yeniA + B. Indirim=0 olduğu için A+B.
    const askiOnlyEl = form.querySelector<HTMLInputElement>('[data-kf-sadece-aski]');
    const askiTutarEl = form.querySelector<HTMLInputElement>('[data-kf-aski-tutar]');
    const askiBolum = section.querySelector<HTMLDetailsElement>('.kayit-formu__grup--aski');
    const indirimSlot = odemeBlok.querySelector<HTMLElement>('[data-kf-indirim-slot]');
    const katmanBSlot = odemeBlok.querySelector<HTMLElement>('[data-kf-katmanB-slot]');

    function aktifUcret(): { ucret: number; para: string; tarih: string } {
      // Sadece-askı modunda A=0, para birimi default TRY.
      if (askiOnlyEl?.checked) return { ucret: 0, para: 'TRY', tarih: '' };
      const opt = select.options[select.selectedIndex];
      return {
        ucret: Number(opt?.dataset.ucret ?? '0') || 0,
        para: opt?.dataset.paraBirimi ?? 'TRY',
        tarih: opt?.dataset.tarih ?? '',
      };
    }

    function refreshOdemeBlok() {
      const { ucret: katmanA, para, tarih } = aktifUcret();
      const indirim = 0; // Aşama 3'te kodDogrula'dan gelecek.
      const yeniA = Math.max(0, katmanA - indirim);
      const katmanB = Math.max(0, Number(askiTutarEl?.value ?? '0') || 0);
      const toplam = yeniA + katmanB;

      odemeBlok.querySelector('[data-kf-katmanA]')!.textContent = String(katmanA);
      odemeBlok.querySelector('[data-kf-para]')!.textContent = para;
      odemeBlok.querySelector('[data-kf-toplam]')!.textContent = String(toplam);
      odemeBlok.querySelector('[data-kf-para-toplam]')!.textContent = para;

      // Katman B slot: askı > 0 ise göster.
      if (katmanBSlot) {
        katmanBSlot.hidden = katmanB <= 0;
        const kbEl = odemeBlok.querySelector('[data-kf-katmanB]');
        if (kbEl) kbEl.textContent = String(katmanB);
      }

      // İndirim slot: Aşama 2'de indirim=0 → daima hidden. Aşama 3'te
      // backend cevabı varsa açılacak.
      if (indirimSlot) indirimSlot.hidden = indirim <= 0;

      // Havale açıklaması — sadece etkinlik ücreti varsa anlamlı.
      if (katmanA > 0) {
        const aciklamaEl = odemeBlok.querySelector('[data-kf-aciklama]')!;
        aciklamaEl.textContent = `Açıklamaya adını ve "${formatBaslik(format)} – ${tarih}" yaz.`;
      }

      // Bloğu görünür kıl: toplam > 0 (ücret veya askı). Sadece-askı modunda
      // tüm [data-kf-katilim] CSS ile gizli — blok DOM'da ama görünmez,
      // güvenli.
      odemeBlok.hidden = toplam <= 0;
    }
    select.addEventListener('change', refreshOdemeBlok);
    askiTutarEl?.addEventListener('input', refreshOdemeBlok);

    // Sadece-askı toggle — form data-aski-only attribute'u CSS gizler.
    // required attribute'larını temizle (etkinlik/ekonomik form-validation'a
    // takılmasın). Askı bölümünü auto-aç + tutar input'unu required yap.
    // Submit handler aşağıda mod'a göre erken döner.
    function syncAskiOnly() {
      const aski = !!askiOnlyEl?.checked;
      form!.dataset.askiOnly = aski ? 'true' : 'false';
      // Zorunluluk yönetimi
      const etkSel = form!.querySelector<HTMLSelectElement>('select[name="etkinlik_id"]');
      const ekonRadios = form!.querySelectorAll<HTMLInputElement>('input[name="ekonomik_katilim"]');
      if (etkSel) {
        if (aski) etkSel.removeAttribute('required');
        else etkSel.setAttribute('required', '');
      }
      ekonRadios.forEach((r) => {
        if (aski) r.removeAttribute('required');
        else if (r.value === 'Tam') r.setAttribute('required', '');
      });
      if (askiBolum) {
        askiBolum.open = aski || askiBolum.open;
      }
      if (askiTutarEl) {
        if (aski) askiTutarEl.setAttribute('required', '');
        else askiTutarEl.removeAttribute('required');
      }
      // Submit butonu metni — mod ipucu.
      submit.textContent = aski ? 'Bir kor bırak' : oldText;
      refreshOdemeBlok();
    }
    askiOnlyEl?.addEventListener('change', syncAskiOnly);
    refreshOdemeBlok();

    function formatBaslik(f: string): string {
      // Frontend gösterim için map; backend Notion enum'u kullanır (FORMAT_TIP).
      const map: Record<string, string> = {
        cember: 'Çember',
        'acik-kapi': 'Açık Kapı',
        'mini-retreat': 'Mini Retreat',
        istanbul: 'İstanbul',
        seremoni: 'Seremoni',
        workshop: 'Workshop',
      };
      return map[f] ?? f;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      // Aşama 2 — sadece-askı modu UI iskelet; backend bağlanmadı (Aşama 3).
      // POST etmiyoruz, kullanıcıya nazik bir bilgi gösteriyoruz.
      if (askiOnlyEl?.checked) {
        errorEl.textContent =
          'Sadece-askı akışı yakında açılacak. O zamana kadar bir buluşmaya katılarak da kor bırakabilirsin.';
        errorEl.hidden = false;
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Gönderiliyor…';

      const data = new FormData(form);

      // Ek soruları topla — name="soru_0", "soru_1", ... textarea'lar.
      // Key = data-soru attribute (Notion soru metni); value = textarea içeriği.
      const ekSorular: Record<string, string> = {};
      form
        .querySelectorAll<HTMLTextAreaElement>('textarea[name^="soru_"]')
        .forEach((ta) => {
          const soru = ta.dataset.soru ?? ta.name;
          const cevap = ta.value.trim();
          if (cevap) ekSorular[soru] = cevap;
        });

      // Aşama 2 — askı + promo alanları payload'a düşer; backend Aşama 3'te
      // okumaya başlayacak (şu an sessizce yoksayılır, hatasız).
      const promoKodRaw = (data.get('promo_kod') ?? '').toString().trim();
      const askiTutarRaw = (data.get('aski_tutar') ?? '').toString().trim();
      const askiTutar = Number(askiTutarRaw);
      const askiNiyetRaw = (data.get('aski_niyet') ?? '').toString().trim();

      const payload: KayitPayload = {
        format,
        ad: (data.get('ad') ?? '').toString().trim(),
        email: (data.get('email') ?? '').toString().trim(),
        telefon: (data.get('telefon') ?? '').toString().trim(),
        sehir: (data.get('sehir') ?? '').toString().trim(),
        kanal: (data.get('kanal') ?? '').toString(),
        ekSorular,
        etkinlikId: (data.get('etkinlik_id') ?? '').toString(),
        seciliTarih: select.options[select.selectedIndex]?.dataset.tarih ?? '',
        ekonomikKatilim: (data.get('ekonomik_katilim') ?? '').toString(),
        kvkk: data.get('kvkk') === 'on',
        // KARAR 194 honeypot — bot doldurursa endpoint sessiz success döner.
        website: (data.get('website') ?? '').toString(),
        ...(promoKodRaw ? { promoKod: promoKodRaw } : {}),
        ...(askiTutarRaw && askiTutar > 0 ? { askiTutar } : {}),
        ...(askiNiyetRaw ? { askiNiyet: askiNiyetRaw } : {}),
      };

      // Defansif validation (native required attribute zorunlu alanları yakalar).
      const eksik =
        !payload.ad ||
        !payload.email ||
        !payload.telefon ||
        !payload.sehir ||
        !payload.kanal ||
        !payload.etkinlikId ||
        !payload.ekonomikKatilim ||
        !payload.kvkk;
      if (eksik) {
        errorEl.textContent = 'Lütfen zorunlu alanları doldur.';
        errorEl.hidden = false;
        submit.disabled = false;
        submit.textContent = oldText;
        // Eksik field'lı bölümü aç ki kullanıcı görsün.
        section
          .querySelectorAll<HTMLDetailsElement>('.kayit-formu__grup')
          .forEach((d) => {
            if (d.querySelector(':invalid')) d.open = true;
          });
        return;
      }

      try {
        const result = await submitKayit(payload);
        if (result.status === 'success') {
          form.hidden = true;
          // Ödeme dalına göre success içeriğini doldur.
          const odemesizDiv = successEl.querySelector<HTMLElement>('[data-kf-success-odemesiz]')!;
          const odemeliDiv = successEl.querySelector<HTMLElement>('[data-kf-success-odemeli]')!;
          if (result.odeme?.gerekli) {
            odemesizDiv.hidden = true;
            odemeliDiv.hidden = false;
            successEl.querySelector('[data-kf-success-tutar]')!.textContent =
              String(result.odeme.tutar ?? '');
            successEl.querySelector('[data-kf-success-para]')!.textContent =
              result.odeme.paraBirimi;
            // Brief 6 KARAR 210 — referans no havale bilgisinde.
            successEl.querySelector('[data-kf-success-referans]')!.textContent =
              result.referansNo ?? '';
            successEl.querySelector('[data-kf-success-iban]')!.textContent = result.odeme.iban;
            successEl.querySelector('[data-kf-success-ad]')!.textContent = result.odeme.ad;
            successEl.querySelector('[data-kf-success-aciklama]')!.textContent =
              result.odeme.aciklama;
          } else {
            odemesizDiv.hidden = false;
            odemeliDiv.hidden = true;
          }
          // Brief 6 KARAR 210 — katilim bloğu (link/adres). İki koşul:
          //   1) katilim.var=true (link/adres var)
          //   2) odeme.gerekli=false (ödeme bekleyen kayıtta link gizli)
          // odemesiz+link var ise: katilim bloğu görünür + ödemesiz fallback
          //   metni gizlenir (link cümlesi ana mesaj olur).
          // odemesiz+link YOK ise: fallback metin "yakında paylaşacağız" kalır.
          // ödemeli+link var ise: katilim bloğu GİZLİ (ödeme alınınca otomasyon).
          const katilimDiv = successEl.querySelector<HTMLElement>('[data-kf-success-katilim]')!;
          const odemesizFallbackEl = successEl.querySelector<HTMLElement>(
            '[data-kf-success-odemesiz-fallback]',
          )!;
          if (result.katilim?.var && !result.odeme?.gerekli) {
            const cumleEl = katilimDiv.querySelector<HTMLElement>('[data-kf-success-katilim-cumle]')!;
            const degerEl = katilimDiv.querySelector<HTMLElement>('[data-kf-success-katilim-deger]')!;
            cumleEl.textContent =
              result.katilim.tipi === 'link'
                ? 'Buluşma linkin burada. Mail kutuna da düştü.'
                : 'Buluşacağımız yer burada. Mail kutuna da düştü.';
            // XSS koruması — Notion'dan geliyor ama yine de href'i element olarak set et.
            degerEl.textContent = '';
            if (result.katilim.tipi === 'link') {
              const a = document.createElement('a');
              a.href = result.katilim.deger;
              a.textContent = result.katilim.deger;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              degerEl.appendChild(a);
            } else {
              degerEl.textContent = result.katilim.deger;
            }
            katilimDiv.hidden = false;
            // Link var → fallback metin gereksiz, gizle.
            odemesizFallbackEl.hidden = true;
          }
          successEl.hidden = false;
          scrollToSuccess(successEl);
          if (typeof window !== 'undefined' && window.dataLayer) {
            window.dataLayer.push({ event: 'form_submit', form_type: format });
          }
        } else if (result.status === 'skip') {
          // Honeypot — sessiz success (kullanıcıya bir şey gösterme, sadece form'da kal).
          form.hidden = true;
          successEl.hidden = false;
          scrollToSuccess(successEl);
        }
      } catch (err) {
        console.error('Kayıt error:', err);
        errorEl.textContent =
          'Bir sorun oluştu. Lütfen tekrar dene ya da selam@ocak.biz adresine yaz.';
        errorEl.hidden = false;
        submit.disabled = false;
        submit.textContent = oldText;
      }
    });
  }
</script>
