---
// KayitCTA — /cember (ve Brief 3'te diğer 5 format) için form-anchor noktasında
// formun yerine basılan kısa CTA (Brief 2B Adım 4). Form artık ayrı route'ta
// (/cember/kayit) — bu component sadece "Kayıt ol →" linki + bir cümle.
//
// AtesMektuplariCTA kardeşi: aynı sade pattern, sadece href + cumle prop'a açık.
// Eski CemberBasvuru/AcikKapiKayit component'leri silindi (brief-appscript-olum) —
// registry yönlendirmesi burada (form-anchor-registry.ts /cember entry'si
// KayitCTA'ya çevrildi).
//
// introHtml (KARAR 151): Notion'dan form-anchor look-backward intro varsa
// pasif olarak CTA üstünde render edilir.
//
// Buton label (brief-faz3-h4-h5 İş 3): href'ten slug türetip KAYIT_CTA_LABEL
// map'inden çekilir — Direkt formatlar "Yerini ayır", mini retreat "Başvur".
//
// MADDE 2 (boşa-davet gate): kategori yaklaşan yoksa CTA yerine tek satır
// Ateş Mektupları köprüsü. Format-agnostik — SLUG_KATEGORI + kategoriEtkinlikVarMi.
// MADDE 4 (dayanışma ön-izleme): butonun üstünde tek satır kademe cümlesi.
import { KAYIT_CTA_LABEL, isKayitFormat, DAYANISMA_METNI } from '../lib/kayit';
import {
  BOS_KAPI_DAVET_HTML,
  type EtkinlikKategori,
} from '../lib/etkinlik-kategori';
import { kategoriEtkinlikVarMi } from '../lib/etkinlik-server';
interface Props {
  /** Hedef kayıt sayfası — örn '/cember/kayit'. */
  href: string;
  /** Görünen kategori ("çembere", "açık kapıya"...) — cümle içine gömülür. */
  kategoriAdi: string;
  /** Notion form-anchor look-backward intro HTML. */
  introHtml?: string;
}
const { href, kategoriAdi, introHtml } = Astro.props;
const slug = href.replace(/^\/+/, '').split('/')[0];
const butonMetni = isKayitFormat(slug) ? KAYIT_CTA_LABEL[slug] : 'Yerini ayır';
// KayitFormat ⊂ EtkinlikKategori — isKayitFormat guard sonrası cast güvenli.
const kategori: EtkinlikKategori | null = isKayitFormat(slug) ? slug : null;
const etkinlikVar = kategori ? await kategoriEtkinlikVarMi(kategori) : true;
---
<section data-section="kayit-cta" class="ocak-kayit-cta">
  {introHtml && <div class="ocak-kayit-cta__intro" set:html={introHtml} />}
  {etkinlikVar ? (
    <>
      <p class="ocak-kayit-cta__dayanisma">{DAYANISMA_METNI}</p>
      <p>
        Sıradaki <strong>{kategoriAdi}</strong> için tarih seç, katılım payını ilet —
        yerini ayıralım.
      </p>
      <a class="ocak-kayit-cta__link" href={href}>
        {butonMetni} →
      </a>
    </>
  ) : (
    <p class="ocak-kayit-cta__davet" set:html={BOS_KAPI_DAVET_HTML} />
  )}
</section>

<style>
  .ocak-kayit-cta {
    text-align: center;
  }
  .ocak-kayit-cta__dayanisma {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--smoke);
    font-style: italic;
    margin: 0 0 var(--space-3);
  }
  .ocak-kayit-cta__davet {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--smoke);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--leading-prose);
  }
  .ocak-kayit-cta__davet a {
    color: var(--ember);
  }
  .ocak-kayit-cta__link {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .ocak-kayit-cta__link:hover,
  .ocak-kayit-cta__link:focus-visible {
    border-bottom-color: var(--ember);
  }
</style>
