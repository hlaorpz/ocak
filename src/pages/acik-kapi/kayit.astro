---
// /acik-kapi/kayit — Açık Kapı ödemeli kayıt (Brief 3 KARAR 206).
// Açık Kapı tanıtım buluşması; SORULU form (Kaan Notion'da Kayıt Soruları yazdı,
// bilinçli karar — ücretsiz tanıtım buluşmasına da niyet sorulur).
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import KayitFormu from '../../components/KayitFormu.astro';
import { loadKayitData } from '../../lib/kayit-sayfa';

const data = await loadKayitData('acik-kapi');
---
<Layout
  title="Açık Kapı Kaydı"
  description="Sıradaki Açık Kapı'ya kaydını yap. Tarih seç, kısa bir niyet yaz, katılım payını ilet."
  oda="Buluşmalar"
>
  <Hero
    oda="Buluşmalar"
    overline="AÇIK KAPI"
    title="Bir Açık Kapı'ya gel."
    subtitle="Tarih seç, kısa bir niyet yaz, katılım payını ilet — ateşin yanında sana yer ayıralım."
    showScroll={false}
  />
  <KayitFormu
    format="acik-kapi"
    etkinlikler={data.etkinlikler}
    havaleIban={data.havaleIban}
    havaleAd={data.havaleAd}
    askiReferanslari={data.askiReferanslari}
  />
</Layout>
