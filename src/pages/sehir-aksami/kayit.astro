---
// /sehir-aksami/kayit — Şehir Akşamı ödemeli kayıt (Brief 3 KARAR 206).
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import KayitFormu from '../../components/KayitFormu.astro';
import { loadKayitData } from '../../lib/kayit-sayfa';

const data = await loadKayitData('sehir-aksami');
---
<Layout
  title="Şehir Akşamı Kaydı"
  description="Sıradaki şehir akşamına kaydını yap. Tarih seç, kısa bir niyet yaz, katılım payını ilet."
  oda="Buluşmalar"
>
  <Hero
    oda="Buluşmalar"
    overline="ŞEHİR AKŞAMI"
    title="Bir şehir akşamına gel."
    subtitle="Tarih seç, kısa bir niyet yaz, katılım payını ilet — ateşin yanında sana yer ayıralım."
    showScroll={false}
  />
  <KayitFormu
    format="sehir-aksami"
    etkinlikler={data.etkinlikler}
    havaleIban={data.havaleIban}
    havaleAd={data.havaleAd}
    askiReferanslari={data.askiReferanslari}
  />
</Layout>
