---
// araclar.astro — /araclar sayfa override.
// Notion içerik akışı: plugin (remark-ocak-sections) RAF_SECTIONS whitelist'inden
// gelen `raf-*` section'larını `<details name="raflar" class="liste__oge">`
// accordion olarak emit ediyor (Madde 8 liste ailesi tek gramer). Bu dosyada
// build-time HTML rewrite yok — statik route dinamik [...slug].astro'yu ezer
// (KARAR 119), ama içerik dönüşümü plugin tarafında.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageContent from '../components/PageContent.astro';

const sayfa = await getEntry('sayfalar', '/araclar');
if (!sayfa) {
  throw new Error("araclar.astro: 'sayfalar' collection'ında '/araclar' slug'ı bulunamadı.");
}
---
<Layout
  title={sayfa.data.title}
  description={sayfa.data.description}
  ogImage={sayfa.data.ogImage}
  oda={sayfa.data.oda}
>
  <PageContent slug="/araclar" fragments={sayfa.data.fragments} />
</Layout>
