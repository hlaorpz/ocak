---
// onizleme/index.astro — ANA SAYFA fotolu önizleme iskeleti.
// Brief brief-fotolu-onizleme.md İş 3 + ek-brief-foto-oranlari.md
// + ek-brief-oran-placeholder.md (GEÇİCİ placeholder testi — `// PLACEHOLDER`
//   etiketli bloklar Kaan onayıyla SİLİNECEK; cleanup tek pass).
//
// Çatallanma kuralı:
//   - Çatallanmayan: Layout, Hero, PageContent, AtesMektuplari, section component'leri,
//     Notion içeriği, plugin pipeline. Bunlar master'dan AYNEN import edilir.
//   - Çatallanan: SADECE bu dosya — parçaların diziliş düzeni + foto yerleşimi.
//
// Foto oranları (ek-brief tablosu):
//   - Hero arka plan: 16:9
//   - Portre (rehber): 4:5 dikey
//   - Atmosfer bandı x3: 21:9 sinematik
//   - Buluşma kartı: 16:10 (SonrakiBulusma içinde Etkinlik.kartGorsel doluyken
//     basılır; bu sayfada placeholder STANDALONE test bölümü → cleanup'ta kaldırılır)
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageContent from '../../components/PageContent.astro';
import Hero from '../../components/Hero.astro';
// PLACEHOLDER import — ek-brief-oran-placeholder.md (cleanup'ta SİL)
import { placeholderSvg, placeholderDataUrl } from '../../lib/_onizleme_placeholder';

const sayfa = await getEntry('sayfalar', '/');
if (!sayfa) {
  throw new Error("onizleme/index.astro: 'sayfalar' collection'ında '/' slug'ı bulunamadı.");
}

const { heroImage, portreImage, atmosfer1, atmosfer2, atmosfer3 } = sayfa.data;

// PLACEHOLDER: Hero bgImage için fallback data URL (cleanup → `bgImage={heroImage}`)
const heroBg = heroImage ?? placeholderDataUrl('HERO', '16:9', 160, 90);
---
<Layout
  title={sayfa.data.title}
  description={sayfa.data.description}
  ogImage={sayfa.data.ogImage}
  oda="OCAK"
  noindex
>
  {/* Hero — bgImage placeholder data URL (test); cleanup'ta `bgImage={heroImage}` */}
  <Hero
    oda="OCAK"
    overline="KADINLARIN KADİM ATEŞİ"
    title="Ocağın ne zaman söndü?"
    subtitle="Ateşin yanında yer var."
    ctaText="Ateşin yanına gel"
    ctaHref="#ates-mektuplari"
    bgImage={heroBg}
  />

  {/* Atmosfer 1 — 21:9. PLACEHOLDER: boşken fallback render; cleanup'ta `{atmosfer1 && ...}` */}
  <section class="onizleme-atmosfer" data-onizleme="atmosfer-1">
    <figure class="onizleme-atmosfer__sera">
      {atmosfer1
        ? <img src={atmosfer1} alt="" loading="lazy" />
        : <Fragment set:html={placeholderSvg('ATMOSFER 1', '21:9', 210, 90)} />
      }
    </figure>
  </section>

  {/* Notion fragment'ları master ile bire bir. */}
  <PageContent slug="/" fragments={sayfa.data.fragments} />

  {/* Rehber portresi — 4:5. PLACEHOLDER: boşken fallback. Cleanup'ta `{portreImage && ...}` */}
  <section class="onizleme-portre" data-onizleme="portre">
    <div class="ocak-container">
      <figure class="onizleme-portre__figure">
        {portreImage
          ? <img src={portreImage} alt="" loading="lazy" />
          : <Fragment set:html={placeholderSvg('PORTRE (REHBER)', '4:5', 40, 50)} />
        }
      </figure>
    </div>
  </section>

  {/* Atmosfer 2 */}
  <section class="onizleme-atmosfer" data-onizleme="atmosfer-2">
    <figure class="onizleme-atmosfer__sera">
      {atmosfer2
        ? <img src={atmosfer2} alt="" loading="lazy" />
        : <Fragment set:html={placeholderSvg('ATMOSFER 2', '21:9', 210, 90)} />
      }
    </figure>
  </section>

  {/* PLACEHOLDER BÖLÜMÜ — Buluşma kartı 16:10 standalone test. SonrakiBulusma
      component'i (PageContent içinden basılır) Etkinlik.kartGorsel doluyken zaten
      köşe görseli basıyor — bu bölüm AYRI bir oran-doğrulama testi (master karta
      etki etmesin diye standalone). Cleanup'ta TAMAMEN KALDIRILACAK. */}
  <section class="onizleme-kart-test" data-onizleme="kart-test">
    <div class="onizleme-kart-test__wrap">
      <figure class="onizleme-kart-test__figure"><Fragment set:html={placeholderSvg('BULUSMA KARTI', '16:10', 160, 100)} /></figure>
    </div>
  </section>

  {/* Atmosfer 3 */}
  <section class="onizleme-atmosfer" data-onizleme="atmosfer-3">
    <figure class="onizleme-atmosfer__sera">
      {atmosfer3
        ? <img src={atmosfer3} alt="" loading="lazy" />
        : <Fragment set:html={placeholderSvg('ATMOSFER 3', '21:9', 210, 90)} />
      }
    </figure>
  </section>
</Layout>

<style>
  /* Brief brief-fotolu-onizleme.md + ek-brief-foto-oranlari.md — /onizleme oyun alanı.
     Bu blok master'a etki etmez. aspect-ratio container'lar CLS=0 garantisi. */

  .onizleme-portre {
    padding: var(--space-8) 0;
  }

  .onizleme-portre__figure {
    margin: 0;
    max-width: 540px;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ash);
    border-radius: 2px;
  }

  .onizleme-portre__figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .onizleme-atmosfer {
    padding: var(--space-6) 0;
  }

  .onizleme-atmosfer__sera {
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--ash);
  }

  .onizleme-atmosfer__sera img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PLACEHOLDER STYLES — buluşma kartı test bölümü. Cleanup'ta bu blok silinecek. */

  .onizleme-kart-test {
    padding: var(--space-6) 0;
  }

  .onizleme-kart-test__wrap {
    max-width: 360px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .onizleme-kart-test__figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ash);
  }
</style>
