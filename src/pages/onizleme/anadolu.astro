---
// onizleme/anadolu.astro — /anadolu fotolu önizleme iskeleti.
// Brief brief-fotolu-onizleme.md İş 3 + ek-brief-foto-oranlari.md.
//
// Master /anadolu dinamik [...slug].astro route'undan; bu dosya fotolu kardeşi.
// İçerik (sayfalar/'/anadolu') + harita-anadolu marker'ı + 6 evre yolculuğu hepsi
// PageContent fragment-split'inden gelir → aynı kaynak.
//
// Tür 1 (düzen değişmez): hero foto bandı 16:9 (Hero Görsel doluyken).
// Diğer sayfa-özel görseller şu an Notion alanında yok (KARAR'da genişletilebilir);
// burada sadece hero band'ı oluyor. Harita ve evre kartları içeride değişmez.
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageContent from '../../components/PageContent.astro';
// PLACEHOLDER import — ek-brief-oran-placeholder.md (cleanup'ta SİL)
import { placeholderDataUrl } from '../../lib/_onizleme_placeholder';

const sayfa = await getEntry('sayfalar', '/anadolu');
if (!sayfa) {
  throw new Error("onizleme/anadolu.astro: 'sayfalar' collection'ında '/anadolu' slug'ı bulunamadı.");
}

const { heroImage } = sayfa.data;
// PLACEHOLDER: heroImage boşken hero-band fallback. Cleanup → `const heroBg = heroImage;`
const heroBg = heroImage ?? placeholderDataUrl('HERO', '16:9', 160, 90);
---
<Layout
  title={sayfa.data.title}
  description={sayfa.data.description}
  ogImage={sayfa.data.ogImage}
  oda={sayfa.data.oda}
  noindex
>
  {/* Tür 1 — hero foto bandı. PLACEHOLDER: heroBg her zaman var. Cleanup'ta
      `{heroImage && (...)` koşulu geri gelir. */}
  <section class="onizleme-hero-band" data-onizleme="hero-band">
    <div class="onizleme-hero-band__image" style={`background-image: url('${heroBg}')`} aria-hidden="true"></div>
  </section>


  {/* Notion içeriği master ile bire bir — harita-anadolu marker, yolculuk evreleri,
      prose. PageContent değişmez. */}
  <PageContent slug="/anadolu" fragments={sayfa.data.fragments} />
</Layout>

<style>
  /* Brief brief-fotolu-onizleme.md — Kaan'ın CSS oyun alanı (anadolu). */

  .onizleme-hero-band {
    padding: 0;
  }

  .onizleme-hero-band__image {
    width: 100%;
    aspect-ratio: 16 / 9;         /* ek-brief: Hero arka plan 16:9 */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
