---
// /acik-kapi — Notion sayfa override + geçmiş-etkinlik güvenlik ağı.
// brief-davet-sistemi: davet linki `/acik-kapi?etkinlik=YYY&ref=XXX`
// formatında. Davet edileni etkinlik geçtikten sonra tıklarsa nazikçe
// yönlendiren banner — KARAR 219 deseni, "davet asla ölü linke düşmez".
//
// Override gerekçesi: [...slug].astro statik prerender (getStaticPaths),
// query params SSR olmadan yakalanamaz. Bu sayfa `prerender = false` ile
// SSR; davet query'sini server-side okur, banner conditional render eder.
// Notion içeriği aynen PageContent ile basılır.
//
// Eyeball #4 Fix 2d: helper + component ortak — /cember, /seremoni,
// /mini-retreat, /sehir-aksami, /atolye override'ları da aynı paketi kullanır.
export const prerender = false;

import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageContent from '../components/PageContent.astro';
import DavetGecmisEtkinlikUyari from '../components/DavetGecmisEtkinlikUyari.astro';
import { etkinlikGecmisMi } from '../lib/davet-guvenlik-agi.ts';

const sayfa = await getEntry('sayfalar', '/acik-kapi');
if (!sayfa) {
  throw new Error("acik-kapi.astro: 'sayfalar' collection'ında '/acik-kapi' slug'ı bulunamadı.");
}

const etkinlikId = (Astro.url.searchParams.get('etkinlik') ?? '').trim();
const etkinlikGecmis = await etkinlikGecmisMi(etkinlikId);
---
<Layout
  title={sayfa.data.title}
  description={sayfa.data.description}
  ogImage={sayfa.data.ogImage}
  oda={sayfa.data.oda}
>
  {etkinlikGecmis && (
    <DavetGecmisEtkinlikUyari
      ctaMetin="Sıradaki Açık Kapı'ya bak →"
      ctaHref="/acik-kapi/kayit"
    />
  )}

  <PageContent slug="/acik-kapi" fragments={sayfa.data.fragments} />
</Layout>
