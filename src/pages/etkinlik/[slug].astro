---
// etkinlik/[slug].astro — brief-etkinlik-detay-route.md FAZ 2.
// Her buluşmanın (Notion Etkinlikler DB'sinden) kendi paylaşılabilir/indekslenebilir
// detay sayfası. getStaticPaths build-time üretir.
//
// Kapsam (brief FAZ 2):
//   - Slug'ı olan HER etkinlik için route (İptal hariç, geçmiş DAHİL — collection
//     content/config.ts'te 'İptal' zaten süzülüyor; burada slug guard yeter).
//   - Hero: Hero.astro component'i (KARAR 114 legacy parity — glow/fade/tipografi
//     scope'lu CSS ile beraber; elle kompozit ETMEme, Astro scope'u dışına düşer).
//   - Detay gövdesi: loader'dan gelen detayHtml (Sayfalar pipeline'ıyla aynı
//     zinciri geçti — remark-ocak-sections + resolveKayitCtaHref). set:html ile
//     basılır; wrapper sadece container (padding'i baseline'a bırak — atmosfer.css
//     `section[data-section][class^="ocak-"]` her section'a 4rem üst / 6rem alt
//     verir; wrapper ek padding koyarsa hero→ilk section aralığı iki katına çıkar).
//   - Kayıt CTA (gelecek): buluşma-spesifik davet — "sıradaki" kalıbı YOK
//     (Eyeball tur 1: bu buluşma zaten sıradaki; format sayfasının "sonraki
//     dönem" cümlesi burada yanlış okunur).
//   - Geçmiş etkinlik: "tamamlandı" kapanış bloğu — kayıt yok, tipe göre ilgili
//     format sayfasına davet linki. Build tarihine dayanır (n8n gecelik rebuild
//     ile dünkü etkinlik sabah "tamamlandı" moduna geçer, brief FAZ 4).
//   - Yöneten: render EDİLMEZ (Eyeball tur 1: Notion property kalır, sayfada
//     çıkmaz — meta ihtiyacı yok).
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { formatEtkinlikTarihi } from '../../lib/format-etkinlik';
import { FORMAT_NOTION_FORMAT, type KayitFormat } from '../../lib/kayit';

export async function getStaticPaths() {
  const tumu = await getCollection('etkinlikler');
  // brief FAZ 2: slug'ı OLAN her etkinlik için route. Collection zaten
  // siteGoster + !İptal süzüyor (config.ts FAZ 1). Slug boşsa loader zaten
  // WARN bastı; burada sessiz atla.
  return tumu
    .filter((e) => e.data.slug)
    .map((e) => ({
      params: { slug: e.data.slug! },
      props: { etkinlik: e.data },
    }));
}

const { etkinlik } = Astro.props;

// Format → 6 KayitFormat sluğu ters çevrimi (config.ts'teki eşleyicinin ikizi).
// Yolculuk vb. → undefined; CTA'yı kayitUrl yoksa basmayız.
const NOTION_FORMAT_KAYIT_SLUG = Object.fromEntries(
  Object.entries(FORMAT_NOTION_FORMAT).map(([slug, notionFmt]) => [notionFmt, slug as KayitFormat]),
) as Record<string, KayitFormat | undefined>;

// "Tamamlandı" bloğunda geçmiş buluşmayı yönlendirdiğimiz format sayfası +
// insan-okur kategori adı (aynı map — form-anchor-registry.ts formAnchorProps
// ile aynı ton, cümle içi kullanım için).
const KATEGORI_ADI: Record<string, string> = {
  'Açık Kapı': 'Açık Kapı',
  Çember: 'Çember',
  'Mini Retreat': 'mini retreat',
  Seremoni: 'seremoni',
  'Şehir Akşamı': 'şehir akşamı',
  Atölye: 'atölye',
  Yolculuk: 'Anadolu Yolculuğu',
};

const kayitSlugu = NOTION_FORMAT_KAYIT_SLUG[etkinlik.tip];
const formatSayfasi = kayitSlugu ? `/${kayitSlugu}` : '/bulusmalar';

// Kayıt CTA hedefi: Notion'daki kayitUrl doluysa (bir dış/alt link olabilir) o;
// yoksa 6 format sayfasında `/{slug}/kayit`; yoksa (Yolculuk) CTA basma.
const kayitHedefi = etkinlik.kayitUrl?.trim() || (kayitSlugu ? `/${kayitSlugu}/kayit` : null);

// Geçmiş etkinlik tespiti (build tarihi referansı — brief FAZ 4 gecelik
// rebuild ile "bugün" güncel kalır). Range varsa tarihBitis öncelikli.
function parcala(iso: string) {
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : null;
}
const bugun = new Date();
bugun.setHours(0, 0, 0, 0);
const referans = etkinlik.tarihBitis ?? etkinlik.tarihBaslangic;
const referansTarihi = parcala(referans);
const gecmisMi = referansTarihi ? referansTarihi < bugun : false;

// Detay sayfası kart-sız düzen (Kaan kararı): Hero başlık + subtitle bağlamı
// veriyor, kayıt için tek turuncu buton yeter. Subtitle: tarih + mekân düz cümlesi.
const tarihMetni = formatEtkinlikTarihi(
  etkinlik.tarihBaslangic,
  etkinlik.tarihBitis,
  etkinlik.saat ?? etkinlik.zoomBaslangicSaati,
);
const mekanMetni = etkinlik.mekanDetay
  ? `${etkinlik.mekan} · ${etkinlik.mekanDetay}`
  : etkinlik.mekan;

// SEO description: Detay ilk ~155 kar (section etiketleri strip); yoksa tipe göre
// fallback. Notion Detay markdown → düz metin: `## section:` satırlarını at,
// ardışık boşlukları tek boşluğa indir.
function detayDescription(detay: string): string {
  const duz = detay
    .split('\n')
    .filter((l) => !l.startsWith('## section:'))
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
  return duz.length > 155 ? duz.slice(0, 152).trimEnd() + '…' : duz;
}
const description =
  (etkinlik.detay && detayDescription(etkinlik.detay)) ||
  etkinlik.aciklama ||
  `${etkinlik.tip} — OCAK'ta bir buluşma.`;

const kategoriAdi = KATEGORI_ADI[etkinlik.tip] ?? etkinlik.tip;

// Kayıt-Tipi şablonu (KARAR 307): Direkt → "Yerini ayır", Başvuru → "Başvur".
// Notion tek kaynak: etkinlik.kayitTipi ('Direkt' | 'Başvuru', default Direkt).
const butonMetni = etkinlik.kayitTipi === 'Başvuru' ? 'Başvur' : 'Yerini ayır';
---
<Layout title={etkinlik.baslik} description={description} oda="Buluşmalar">
  <Hero
    oda="Buluşmalar"
    overline={etkinlik.tip}
    title={etkinlik.baslik}
    subtitle={`${tarihMetni} · ${mekanMetni}`}
    showScroll={false}
  />

  {etkinlik.detayHtml && (
    <div class="ocak-container" set:html={etkinlik.detayHtml} />
  )}

  {/* Kart yok (Kaan kararı): Hero bağlamı zaten veriyor. Detay yazılarından
      sonra tek turuncu buton + "Sana uyan başka tarihler…" link. */}
  <section data-section="kayit-cta" class="ocak-kayit-cta">
    {gecmisMi ? (
      <a class="ocak-kayit-cta__buton" href={formatSayfasi} data-kayit-cta-button>
        Sıradaki {kategoriAdi} <span aria-hidden="true">→</span>
      </a>
    ) : (
      kayitHedefi && (
        <a class="ocak-kayit-cta__buton" href={kayitHedefi} data-kayit-cta-button>
          {butonMetni} <span aria-hidden="true">→</span>
        </a>
      )
    )}

    <p class="ocak-kayit-cta__tumu">
      <a href="/takvim">Sana uyan başka tarihler de var — hepsine bak <span aria-hidden="true">→</span></a>
    </p>
  </section>
</Layout>

<!-- brief-detay-sayfa-revize: sayfa-özel `.etkinlik-detay__*` class'ları
     kaldırıldı. Kayıt aksiyonu standart `.ocak-kayit-cta__buton`'a çevrildi
     (atmosfer.css'teki köz ember dolu buton stilini alır — format sayfası
     kayit-cta ile BİREBİR). Section kabuk + "Tüm buluşmalar" link stili de
     atmosfer.css `section[data-section="kayit-cta"]` altında. -->
