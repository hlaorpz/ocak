---
// /odeme/tamam — Ödeme başarı sayfası. Tasarım turu 3 (ADIM 5) — Notion-aware:
// kullanıcı buraya kredi kartı ödemesi sonrası düşer; Zoom link + şifre
// (online ise) veya adres (fiziksel ise) Notion'dan çekilip gösterilir.
// Önceki sürümü statikti (yakında e-posta diyordu) → eyeball bulgusu: 10
// Haziran çember kartla ödenince Zoom çıkmadı. Fix: ref (OCAK-XXXXX) → Kayıtlar
// query → Etkinlikler relation → katilim retrieve.
//
// URL params:
//   ref   — OCAK-XXXXX referans no (kullanıcı görür, banka açıklaması ile aynı).
//   mock  — '1' ise dev/preview MOCK uyarı görünür.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { notion, NOTION_KAYITLAR_DB } from '../../lib/notion.ts';
import { katilimTipiCoz } from '../../lib/kayit.ts';
import { FORMAT_KATEGORI } from '../../lib/etkinlik-kategori.ts';
import { formatEtkinlikTarihi } from '../../lib/format-etkinlik.ts';
import DavetKutusu from '../../components/DavetKutusu.astro';

const ref = Astro.url.searchParams.get('ref') ?? '';
const mockMu = Astro.url.searchParams.get('mock') === '1';

type Katilim = {
  tipi: 'link' | 'adres';
  deger: string;
  zoomSifresi?: string;
};

type KayitOkumaSonuc = {
  katilim: Katilim | null;
  etkinlikId: string;
  /** Eyeball #4 Fix 2c: davet metni + link için etkinlik meta. */
  etkinlikAdi: string;
  etkinlikTarihi: string;
  landingPath: string;
};

// ref → Kayıtlar query → Etkinlikler relation → katilim + etkinlikId + davet
// meta (ad/tarih/landingPath). Hata/eksik olursa alan boş döner; DavetKutusu
// fallback path'le yine WhatsApp paylaşımını kurabilir.
async function kayitOku(referansNo: string): Promise<KayitOkumaSonuc> {
  const bos: KayitOkumaSonuc = {
    katilim: null,
    etkinlikId: '',
    etkinlikAdi: '',
    etkinlikTarihi: '',
    landingPath: '',
  };
  if (!referansNo || !NOTION_KAYITLAR_DB) return bos;
  try {
    const sorgu = await notion.databases.query({
      database_id: NOTION_KAYITLAR_DB,
      filter: {
        property: 'Referans No',
        rich_text: { equals: referansNo },
      },
      page_size: 1,
    });
    const kayit = sorgu.results[0];
    if (!kayit || !('properties' in kayit)) return bos;
    const props = kayit.properties as Record<string, any>;
    const etkRel: string = props['Etkinlikler']?.relation?.[0]?.id ?? '';
    if (!etkRel) return bos;

    const etk = await notion.pages.retrieve({ page_id: etkRel });
    if (!('properties' in etk)) return { ...bos, etkinlikId: etkRel };
    const etkProps = etk.properties as Record<string, any>;

    const rich = (name: string): string =>
      (etkProps[name]?.rich_text ?? [])
        .map((t: any) => t.plain_text ?? '')
        .join('')
        .trim();
    const title = (name: string): string =>
      (etkProps[name]?.title ?? [])
        .map((t: any) => t.plain_text ?? '')
        .join('')
        .trim();
    const katilimLinki = rich('Katılım Linki');
    const mekan = etkProps['Mekân/Platform']?.select?.name ?? '';
    const zoomSifresi = rich('Zoom Şifresi');
    const konumDetay = rich('Konum Detay');

    // Eyeball #4 Fix 2c: davet metni için etkinlik başlığı + TR tarih; link
    // için Format select → landingPath (FORMAT_KATEGORI map). "Çember" →
    // "cember" → "/cember".
    const etkinlikAdi = title('Başlık');
    const tarihBaslangic: string = etkProps['Tarih']?.date?.start ?? '';
    const tarihBitis: string = etkProps['Tarih']?.date?.end ?? '';
    const saat: string = rich('Saat') || rich('Zoom Başlangıç Saati');
    const etkinlikTarihi = tarihBaslangic
      ? formatEtkinlikTarihi(tarihBaslangic, tarihBitis, saat)
      : '';
    const formatSelect: string = etkProps['Format']?.select?.name ?? '';
    const kategori = FORMAT_KATEGORI[formatSelect];
    const landingPath = kategori ? `/${kategori}` : '';

    const meta = { etkinlikId: etkRel, etkinlikAdi, etkinlikTarihi, landingPath };

    const tipi = katilimTipiCoz(mekan);
    if (tipi === 'link') {
      if (!katilimLinki) return { ...bos, ...meta };
      return {
        katilim: {
          tipi: 'link',
          deger: katilimLinki,
          ...(zoomSifresi ? { zoomSifresi } : {}),
        },
        ...meta,
      };
    }
    // Fiziksel — adres metnini katilim linki yerine Konum Detay'dan al
    // (lib/notion-etkinlikler mekanDetay = Konum Detay). Boşsa null.
    const adres = konumDetay || katilimLinki;
    if (!adres) return { ...bos, ...meta };
    return { katilim: { tipi: 'adres', deger: adres }, ...meta };
  } catch (err) {
    console.error('[odeme/tamam] kayıt okuma hatası:', String(err).slice(0, 200));
    return bos;
  }
}

const { katilim, etkinlikId, etkinlikAdi, etkinlikTarihi, landingPath } =
  await kayitOku(ref);
---
<Layout title="Ödemen alındı" description="Ödemen alındı, yerin ayrıldı." oda="OCAK" noindex>
  <article class="ocak-yasal">
    <div class="ocak-odeme-tamam">
      <div class="ocak-odeme-tamam__ember" aria-hidden="true"></div>
      <h1>Ödemen alındı, yerin ayrıldı.</h1>
      <p class="ocak-odeme-tamam__gövde">
        Buluşma detaylarını yakında e-postayla paylaşacağız. İstersen
        WhatsApp'tan da bize yazıp öğrenebilirsin. Hoş geldin.
      </p>

      {katilim && katilim.tipi === 'link' && (
        <div class="ocak-odeme-tamam__katilim">
          <p class="ocak-odeme-tamam__katilim-not">
            Buluşma linkin burada. Mail kutuna da düştü.
          </p>
          <p class="ocak-odeme-tamam__katilim-deger">
            <a href={katilim.deger} target="_blank" rel="noopener noreferrer">{katilim.deger}</a>
          </p>
          {katilim.zoomSifresi && (
            <p class="ocak-odeme-tamam__katilim-sifre">
              Zoom şifresi: <code>{katilim.zoomSifresi}</code>
            </p>
          )}
        </div>
      )}
      {katilim && katilim.tipi === 'adres' && (
        <div class="ocak-odeme-tamam__katilim">
          <p class="ocak-odeme-tamam__katilim-not">
            Buluşacağımız yer burada. Mail kutuna da düştü.
          </p>
          <p class="ocak-odeme-tamam__katilim-deger">{katilim.deger}</p>
        </div>
      )}

      {ref && <p class="ocak-odeme-tamam__ref">({ref})</p>}

      {/* brief-davet-sistemi: kart-ödeme sonrası ikinci mount.
          Eyeball #4 Fix 2c: davet metni + link format-özel. Meta Notion
          kayıt sorgusundan gelir (ad/tarih/path). Etkinlik bulunamadıysa
          alanlar boş geçer; DavetKutusu nötr metin + /acik-kapi fallback
          path'le yine WhatsApp paylaşımını kurar. */}
      <DavetKutusu
        refKodu={ref}
        etkinlikId={etkinlikId}
        etkinlikAdi={etkinlikAdi}
        etkinlikTarihi={etkinlikTarihi}
        landingPath={landingPath}
      />

      {mockMu && (
        <p class="ocak-mock-uyari">
          <strong>MOCK</strong> — Bu ödeme simülasyondu. Gerçek tahsilat
          yapılmadı. Aşama 6'da banka sanal POS altyapısı devreye girer.
        </p>
      )}
    </div>
  </article>
</Layout>

<style>
  .ocak-odeme-tamam {
    text-align: center;
    padding: var(--space-7) 0;
  }
  .ocak-odeme-tamam__ember {
    width: 14px;
    height: 14px;
    background: var(--ember);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--ember), 0 0 50px rgba(196, 75, 47, 0.35);
    margin: 0 auto var(--space-6);
  }
  .ocak-odeme-tamam h1 {
    color: var(--gold);
    font-style: italic;
  }
  .ocak-odeme-tamam__gövde {
    font-family: var(--font-body);
    color: var(--cream-soft);
    line-height: 1.7;
    max-width: 42ch;
    margin: 0 auto var(--space-5);
  }
  .ocak-odeme-tamam__katilim {
    margin: 0 auto var(--space-5);
    max-width: 42ch;
  }
  .ocak-odeme-tamam__katilim-not {
    font-family: var(--font-body);
    color: var(--cream-soft);
    line-height: 1.7;
    margin: 0 0 var(--space-3);
  }
  .ocak-odeme-tamam__katilim-deger {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--cream);
    margin: 0;
    word-break: break-all;
  }
  .ocak-odeme-tamam__katilim-deger a {
    color: var(--ember);
    text-decoration: underline;
    text-decoration-color: rgba(196, 75, 47, 0.4);
    text-underline-offset: 0.2em;
  }
  .ocak-odeme-tamam__katilim-sifre {
    margin: var(--space-2) 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--cream-soft);
  }
  .ocak-odeme-tamam__katilim-sifre code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, monospace);
    color: var(--cream);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.15rem 0.45rem;
    letter-spacing: 0.05em;
  }
  /* Tasarım turu 3 (ADIM 1) — referans dipnot KayitFormu success'iyle aynı
   * stil: küçük, smoke, parantez içinde sade. */
  .ocak-odeme-tamam__ref {
    margin: -0.5rem 0 var(--space-5);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--smoke);
    letter-spacing: 0.05em;
  }
  .ocak-mock-uyari {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: rgba(212, 175, 55, 0.08);
    border: 1px dashed var(--gold);
    color: var(--gold);
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .ocak-mock-uyari strong { letter-spacing: 0.1em; }
</style>
