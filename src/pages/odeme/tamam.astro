---
// /odeme/tamam — Ödeme başarı sayfası. Tasarım turu 3 (ADIM 5) — Notion-aware:
// kullanıcı buraya kredi kartı ödemesi sonrası düşer; Zoom link + şifre
// (online ise) veya adres (fiziksel ise) Notion'dan çekilip gösterilir.
// Önceki sürümü statikti (yakında e-posta diyordu) → eyeball bulgusu: 10
// Haziran çember kartla ödenince Zoom çıkmadı. Fix: ref (OCAK-XXXX) → Kayıtlar
// query → Etkinlikler relation → katilim retrieve.
//
// URL params:
//   ref   — OCAK-XXXX referans no (kullanıcı görür, banka açıklaması ile aynı).
//   mock  — '1' ise dev/preview MOCK uyarı görünür.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { notion, NOTION_KAYITLAR_DB } from '../../lib/notion.ts';
// Notion okuması 10 Eylül 2026'da `lib/odeme-kayit-oku.ts`'e TAŞINDI
// (kırpılmadı — CLAUDE.md §5). Sebep: `.astro` frontmatter'ı test edilemiyor,
// üç senaryo (bulundu/bulunamadı/Notion hatası) ancak lib'de ölçülebiliyor.
// `katilimTipiCoz` · `ilkAd` · `FORMAT_KATEGORI` · `formatEtkinlikTarihi`
// artık o dosyanın import'ları; burada tüketilmiyorlar.
import { kayitOku } from '../../lib/odeme-kayit-oku.ts';
import { tamamGorunumu } from '../../lib/odeme-tamam.ts';
import { etkinlikUrlFormatla } from '../../lib/kayit.ts';
import DavetKutusu from '../../components/DavetKutusu.astro';
import MektupKutusu from '../../components/MektupKutusu.astro';
import { odemeLinkImzasi, odemeLinkSirri } from '../../lib/odeme-link.ts';
// KARAR 488 — kart akışı kapalıyken bu sayfa 404. Dosya silinmedi.
//
// ✅ KAPANDI (10 Eyl 2026). Buradaki not iki aydır şunu söylüyordu: "Notion
// sorgusu ZATEN KIRIK — `Referans No` diye bir property Kayıtlar DB'sinde
// yok, referans `Kayıt ID` title alanında yaşıyor (bkz. `api/kayit.ts`
// refQuery, DB'ye göre dallanıyor). Düzeltme bilinçli olarak anahtarın
// arkasına alındı." Teşhis doğruydu; düzeltme artık yapıldı ve anahtardan
// bağımsız olarak doğru property'yi kullanıyor. Kırık sorgunun kendisi
// silinmedi, `odeme-kayit-oku.ts` dosya başında üç kanıtıyla anlatılıyor.
import { KART_AKISI_ACIK } from '../../lib/kart-akisi.ts';

if (!KART_AKISI_ACIK) return new Response(null, { status: 404 });

const ref = Astro.url.searchParams.get('ref') ?? '';
const mockMu = Astro.url.searchParams.get('mock') === '1';

// Notion okuması artık `lib/odeme-kayit-oku.ts`'te (tipler dahil: `Katilim`,
// `KayitDurumu`, `KayitOkumaSonuc`). `durum` üç hâli ayırır — 'bulundu' /
// 'bulunamadi' / 'hata'. Eski kod üçünü tek boş nesneye katlıyordu.
//
// Yüzey bağlantısı: 'bulundu' → jenerik metin (kayıt var, detay henüz yok)
// · 'bulunamadi'/'hata' → arama metni. İki hâl KARIŞTIRILMAZ; "kaydını
// bulamadık" ile "detayları yakında paylaşacağız" aynı ekranda duramaz.
const kayit = await kayitOku(notion, NOTION_KAYITLAR_DB, ref);
const { durum, etkinlikId, etkinlikAdi, etkinlikTarihi, landingPath, davetEdenAd } = kayit;

// ── İŞ 7 (7 Eki) — KATILIM BİLGİSİ SAYFADAN KALKTI ──
// `katilim` ARTIK OKUNMUYOR: Zoom bağlantısı, şifre, mekân ve adres bu sayfada
// gösterilmiyor. Sayfa `?ref=OCAK-XXXX` ile açılıyor ve referans maillerde,
// banka açıklamasında, WhatsApp'ta dolaşıyor — tahmin edilebilir bir adres.
// Katılım bilgisini oraya basmak, bağlantıyı referansı bilen herkese açmak
// demekti. Bilgi e-postada duruyor; e-posta kadının kendi kutusu.
//
// Görünüm `lib/odeme-tamam.ts`'te (frontmatter test edilemiyor ve bu sayfanın
// NE GÖSTERMEDİĞİ bir karar).
//
// ⚠ Saat `saatHam`dan geliyor, `etkinlikTarihi`'nden DEĞİL: o alan
// cross-fallback'li saati taşıyor (`api/kayit.ts:191-198`'in çürüttüğü
// eşleme). Sayfa ve mail aynı kurucuyu kullanıyor.
const gorunum = tamamGorunumu({
  kayitDurumu: durum,
  baslik: kayit.basligHam,
  tarihISO: kayit.tarihISOHam,
  tarihBitis: kayit.tarihBitisHam,
  saat: kayit.saatHam,
  mekan: kayit.mekanHam,
});
const kayitBulundu = gorunum.bulundu;

// Sekme başlığı ve meta açıklama da AYNI `kayitBulundu` koşuluna bağlı —
// üçüncü bir koşul yazılmadı (KARAR 395). h1 duruma bağlanmış olsa bile
// sabit bir `title` sekmede, paylaşım kartında ve tarayıcı geçmişinde
// "Ödemen alındı" demeye devam ederdi; sayfa `noindex` ama bu üç yüzeyin
// hiçbirini `noindex` kapatmıyor.
// Sekme başlığı ve açıklama gövdeyle AYNI kaynaktan (KARAR 395) — artık
// `gorunum.baslik`'tan türüyor, ikinci bir koşul yok.
const sayfaBasligi = `${gorunum.baslik.replace(/\.$/, '')} · OCAK`;
const sayfaAciklamasi = gorunum.baslik;
---
<Layout title={sayfaBasligi} description={sayfaAciklamasi} oda="OCAK" noindex>
  <article class="ocak-yasal">
    <div class="ocak-odeme-tamam">
      <div class="ocak-odeme-tamam__ember" aria-hidden="true"></div>
      {/* Başlık ve gövdenin TAMAMI `gorunum`dan — tek kaynak, tek gerçek
          (KARAR 395). İki kod yolunu elle eşit tutmak sonsuz döngüydü.

          Neden koşullu: sayfa `ref` olmadan doğrudan açılabiliyor. Sabit bir
          "Yerin hazır" başlığı hiç ödeme yapmamış birine ödeme yaptığını
          söylerdi. */}
      <h1>{gorunum.baslik}</h1>

      <p class="ocak-odeme-tamam__gövde">{gorunum.giris}</p>

      {/* Durum kartı — buluşmanın adı + tarih-saat. Amber çerçeve sitenin
          mevcut dili (`.ocak-odeme-tamam__kart`); yeni token yok. Tarih+saat
          TEK PARÇA basılır ve satır ortasında kırılmaz. */}
      {gorunum.kart.length > 0 && (
        <div class="ocak-odeme-tamam__kart">
          {gorunum.kart.map((satir, i) => (
            <p class={i === 0 ? 'ocak-odeme-tamam__kart-baslik' : 'ocak-odeme-tamam__kart-tarih'}>
              {i === 0 ? satir : <span class="ocak-odeme-tamam__anlik">{satir}</span>}
            </p>
          ))}
        </div>
      )}

      {/* ⚠ Katılım bilgisinin KENDİSİ DEĞİL, yeri söyleniyor. Zoom bağlantısı,
          şifre, mekân ve adres bu sayfadan KALKTI (İŞ 7) — gerekçe
          frontmatter'da. */}
      {gorunum.nerede && <p class="ocak-odeme-tamam__gövde">{gorunum.nerede}</p>}
      {gorunum.gecikme && <p class="ocak-odeme-tamam__gövde">{gorunum.gecikme}</p>}
      {gorunum.kapanis && <p class="ocak-odeme-tamam__gövde">{gorunum.kapanis}</p>}

      {gorunum.yardimEposta && (
        <p class="ocak-odeme-tamam__yardim">
          <a href={`mailto:${gorunum.yardimEposta}`}>{gorunum.yardimEposta}</a>
        </p>
      )}

      {/* brief-davet-sistemi: kart-ödeme sonrası ikinci mount.
          Eyeball #4 Fix 2c: davet metni + link format-özel. Meta Notion
          kayıt sorgusundan gelir (ad/tarih/path). Etkinlik bulunamadıysa
          alanlar boş geçer; DavetKutusu nötr metin + /acik-kapi fallback
          path'le yine WhatsApp paylaşımını kurar. */}
      <DavetKutusu
        etkinlikUrl={etkinlikUrlFormatla(kayit.slugHam)}
        refKodu={ref}
        davetEdenAd={davetEdenAd}
        etkinlikId={etkinlikId}
        etkinlikAdi={etkinlikAdi}
        etkinlikTarihi={etkinlikTarihi}
        landingPath={landingPath}
      />

      {/* İŞ 5 — Ateş Mektupları tek dokunuş, paylaş bloğunun ALTINDA.
          İmza SUNUCUDA üretiliyor; sır istemciye inmiyor. Kayıt bulunamadıysa
          `ref` boş olabilir — bileşen o hâlde kendini basmıyor. */}
      <MektupKutusu kayitId={ref} imza={odemeLinkImzasi(ref, odemeLinkSirri())} />

      {/* İŞ 8 sırası: başlık → durum kartı → açıklama → paylaş → Ateş
          Mektupları → referans. Referans kodu EN ALTTA ve küçük. */}
      {ref && <p class="ocak-odeme-tamam__ref">({ref})</p>}

      {mockMu && (
        <p class="ocak-mock-uyari">
          <strong>MOCK</strong> — Bu ödeme simülasyondu. Gerçek tahsilat
          yapılmadı.
        </p>
      )}
    </div>
  </article>
</Layout>

<style>
  .ocak-odeme-tamam {
    text-align: center;
    padding: var(--space-7) 0;
  }
  .ocak-odeme-tamam__ember {
    width: 14px;
    height: 14px;
    background: var(--ember);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--ember), 0 0 50px rgba(196, 75, 47, 0.35);
    margin: 0 auto var(--space-6);
  }
  .ocak-odeme-tamam h1 {
    color: var(--gold);
    font-style: italic;
  }
  .ocak-odeme-tamam__gövde {
    font-family: var(--font-body);
    color: var(--cream-soft);
    line-height: 1.7;
    max-width: 42ch;
    margin: 0 auto var(--space-5);
  }
  /* Kardeş sayfa `/odeme/iptal`'in `__yardim` stiliyle birebir aynı —
   * iki ekran aynı akışta, aynı ağırlıkta durmalı. */
  .ocak-odeme-tamam__yardim {
    margin: calc(var(--space-5) * -1) auto var(--space-5);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--cream-soft);
  }
  .ocak-odeme-tamam__yardim a { color: var(--ember); }
  /* ── Durum kartı (İŞ 7/8) ──
   * Sitenin mevcut dili: amber çerçeve + sönük zemin. `.kayit-formu__kor-
   * opsiyon`un kullandığı aynı desendi (1px dashed + düşük alfa beyaz); burada
   * kesik çizgi yerine düz ember-alfa, çünkü bu bir seçim değil bir TEYİT.
   * Yeni token yok: `--ember` · `--cream` · `--cream-soft` · `--space-*`.
   *
   * ⚠ `.ocak-odeme-tamam__katilim*` kuralları KALKTI — Zoom bağlantısı, şifre
   * ve adres bu sayfada gösterilmiyor (İŞ 7), tüketicileri kalmadı. */
  .ocak-odeme-tamam__kart {
    max-width: 42ch;
    margin: 0 auto var(--space-5);
    padding: var(--space-4);
    border: 1px solid rgba(196, 75, 47, 0.28);
    background: rgba(255, 255, 255, 0.02);
  }
  .ocak-odeme-tamam__kart-baslik {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--cream);
    margin: 0;
    line-height: 1.5;
  }
  .ocak-odeme-tamam__kart-tarih {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--cream-soft);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
  /* Tarih-saat TEK PARÇA — satır ortasında kırılmaz (İŞ 8). `/odeme/devam`
   * ile birebir aynı kural; iki ekran aynı şeyi aynı biçimde basıyor.
   * Taşma olursa `break-word` devreye girer. */
  .ocak-odeme-tamam__anlik {
    white-space: nowrap;
    overflow-wrap: break-word;
  }

  /* Tasarım turu 3 (ADIM 1) — referans dipnot KayitFormu success'iyle aynı
   * stil: küçük, smoke, parantez içinde sade. */
  .ocak-odeme-tamam__ref {
    margin: -0.5rem 0 var(--space-5);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--smoke);
    letter-spacing: 0.05em;
  }
  .ocak-mock-uyari {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: rgba(212, 175, 55, 0.08);
    border: 1px dashed var(--gold);
    color: var(--gold);
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .ocak-mock-uyari strong { letter-spacing: 0.1em; }
</style>
