---
// /odeme/nkolay — N-Kolay Ortak Ödeme Sayfası'na geçiş formu (11 Eyl 2026).
//
// ── Bu sayfa neden var ──
// N-Kolay on alanlı bir form POST bekler; `checkoutBaslat` sözleşmesi ise bir
// redirect URL taşır (`api.ts:116` `checkoutUrl` — `KayitFormu.astro:2206`
// oraya `window.location` atar). Sözleşmeyi değiştirmek yerine araya site-içi
// bu sayfa kondu: redirect buraya gelir, form burada basılır ve auto-submit
// edilir. İmza (`hashDataV2`) hiçbir zaman URL'e, tarayıcı geçmişine ya da
// Referer'a düşmez.
//
// ── Tutar query'den ASLA okunmaz ──
// URL yalnız `ref` (+ varsa `kodId`) taşır. Ödenecek tutar Notion `Beklenen
// Tutar` alanından okunur (`odeme-kayit-oku.ts`). Query'den okumak, kadının
// adres çubuğunda kendi ödeyeceği tutarı yazabilmesi demekti.
//
// ── Akış ──
//   /api/kayit → checkoutBaslat → redirect /odeme/nkolay?ref=OCAK-XXXX
//   → Notion oku (tutar + pageId) → 10 alanlı form
//   → Notion yaz (`Gönderilen Ref` = giden `clientRefCode`, B202) → auto-submit
//   → N-Kolay kart sayfası → sonuç successUrl/failUrl'e POST
//   → /api/odeme-callback (route DEĞİŞMEDİ — KARAR 395)
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
// KARAR 488 — kart akışı kapalıyken bu sayfa 404. Dosya silinmez; anahtar
// açılınca aynen geri gelir. `/odeme/mock` ile AYNI desen (ölçüldü: mock 404
// döner; 410 webhook deseni ve `/api/odeme-callback`'e ait, sayfaya değil).
import { KART_AKISI_ACIK } from '../../lib/kart-akisi.ts';
import { getPaymentProvider } from '../../lib/payment-provider.ts';
import { kayitOku } from '../../lib/odeme-kayit-oku.ts';
// B211 — ödeme başlatma kapısı; TEK fonksiyon, iki çağrı yeri (karar 2).
import { odemeBaslatilabilir } from '../../lib/odeme-link.ts';
import { notion, NOTION_KAYITLAR_DB } from '../../lib/notion.ts';
import { publicOrigin } from '../../lib/public-origin.ts';
import { istemciIp } from '../../lib/istemci-ip.ts';

if (!KART_AKISI_ACIK) return new Response(null, { status: 404 });

const url = Astro.url;
const ref = (url.searchParams.get('ref') ?? '').trim();
// Promo kod page id'si — callback `kodKullanimArtir`ı bununla çağırır
// (sayacın İLK ve TEK artırım noktası). Taşınmazsa promo sayacı hiç artmaz.
const kodId = (url.searchParams.get('kodId') ?? '').trim();

const baseUrl = publicOrigin(Astro.request);

// Notion TEK sorgu: tutar + pageId + (kullanılmayan) etkinlik meta birlikte gelir.
const kayit = ref
  ? await kayitOku(notion, NOTION_KAYITLAR_DB, ref)
  : null;

/**
 * Kapı çağrısının tek yeri — `simdi` bir kez okunur. İki ayrı `new Date()`
 * ile çağırmak, aynı istek içinde iki farklı "şimdi" demekti; bitişe saniyeler
 * kalmış bir kayıt koşulla log arasında taraf değiştirebilirdi.
 */
const simdiAni = new Date();
const odemeKapisi = (k: NonNullable<typeof kayit>) =>
  odemeBaslatilabilir({
    odemeDurumu: k.odemeDurumu,
    yerTutmaBitisi: k.yerTutmaBitisi,
    simdi: simdiAni,
  });

/** Kullanıcıya gösterilecek hata — sağlayıcı/altyapı ayrıntısı SIZMAZ. */
let hata = '';
let form: { actionUrl: string; alanlar: Record<string, string> } | null = null;

if (!kayit || kayit.durum !== 'bulundu') {
  // Üç hâl ayrı log'lanır ama kadına tek mesaj: neyin yanlış gittiği
  // teşhisi Kaan'ın, kadının değil.
  console.error(`[odeme/nkolay] kayıt okunamadı — ref="${ref}" durum=${kayit?.durum ?? 'ref-yok'}`);
  hata = 'Kaydın bulunamadı.';
} else if (!odemeKapisi(kayit).baslatilabilir) {
  // ── B211 (Kaan kararı 2) — ÖDEME BAŞLATMA KAPISI, İKİNCİ ÇAĞRI YERİ ──
  //
  // Kapı `/odeme/devam`'da da var ama orada kalması YETMEZ: referans
  // (`OCAK-XXXX`) maillerde yazılı ve bu sayfa `?ref=` ile bağımsız
  // girilebiliyor — kaydı Notion'dan kendisi okuyor, `/api/kayit`'ten gelmek
  // zorunda değil. Kapı yalnız devam sayfasında olsaydı iptal edilmiş ya da
  // süresi geçmiş bir satır için buradan ödeme başlatılabilirdi.
  //
  // ⚠ Bu kapı CALLBACK'İ İLGİLENDİRMEZ. Başlamış bir ödemenin dönüşü geç
  // gelirse kabul edilir — para kazanır (brief §1). Callback kapıları
  // DEĞİŞMEDİ (KARAR 593 · 594 · 595 · 601 · 602).
  const kapi = odemeKapisi(kayit);
  console.warn(
    `[odeme/nkolay] ödeme başlatılmadı — ref="${ref}" sebep=${'sebep' in kapi ? kapi.sebep : '?'}`,
  );
  // Kadına tek mesaj; hangi kapının kapandığı teşhis bilgisi ve log'da yaşıyor.
  hata = 'Bu ödemenin süresi doldu.';
} else if (!(kayit.tutar > 0)) {
  // `Beklenen Tutar` boş → ödeme başlatılamaz. Sıfır tutarlı bir form
  // basmaktansa durmak doğru: sağlayıcıya anlamsız istek gitmez.
  console.error(`[odeme/nkolay] Beklenen Tutar boş/sıfır — ref="${ref}" pageId=${kayit.pageId}`);
  hata = 'Ödeme tutarı hazırlanamadı.';
} else {
  const saglayici = getPaymentProvider();
  if (!saglayici.odemeFormu) {
    // `PAYMENT_PROVIDER=mock` iken bu sayfaya gelinmez (mock kendi sayfasına
    // yönlendirir). Yine de sessiz kalmaz: yanlış yapılandırma görünür olsun.
    console.error(`[odeme/nkolay] sağlayıcı "${saglayici.ad}" form POST akışı yazmamış`);
    hata = 'Ödeme sağlayıcısı hazır değil.';
  } else {
    // callback'in beklediği query — route DEĞİŞMEDİ, alan adları onun
    // `parseGirdi`'sinden birebir: pageId (Notion UUID, `pages.update` için),
    // ref (OCAK-XXXX, kullanıcıya gösterilen), tutar, sonuc, kodId.
    // ⚠ `ref` SONEKSİZ gider: `/odeme/tamam` ve refQuery `equals` ile arıyor.
    const basari = new URL(`${baseUrl}/api/odeme-callback`);
    basari.searchParams.set('pageId', kayit.pageId);
    basari.searchParams.set('ref', ref);
    basari.searchParams.set('tutar', String(kayit.tutar));
    basari.searchParams.set('sonuc', 'basari');
    if (kodId) basari.searchParams.set('kodId', kodId);

    const hataDonus = new URL(`${baseUrl}/api/odeme-callback`);
    hataDonus.searchParams.set('pageId', kayit.pageId);
    hataDonus.searchParams.set('ref', ref);
    // `sonuc` varsayılanı 'basari' (callback `parseGirdi`) — hata dönüşünde
    // AÇIKÇA yazılmalı, yoksa başarısız ödeme başarı sayılır.
    hataDonus.searchParams.set('sonuc', 'hata');

    const sonuc = saglayici.odemeFormu({
      referansNo: ref,
      tutar: kayit.tutar,
      basariUrl: basari.toString(),
      hataUrl: hataDonus.toString(),
      istemciIp: istemciIp(Astro.request),
      // ⚠ İstek anında üretilir. Modül seviyesinde `new Date()` çağırmak
      // değeri BUILD ZAMANINDA dondururdu (KARAR 385/464 vakası) ve her
      // ödeme aynı `rnd`'yi taşırdı.
      simdi: new Date(),
    });

    if ('hata' in sonuc) {
      // Sebep (hangi env eksik) yalnız log'a — kullanıcıya yapılandırma
      // ayrıntısı gösterilmez.
      console.error(`[odeme/nkolay] form üretilemedi — ${sonuc.hata}`);
      hata = 'Ödeme başlatılamadı.';
    } else {
      form = sonuc;

      // ── B202 — giden `clientRefCode` Notion'a düşer ──
      // Mutabakat servisi (N-Kolay `PaymentList`) işlemi **bu tam kodla**
      // sorgular. Dönüş POST'u hiç gelmezse — kadın 3D ekranında sekmeyi
      // kapattı, `STATUS=NEW` — sorulacak tek değer budur. Bu yüzden yazım
      // GİDİŞ anında yapılır; callback'e bırakılamaz, çünkü mutabakatın var
      // oluş sebebi tam olarak callback'in GELMEDİĞİ işlemdir.
      //
      // ⚠ Form basılmadan ÖNCE ve `await` ile. Response gittikten sonraya
      // ertelenirse Fluid Compute isteği bitirir ve yazım sessizce düşer.
      // Bedeli ikinci bir Notion round-trip'i — kadın kart sayfasına birkaç
      // yüz ms geç varır, kabul edildi (Kaan, 15 Eyl).
      //
      // ⚠ Her deneme yeni sonek üretir; alan SON denemeyi taşır, öncekiler
      // üzerine yazılır. Çoklu deneme geçmişi gerekirse ayrı karar (B202).
      try {
        await notion.pages.update({
          page_id: kayit.pageId,
          properties: {
            'Gönderilen Ref': {
              rich_text: [{ text: { content: sonuc.alanlar.clientRefCode } }],
            },
          },
        });
      } catch (err) {
        // FAIL-OPEN, bilerek: yazım düşerse ödeme YİNE DE başlar. Tersi —
        // mutabakat kolaylığı için kadını ödeme kapısında bırakmak — daha
        // pahalı. Kayıp yalnız mutabakat tarafında hissedilir ve log'da durur.
        console.error(
          `[odeme/nkolay] Gönderilen Ref yazılamadı — ref="${ref}" pageId=${kayit.pageId}: ${String(err).slice(0, 200)}`,
        );
      }
    }
  }
}
---
<Layout
  title="Ödemeye yönlendiriliyorsun · OCAK"
  description="Güvenli ödeme sayfasına geçiş."
  oda="OCAK"
  noindex
>
  <article class="ocak-yasal">
    {hata ? (
      <>
        <h1>Ödeme başlatılamadı</h1>
        <p>{hata}</p>
        <p>
          Bir şey ters gitti ve bu senin hatan değil. Bize yazarsan kaydını
          birlikte tamamlarız.
        </p>
        <p><a href="/iletisim/bize-yaz">Bize yaz</a></p>
      </>
    ) : (
      <>
        {/* ── KayitFormu'nun geçiş durumuyla AYNI GÖRÜNÜM (7 Eki) ──
            Köz noktası + tek satır. Kadın Gönder'e bastığından beri aynı
            ekranı görüyor; bu sayfanın gelişi bir kesinti değil, aynı sakin
            anın devamı.

            ⚠ ESKİ HÂLİNDE buraya bir `h1` ("Ödemeye yönlendiriliyorsun") ve
            bir güven paragrafı ("Kart bilgilerin bankanın güvenli sayfasında
            alınır; OCAK bu bilgileri görmez ve saklamaz.") basılıyordu. İkisi
            de Kaan'ın verdiği görünümde yok ve KALDIRILDI — raporlandı; güven
            cümlesi geri isteniyorsa metin kararı onun. */}
        <div class="ocak-odeme-gecis">
          <div class="ocak-odeme-gecis__ember" aria-hidden="true"></div>
          <p class="ocak-odeme-gecis__metin">Ödeme ekranına geçiyoruz.</p>
          {/* Auto-submit form. Düğme YALNIZ script çalışmazsa görünür: aşağıdaki
              `is:inline` betik onu gizleyip submit ediyor. Betik engellenirse
              (eklenti, CSP) düğme yerinde kalır ve akış elle sürer — JS'e bağlı
              tek ödeme yolu bırakmak, tarayıcı eklentisi yüzünden ödeme
              yapamayan kadın demekti.

              Gizleme TİMER'LA DEĞİL: yapay bekleme yok (brief). Betik gövdenin
              sonunda, gizleme submit'ten hemen önce. */}
          <form id="nkolay-form" method="POST" action={form!.actionUrl}>
            {Object.entries(form!.alanlar).map(([ad, deger]) => (
              <input type="hidden" name={ad} value={deger} />
            ))}
            <button type="submit" class="ocak-dugme" data-nkolay-dugme>
              Ödeme sayfasına git
            </button>
          </form>
        </div>
      </>
    )}
  </article>
</Layout>

{!hata && (
  <script is:inline>
    // Auto-submit — `is:inline` bilinçli: bu betiğin bundle'a girip
    // ertelenmesi, kadının boş ekrana bakması demek olurdu.
    //
    // Düğme submit'ten HEMEN ÖNCE gizlenir. Sıra önemli: önce gizle, sonra
    // submit. Tersi olsaydı navigasyon başlar ve gizleme hiç koşmayabilirdi —
    // düğme son karede görünür kalırdı.
    var f = document.getElementById('nkolay-form');
    if (f) {
      var d = f.querySelector('[data-nkolay-dugme]');
      if (d) d.hidden = true;
      f.submit();
    }
  </script>
)}

<style>
  /* KayitFormu'nun `.kayit-formu__gecis` ritmiyle aynı: aynı köz, aynı gövde
   * tipografisi, aynı dikey nefes. Yeni token yok. */
  .ocak-odeme-gecis {
    text-align: center;
    padding: var(--space-7) 0;
  }
  .ocak-odeme-gecis__ember {
    width: 14px;
    height: 14px;
    background: var(--ember);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--ember), 0 0 50px rgba(196, 75, 47, 0.35);
    margin: 0 auto var(--space-6);
  }
  .ocak-odeme-gecis__metin {
    font-family: var(--font-body);
    color: var(--cream-soft);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
  }
</style>
