---
// yolculuk.astro — /yolculuk sayfa override (brief Yolculuk Ekseni; KARAR 127 paterni).
// Üstte YolculukEksen şeridi (Beş Evre + Bir AÇILIŞ ısı-eğrisi), altta PageContent
// prose'u (yolculuk-kime + iki-yolculuk sectionları Notion'dan). Plugin'e dokunulmaz —
// Seçenek B: statik route dinamiğe öncelikli, /yolculuk artık burada render olur.
//
// Borç: Notion-side duplicate temizliği Kaan tarafı iş (şerit canlıda dursun, sonra
// Notion'daki "Beş Evre + Bir AÇILIŞ" prose bloğu budanır).
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageContent from '../components/PageContent.astro';
import YolculukEksen from '../components/YolculukEksen.astro';

const sayfa = await getEntry('sayfalar', '/yolculuk');
if (!sayfa) {
  throw new Error("yolculuk.astro: 'sayfalar' collection'ında '/yolculuk' slug'ı bulunamadı.");
}
---
<Layout
  title={sayfa.data.title}
  description={sayfa.data.description}
  ogImage={sayfa.data.ogImage}
  oda={sayfa.data.oda}
>
  <YolculukEksen />
  <PageContent slug="/yolculuk" fragments={sayfa.data.fragments} />
</Layout>
