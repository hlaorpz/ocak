---
import '../styles/global.css';
import '../styles/atmosfer.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import WhatsappYuzen from '../components/WhatsappYuzen.astro';
import type { Oda } from '../lib/oda-map';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Glow odası — <main data-oda> → atmosfer.css hero glow yoğunluğu (KARAR 107, Senaryo Y) */
  oda?: Oda;
  /** Tam genişlik içerik (hero için, container'sız) */
  bare?: boolean;
  /** Sayfa-özel arama motoru indeks engelleme (örn. /test KARAR 143) */
  noindex?: boolean;
}

const {
  title,
  description = 'Kadınların kadim ateşi. Seni sana geri vermek için buradayız.',
  ogImage = '/og.png',
  oda,
  noindex = false,
} = Astro.props;

const fullTitle = title === 'OCAK' ? 'OCAK · Kadınların Kadim Ateşi' : `${title} · OCAK`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ocak.biz').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://ocak.biz').toString();

// Sayfa slug — main[data-page] üzerinden sayfa-özel CSS override (inline ember kuralı vb.)
const pageSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '') || 'home';

// Brief I.1 — GTM container. Snippet sadece PROD'da emit (dev'de sessiz).
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OCAK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Fonts — Cormorant Garamond + Jost (KARAR 35). Lansman öncesi self-host'a geç. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    />

    <meta name="theme-color" content="#1A1210" />
    <meta name="format-detection" content="telephone=no" />

    {/* Brief I.1 — GTM container head snippet (Pixel + GA4 GTM UI'da, kodda yok) */}
    {isProd && gtmId && (
      <script is:inline set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${gtmId}');
      `} />
    )}
  </head>

  <body>
    {isProd && gtmId && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <Nav />
    <main id="main" data-oda={oda} data-page={pageSlug}>
      <slot />
    </main>
    <WhatsappYuzen />
    <Footer />
    <GrainOverlay />

    <script>
      // Reveal IntersectionObserver — legacy verbatim (KARAR 102)
      // threshold 0.15, rootMargin -40px (bottom), class "visible"
      // CSS davranışı global.css'te

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.15,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        document.querySelectorAll('[data-reveal]').forEach((el) => {
          observer.observe(el);
        });
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          el.classList.add('visible');
        });
      }

      // Eşik accordion scroll-jump fix (/sen-neredesin, TUR-3). Exclusive
      // <details name="esikler"> aşağıdaki maddeye tıklandığında yukarıdaki
      // kapanır → sayfa yüksekliği ~300-445px kısalır → tıklanan başlık
      // viewport'ta yukarı zıplar. Chrome scroll-anchoring bu senaryoda
      // çalışmıyor. Toggle → açılan summary'yi 'nearest' ile hizala:
      // viewport içindeyse dokunma, dışına çıktıysa asgari kaydır.
      // CSS scroll-margin-top: var(--nav-height) sticky nav altına gizlenmeyi engeller.
      document.querySelectorAll<HTMLDetailsElement>('details[name="esikler"]').forEach((d) => {
        d.addEventListener('toggle', () => {
          if (d.open) {
            d.querySelector('summary')?.scrollIntoView({
              block: 'nearest',
              behavior: 'auto',
            });
          }
        });
      });
    </script>
  </body>
</html>
