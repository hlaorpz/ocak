# Notion Internal Integration "Ocak Site" (KARAR 97)
# Bu dosya commit edilir — gerçek token .env'e yazılır, .env asla commit edilmez.
NOTION_TOKEN=

# Notion Database ID'leri — Notion URL'inden son segment (uuid)
NOTION_PAGES_DB_ID=
NOTION_EVENTS_DB_ID=
# Notion — başvuru/triyaj (zaten kullanımda, örnek dosyada eksikti)
NOTION_BASVURULAR_DB_ID=
# Notion — kayıt/ödeme defteri (KARAR 76, Ödeme Aşama 1.5'te yazılacak)
NOTION_KAYITLAR_DB_ID=
# Notion — indirim kodları (Ödeme Aşama 1)
NOTION_KODLAR_DB_ID=

# Site URL — preview/prod ayrımı için
PUBLIC_SITE_URL=https://ocak.biz

# Tracking — Brief I.1
PUBLIC_GTM_ID=GTM-W6L2NSDS

# MailerLite — Apps Script Script Properties'ten Vercel env'e taşındı
# (Brief 1 — ödemeli kayıt formları backend geçişi). Brief 2'de /api/kayit
# içinde grup ekleme için kullanılacak.
MAILERLITE_API_KEY=

# Havale/EFT bilgisi — /api/kayit success response'ta gösterilir (Brief 2A).
# PUBLIC_ prefix: HTML'de görünür, hassas değil.
PUBLIC_HAVALE_IBAN=
PUBLIC_HAVALE_AD=

# Ödeme sağlayıcısı. `mock` — gerçek para yok, /odeme/mock checkout sayfasına
# redirect olur. `nkolay` — gerçek tahsilat, /odeme/nkolay form POST sayfası.
# `iyzico` yazılmadı (çağrılırsa throw eder).
PAYMENT_PROVIDER=mock

# === N-KOLAY SANAL POS (11 Eyl 2026) ===
# Ortak Ödeme Sayfası: biz form POST ederiz, sonuç successUrl/failUrl'e POST
# edilir. Server-to-server webhook YOK — ödemenin tek kanıtı dönüş imzasıdır.
#
# ⚠ Gerçek değerler dokümanda TUTULMAZ (CLAUDE.md §8) — Vercel env'de yaşar.
# ⚠ HEPSİNİN DEĞERİ BUILD ZAMANINDA SABİTLENİR — Vercel'de yazmak YETMEZ,
#   REDEPLOY şart (B193'te iki kez yanılttı).

# Üye işyeri kimliği — satış formuna giren `sx`.
NKOLAY_SX=

# Mutabakat (PaymentList) ve iptal servislerinin `sx`'leri. Bu turda
# KULLANILMIYOR; yüzey hazır dursun diye burada.
NKOLAY_SX_LIST=
NKOLAY_SX_IPTAL=

# Hash anahtarı. İki imzanın da son alanı: istek (hashDataV2) ve dönüş
# doğrulaması. Sızarsa ödeme doğrulaması taklit edilebilir — rotate şart.
NKOLAY_MERCHANT_SECRET=

# Ortak Ödeme Sayfası adresi (form action).
#   test: https://paynkolaytest.nkolayislem.com.tr/Vpos
#   prod: https://paynkolay.nkolayislem.com.tr/Vpos
NKOLAY_BASE_URL=

# Callback paylaşılan sırrı (İŞ 2, 10 Eyl 2026). `/api/odeme-callback`
# doğrulaması bunu bekler; `/odeme/mock` formu aynı değeri geri gönderir.
# `PUBLIC_` öneki YOK — tarayıcıya düşerse sır olmaktan çıkar.
#
# ⚠ FAIL-CLOSED: tanımsız/boş → callback 401 döner. Bu ARIZA DEĞİL, doğru
# davranış; ödeme yüzeyi fail-open olamaz. İŞ 4 koşusunda 401 görülürse ilk
# bakılacak yer burası.
# ⚠ Değer BUILD ZAMANINDA sabitlenir — Vercel'de yazmak yetmez, REDEPLOY şart.
#
# Gerçek değer dokümanda TUTULMAZ (CLAUDE.md §8) — Vercel env'de yaşar.
# Üretmek için: openssl rand -base64 24
ODEME_CALLBACK_SIR=

# === AKIŞ ANAHTARLARI — ikisi de FAIL-CLOSED ===
# Ortak kural: yalnız `acik` açar (büyük/küçük harf ve kenar boşluğu
# toleranslı). Tanımsız, boş, `kapali`, yazım hatası → hepsi KAPALI.
# `PUBLIC_` öneki YOK — client'ın bilmesine gerek yok, bundle'a düşmesin.
#
# ⚠ İKİSİNİN DE DEĞERİ BUILD ZAMANINDA SABİTLENİR. Vercel'de anahtarı
# değiştirmek YETMEZ — REDEPLOY şart.

# Kart ödeme akışı (KARAR 488). Sağlayıcı anlaşması (KARAR 363) gelene kadar
# kapalı; bugünkü tek ödeme ucu havale/EFT (KARAR 217). Altı tüketici:
# api/kayit · api/odeme-callback · KayitFormu · /odeme/* · oda-map · sitemap.
KART_AKISI=kapali

# Davet gönderimi (musluk). 22 Ağustos 2026'da kapatıldı: /api/davet açık röle
# gibi kullanıldı, mail.ocak.biz gönderim itibarı riske girdi. Açmadan önce
# sonraki tur koruma katmanı gelmeli (Turnstile / IP başına hız sınırı / davet
# edenin kendi adresini doğrulaması). İki tüketici: api/davet · DavetKutusu.
DAVET_AKISI=kapali
